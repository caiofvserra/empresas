	/// Divide as ações do exercício (métrica 37) pelas de 2024, menos 1 (meta 2.3 do PMF). Só em exercício completo depois de 2024 e do Conselho inteiro.
	measure 'Ações contra 2024' = ```
			VAR ano = [Exercício escolhido]
			VAR parcial = CALCULATE(MAX('Exercícios'[Parcial]), ALL('Exercícios'), 'Exercícios'[Ano] = ano)
			VAR agora = CALCULATE(SUM('Valores'[Valor]), 'Valores'[Código] = 37, 'Valores'[Ano] = ano, 'Valores'[Nível] = "Conselho")
			VAR base = CALCULATE(SUM('Valores'[Valor]), 'Valores'[Código] = 37, 'Valores'[Ano] = 2024, 'Valores'[Nível] = "Conselho")
			RETURN IF(ISBLANK(SELECTEDVALUE('Regionais'[GRE])) && parcial = 0 && ano > 2024 && base > 0, DIVIDE(agora, base) - 1)
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Fiscalização
		lineageTag: 5db1e129-6e47-5fb3-af0d-0cc1e0e7d492

	/// Lê a parte dos processos de infração julgados em até 180 dias (meta 5.1 do PMF; GovAdm, fora da planilha). Do Conselho inteiro.
	measure 'Infrações julgadas em até 180 dias' = ```
			VAR ano = [Exercício escolhido]
			RETURN IF(ISBLANK(SELECTEDVALUE('Regionais'[GRE])), DIVIDE(CALCULATE(MAX('Exercícios'[Infrações julgadas em 180 dias]), ALL('Exercícios'), 'Exercícios'[Ano] = ano), 100))
			```
		formatString: 0.0%
		displayFolder: Julgamento
		lineageTag: 60a5671c-9f2b-589e-814f-aa64847343d9

	/// Lê a parte dos processos éticos julgados em até 360 dias (meta 5.2 do PMF; GovAdm, fora da planilha). Do Conselho inteiro.
	measure 'Éticos julgados em até 360 dias' = ```
			VAR ano = [Exercício escolhido]
			RETURN IF(ISBLANK(SELECTEDVALUE('Regionais'[GRE])), DIVIDE(CALCULATE(MAX('Exercícios'[Éticos julgados em 360 dias]), ALL('Exercícios'), 'Exercícios'[Ano] = ano), 100))
			```
		formatString: 0.0%
		displayFolder: Julgamento
		lineageTag: b736cdab-2539-5d05-bfd1-ecd38a6f70dc

	/// Soma pendentes e recebidos e tira os julgados na 1ª instância (métricas 56, 57 e 58).
	measure 'Ficam para o próximo na 1ª instância' = MAX(0, [Pendentes de anos anteriores na 1ª instância] + [Recebidos na 1ª instância] - [Julgados na 1ª instância])
		formatString: #,##0
		displayFolder: Julgamento
		lineageTag: c810d4af-6a41-558d-9202-4087d6dd5c62

	/// Soma pendentes e recebidos e tira os julgados na 2ª instância (métricas 94, 95 e 96).
	measure 'Ficam para o próximo na 2ª instância' = MAX(0, [Pendentes de anos anteriores na 2ª instância] + [Recebidos na 2ª instância] - [Julgados na 2ª instância])
		formatString: #,##0
		displayFolder: Julgamento
		lineageTag: 95fec97c-65db-5eee-a7f7-7fb4fd064741

	/// Soma as métricas 67 a 72: decisões da 1ª instância arquivadas sem êxito, por motivo.
	measure 'Sem êxito na 1ª instância' = CALCULATE([Valor da métrica], KEEPFILTERS('Métricas'[Código] IN {67, 68, 69, 70, 71, 72}))
		formatString: #,##0
		displayFolder: Julgamento
		lineageTag: 5b940f9d-c2d5-5477-9a3f-0f455bf3a1be

	/// Soma as métricas 105 a 110: decisões da 2ª instância arquivadas sem êxito, por motivo.
	measure 'Sem êxito na 2ª instância' = CALCULATE([Valor da métrica], KEEPFILTERS('Métricas'[Código] IN {105, 106, 107, 108, 109, 110}))
		formatString: #,##0
		displayFolder: Julgamento
		lineageTag: a1a15cfe-403b-59e4-a15e-ea06dc8dff5d

	/// Soma as contas da despesa com fiscalização (indicador 16). Conta vazia fica em branco: sem ela, o indicador 16 não sai.
	measure 'Despesa na conta' = CALCULATE([Valor da métrica], KEEPFILTERS('Métricas'[Código] IN {153, 155, 156, 157, 158, 159, 160, 161}))
		formatString: R$ #,##0
		displayFolder: Suporte e Liderança
		lineageTag: 49f49298-3f8f-53ce-88f3-da1030a375dd

	/// Soma as métricas 145 e 147: anuidades de profissionais e de empresas não pagas em 31/12.
	measure 'Anuidades não pagas' = ```
			VAR ano = [Exercício escolhido]
			VAR p = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores'[Valor]), 'Valores'[Código] = 145, 'Valores'[Ano] = ano, 'Valores'[Nível] = "Regional", 'Valores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores'[Valor]), 'Valores'[Código] = 145, 'Valores'[Ano] = ano, 'Valores'[Nível] = "Conselho")
			  RETURN IF(NOT ISBLANK(regional), regional, conselho)
			VAR e = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores'[Valor]), 'Valores'[Código] = 147, 'Valores'[Ano] = ano, 'Valores'[Nível] = "Regional", 'Valores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores'[Valor]), 'Valores'[Código] = 147, 'Valores'[Ano] = ano, 'Valores'[Nível] = "Conselho")
			  RETURN IF(NOT ISBLANK(regional), regional, conselho)
			RETURN p + e
			```
		formatString: #,##0
		displayFolder: Suporte e Liderança
		lineageTag: be851ab3-006e-58d1-b9ec-288b27ebb0d4

	/// Conta as métricas do exercício na situação "Preenchida", do Conselho inteiro.
	measure 'Métricas preenchidas' = ```
			VAR ano = [Exercício escolhido]
			RETURN CALCULATE(COUNTROWS('Situação das métricas'), 'Situação das métricas'[Ano] = ano, 'Situação das métricas'[Situação] = "Preenchida") + 0
