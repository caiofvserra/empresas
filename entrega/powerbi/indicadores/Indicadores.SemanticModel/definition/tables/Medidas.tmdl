	/// Escreve a data de entrega do próximo processo de prestação de contas ao Confea (1º de abril), que leva esta planilha como peça III.
	measure 'Processo de contas' = FORMAT(CALCULATE(MIN('Calendário de entregas'[Data]), CONTAINSSTRING('Calendário de entregas'[Entrega], "Processo de prestação de contas")), "dd/mm/yyyy")
