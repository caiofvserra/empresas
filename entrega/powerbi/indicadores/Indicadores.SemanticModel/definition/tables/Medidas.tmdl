/// Guarda as medidas do painel, em pastas por página.
table Medidas
	lineageTag: c37197f8-e77e-5bae-9c8f-0180bb9018b7

	/// Devolve o exercício do eixo (nos gráficos e tabelas em cada exercício), senão o escolhido no alto; sem escolha, o último exercício completo.
	measure 'Exercício escolhido' = ```
			IF(HASONEVALUE('Exercícios da série'[Ano]), VALUES('Exercícios da série'[Ano]),
			  IF(HASONEVALUE('Exercícios'[Ano]), VALUES('Exercícios'[Ano]), CALCULATE(MAX('Exercícios'[Ano]), ALL('Exercícios'), 'Exercícios'[Padrão] = 1)))
			```
		formatString: 0
		displayFolder: Apoio
		lineageTag: f531ce6a-1fa6-53bc-8c24-2f127cf85d2d

	/// Soma as métricas do contexto no exercício: a linha da regional escolhida quando a métrica se divide por regional; senão, a do Conselho inteiro. Vazio é métrica sem valor.
	measure 'Valor da métrica' = ```
			VAR ano = [Exercício escolhido]
			VAR gre = SELECTEDVALUE('Regionais'[GRE])
			VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores'[Valor]), 'Valores'[Ano] = ano, 'Valores'[Nível] = "Regional", 'Valores'[GRE] = gre))
			VAR conselho = CALCULATE(SUM('Valores'[Valor]), 'Valores'[Ano] = ano, 'Valores'[Nível] = "Conselho")
			RETURN IF(NOT ISBLANK(regional), regional, conselho)
			```
		formatString: #,##0
		displayFolder: Apoio
		lineageTag: c81b61dd-e64d-5f77-9c11-6f95bab3e53c

	/// Soma as mesmas métricas no exercício anterior.
	measure 'Valor da métrica no exercício anterior' = ```
			VAR ano = [Exercício escolhido]
			VAR gre = SELECTEDVALUE('Regionais'[GRE])
			VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores'[Valor]), 'Valores'[Ano] = ano - 1, 'Valores'[Nível] = "Regional", 'Valores'[GRE] = gre))
			VAR conselho = CALCULATE(SUM('Valores'[Valor]), 'Valores'[Ano] = ano - 1, 'Valores'[Nível] = "Conselho")
			RETURN IF(NOT ISBLANK(regional), regional, conselho)
			```
		formatString: #,##0
		displayFolder: Apoio
		lineageTag: f4c5ccf9-b97e-52b3-860b-0201c4799af8

	/// Escreve o indicador do contexto no exercício, com o formato da unidade (taxa em %, média com duas casas). Com uma regional, segue a regional quando o indicador se divide por regional.
	measure 'Valor do indicador' = ```
			VAR ano = [Exercício escolhido]
			VAR v = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Conselho")
			  RETURN IF(NOT ISBLANK(regional), regional, conselho)
			RETURN IF(ISBLANK(v), BLANK(), IF(SELECTEDVALUE('Indicadores'[Unidade]) = "%", FORMAT(v / 100, "0.0%"), FORMAT(v, "0.00")))
			```
		displayFolder: Apoio
		lineageTag: 9616b031-0d34-56b7-8907-c4e9b03f1410

	/// Lê o indicador 1 da planilha do Confea, já calculado no CSV pela fórmula: [Nº de profissionais com registro ativo no Crea (nível superior + nível médio) - Nº de profissionais com registro ativo no exercício anterior (nível superior + nível médio)] / Nº de profissionais com registro ativo no exercício anterior (nível superior + nível médio). Com uma regional, segue a regional quando todas as métricas dele se dividem por regional.
	measure 'Crescimento dos profissionais' = ```
			VAR ano = [Exercício escolhido]
			VAR gre = SELECTEDVALUE('Regionais'[GRE])
			VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 1, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 1, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Conselho")
			RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			```
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: d202fe34-6f53-5906-b160-491cda77b253

	/// Mostra, em pontos percentuais, a diferença para o exercício anterior.
	measure 'Em relação ao exercício anterior: Crescimento dos profissionais' = ```
			VAR ano = [Exercício escolhido]
			VAR agora = [Crescimento dos profissionais]
			VAR antes = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 1, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 1, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Conselho")
			  RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			RETURN IF(NOT ISBLANK(agora) && NOT ISBLANK(antes), (agora - antes) * 100)
			```
		formatString: +0.0;-0.0;0.0
		displayFolder: Indicadores
		lineageTag: 772bae4c-1fdb-5516-8d0a-9174fa08ca8b

	/// Lê o indicador 2 da planilha do Confea, já calculado no CSV pela fórmula: (Nº de empresas com registro ativo no Crea - Nº de empresas com registro ativo no exercício anterior) / Nº de empresas com registro ativo no exercício anterior. Com uma regional, segue a regional quando todas as métricas dele se dividem por regional.
	measure 'Crescimento das empresas' = ```
			VAR ano = [Exercício escolhido]
			VAR gre = SELECTEDVALUE('Regionais'[GRE])
			VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 2, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 2, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Conselho")
			RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			```
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: 5da61e1d-b022-5693-929d-5375649c6128

	/// Mostra, em pontos percentuais, a diferença para o exercício anterior.
	measure 'Em relação ao exercício anterior: Crescimento das empresas' = ```
			VAR ano = [Exercício escolhido]
			VAR agora = [Crescimento das empresas]
			VAR antes = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 2, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 2, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Conselho")
			  RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			RETURN IF(NOT ISBLANK(agora) && NOT ISBLANK(antes), (agora - antes) * 100)
			```
		formatString: +0.0;-0.0;0.0
		displayFolder: Indicadores
		lineageTag: 50f87a65-6274-58e3-bfbf-f35d521f9370

	/// Lê o indicador 3 da planilha do Confea, já calculado no CSV pela fórmula: (Nº de profissionais que compõe o QT da empresa) / (Nº de empresas com registro ativo + Nº de empresas com visto ativo). Com uma regional, segue a regional quando todas as métricas dele se dividem por regional.
	measure 'Quadro técnico por empresa' = ```
			VAR ano = [Exercício escolhido]
			VAR gre = SELECTEDVALUE('Regionais'[GRE])
			VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 3, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 3, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Conselho")
			RETURN IF(NOT ISBLANK(regional), regional, conselho)
			```
		formatString: 0.00
		displayFolder: Indicadores
		lineageTag: d8a99062-a503-5a40-8b72-2c3adfbb9457

	/// Mostra a variação, em %, sobre o exercício anterior.
	measure 'Em relação ao exercício anterior: Quadro técnico por empresa' = ```
			VAR ano = [Exercício escolhido]
			VAR agora = [Quadro técnico por empresa]
			VAR antes = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 3, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 3, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Conselho")
			  RETURN IF(NOT ISBLANK(regional), regional, conselho)
			RETURN IF(NOT ISBLANK(agora) && NOT ISBLANK(antes), DIVIDE(agora - antes, antes))
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Indicadores
		lineageTag: 34844f8a-6a75-5ef0-bd8c-b222dcf6c5df

	/// Lê o indicador 4 da planilha do Confea, já calculado no CSV pela fórmula: Nº de profissionais que registraram ART / [Nº de profissionais com registro ativo (nível superior + nível médio) + Nº de profissionais com visto ativo (nível superior + nível médio)]. Com uma regional, segue a regional quando todas as métricas dele se dividem por regional.
