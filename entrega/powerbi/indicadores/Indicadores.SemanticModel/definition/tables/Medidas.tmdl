	/// Escreve "Vazia" ou "Não fecha" na métrica da linha; a preenchida fica em branco e sai da tabela.
	measure 'Situação da métrica' = ```
			VAR ano = [Exercício escolhido]
			VAR st = CALCULATE(SELECTEDVALUE('Situação das métricas'[Situação]), 'Situação das métricas'[Ano] = ano)
			RETURN IF(st <> "Preenchida", st)
