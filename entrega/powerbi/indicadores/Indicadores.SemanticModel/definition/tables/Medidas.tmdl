			  RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			RETURN IF(NOT ISBLANK(agora) && NOT ISBLANK(antes), (agora - antes) * 100)
			```
		formatString: +0.0;-0.0;0.0
		displayFolder: Indicadores
		lineageTag: b9f42234-ac55-522a-934f-d9fc3c90ab3f

	/// Lê o indicador 35 da planilha do Confea, já calculado no CSV pela fórmula: (Nº de multas de quaisquer exercícios não pagas - Nº de multas de quaisquer exercícios não pagas no exercício anterior ao de referência) / (Nº de multas de quaisquer exercícios não pagas no exercício anterior ao de referência). Com uma regional, segue a regional quando todas as métricas dele se dividem por regional.
	measure 'Crescimento das multas não pagas' = ```
			VAR ano = [Exercício escolhido]
			VAR gre = SELECTEDVALUE('Regionais'[GRE])
			VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 35, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 35, 'Valores dos indicadores'[Ano] = ano, 'Valores dos indicadores'[Nível] = "Conselho")
			RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			```
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: 0d64e7d7-30a5-5721-aeb4-381fbc203afa

	/// Mostra, em pontos percentuais, a diferença para o exercício anterior.
	measure 'Em relação ao exercício anterior: Crescimento das multas não pagas' = ```
			VAR ano = [Exercício escolhido]
			VAR agora = [Crescimento das multas não pagas]
			VAR antes = VAR gre = SELECTEDVALUE('Regionais'[GRE])
			  VAR regional = IF(NOT ISBLANK(gre), CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 35, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Regional", 'Valores dos indicadores'[GRE] = gre))
			  VAR conselho = CALCULATE(SUM('Valores dos indicadores'[Valor]), 'Valores dos indicadores'[Indicador] = 35, 'Valores dos indicadores'[Ano] = ano - 1, 'Valores dos indicadores'[Nível] = "Conselho")
			  RETURN DIVIDE(IF(NOT ISBLANK(regional), regional, conselho), 100)
			RETURN IF(NOT ISBLANK(agora) && NOT ISBLANK(antes), (agora - antes) * 100)
			```
		formatString: +0.0;-0.0;0.0
		displayFolder: Indicadores
		lineageTag: c262b4ef-9de9-52d1-a8fc-3c170c06a612

