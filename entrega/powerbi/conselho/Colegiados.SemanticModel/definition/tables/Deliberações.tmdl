/// Guarda cada deliberação de repasse aprovada pelo Plenário, pela ata: a organização, o valor, o objeto, quem propôs e se quem propôs foi indicado pela própria organização.
table 'Deliberações'
	lineageTag: 5453b75c-4a5b-5166-910a-f5047ecf499f

	column 'Deliberação'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Deliberação
		lineageTag: 77bc9bfc-6db5-561a-bcc9-247483465abf

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
		lineageTag: 39959a1d-18a9-562b-acb7-bb3540bb1d74

	column Canal
		dataType: string
		summarizeBy: none
		sourceColumn: Canal
		lineageTag: a7d2be08-6086-555a-927c-7670c10faa63

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: 08caf83f-de4f-5649-925e-67773b7bbd34

	column 'Nome da organização'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome da organização
		lineageTag: 09ecffaf-fd53-5889-a551-6237cda02518

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 70625269-e429-57af-afa1-ab91d26d0be2

	column Objeto
		dataType: string
		summarizeBy: none
		sourceColumn: Objeto
		lineageTag: 3badac24-0f03-5e62-b1c0-1f4c318423d5

	column 'Proposta por'
		dataType: string
		summarizeBy: none
		sourceColumn: Proposta por
		lineageTag: 8f660910-a207-50d6-a71d-1858b5d4e795

	column 'Proposta pela própria organização'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Proposta pela própria organização
		lineageTag: 6f7a5644-81e0-5262-a309-275c850f8c17

	column 'Quem propôs é da organização'
		dataType: string
		summarizeBy: none
		sourceColumn: Quem propôs é da organização
		lineageTag: 5605d84f-835d-5599-ac1f-3c67d52ff792

	partition 'Deliberações' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "deliberacoes.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Deliberação", type text}, {"Data", type date}, {"Canal", type text}, {"Organização", type text}, {"Nome da organização", type text}, {"Valor", type number}, {"Objeto", type text}, {"Proposta por", type text}, {"Proposta pela própria organização", Int64.Type}, {"Quem propôs é da organização", type text}}, "pt-BR")
				in
				    Tipos
