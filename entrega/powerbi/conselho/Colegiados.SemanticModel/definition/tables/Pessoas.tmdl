/// Tem quem pode estar com um processo: os conselheiros (com a câmara e a organização que indicou) e os funcionários da assessoria de cada colegiado. Os nomes do cenário são fictícios.
table Pessoas
	lineageTag: 156380ee-50b7-5c44-a3e8-e93657682203

	column Pessoa
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: 153a7668-8046-5e06-b4e4-54f08e8481f3

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: 6bdcec30-197c-5fe2-a80a-1a181b2a587b

	column Papel
		dataType: string
		summarizeBy: none
		sourceColumn: Papel
		lineageTag: 5d1b02e7-d321-56ad-8af0-ad1f0bc4ecee

	column Detalhe
		dataType: string
		summarizeBy: none
		sourceColumn: Detalhe
		lineageTag: c0923640-0b09-5fce-a60d-07e8ce5eb92d

	partition Pessoas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "pessoas.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Pessoa", type text}, {"Nome", type text}, {"Papel", type text}, {"Detalhe", type text}}, "pt-BR")
				in
				    Tipos
