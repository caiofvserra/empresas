/// Tem os 645 municípios de SP e a GRE de cada um pela tabela oficial. A regional e o município recortam só os processos (e os autos, que são processos), pelo lugar do processo.
table 'Municípios'
	lineageTag: 6b99638a-f1ed-5a0c-9895-1cf242a7e961

	column 'Código IBGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: 4dc7b9b3-dcf7-5365-ba00-aacb265ade94

	column 'Município'
		dataType: string
		summarizeBy: none
		sourceColumn: Município
		lineageTag: 6dcedb30-b283-5bbe-b2f0-81386f9c5d27

	column GRE
		dataType: string
		summarizeBy: none
		sourceColumn: GRE
		lineageTag: e4423325-4c77-5137-9550-51cd57fcf832

	partition 'Municípios' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "municipios.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Código IBGE", type text}, {"Município", type text}, {"GRE", type text}}, "pt-BR")
				in
				    Tipos
