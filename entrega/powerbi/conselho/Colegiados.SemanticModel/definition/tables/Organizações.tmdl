/// Tem as entidades de classe e as instituições de ensino registradas no Crea-SP.
table 'Organizações'
	lineageTag: f25ac489-9dc3-56b7-8354-c931a8a40b8e

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: dc92c0fc-dabf-5672-a915-5074756980ff

	column Sigla
		dataType: string
		summarizeBy: none
		sourceColumn: Sigla
		lineageTag: b3dc960a-440a-5c58-9a06-00d2b72ad2f9

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: abdb7fad-351d-5207-8b04-0535d84ebcd8

	column Natureza
		dataType: string
		summarizeBy: none
		sourceColumn: Natureza
		lineageTag: 423ef832-f18b-5c10-b8e5-9c8a215ec93b

	partition 'Organizações' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "organizacoes.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Organização", type text}, {"Sigla", type text}, {"Nome", type text}, {"Natureza", type text}}, "pt-BR")
				in
				    Tipos
