/// Guarda as diárias pagas a cada conselheiro em cada mês, pela contabilidade.
table 'Diárias'
	isHidden
	lineageTag: 5d45164b-45a2-5429-a4fa-b0432cad9126

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: b3ce5ae8-ebcf-52ce-9d19-4b00af0cb531

	column Pessoa
		dataType: string
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: 5e2591a9-f53e-5497-911d-3c41062c343a

	column 'Diárias'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Diárias
		lineageTag: 837dc88b-5328-5be1-bccf-c6c3af31e3de

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 7623b352-8ce6-5184-82a7-82aa1f7414b7

	partition 'Diárias' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "diarias.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Pessoa", type text}, {"Diárias", Int64.Type}, {"Valor", type number}}, "pt-BR")
				in
				    Tipos
