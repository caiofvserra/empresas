/// Tem o Plenário e as nove câmaras especializadas, com os nomes do sistema do Conselho. Escolha um por vez.
table Colegiados
	lineageTag: edbd7a5e-53ed-5b14-a252-ffa6957f2851

	column Colegiado
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Colegiado
		lineageTag: 60287b0c-e2b6-5d8a-b5cb-ba3435f9512b

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		sortByColumn: Ordem
		lineageTag: ce80a00a-b2ce-5d0c-8def-ccb24f60e8cb

	column Ordem
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem
		lineageTag: 37ee575c-9d63-56fa-b009-03a4b084465b

	partition Colegiados = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "colegiados.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Colegiado", type text}, {"Nome", type text}, {"Ordem", Int64.Type}}, "pt-BR")
				in
				    Tipos
