	/// Soma os pagamentos dos 365 dias até a data às organizações com cadeira no colegiado escolhido, por convênio, contrato ou patrocínio.
	measure 'Repassado em 12 meses a quem tem cadeira' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR orgs = CALCULATETABLE(VALUES('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(SUM('Pagamentos dos repasses'[Valor]), 'Pagamentos dos repasses'[Data] > d - 365, 'Pagamentos dos repasses'[Data] <= d, 'Pagamentos dos repasses'[Início do repasse] <= d, KEEPFILTERS('Pagamentos dos repasses'[Organização] IN orgs))
			```
		formatString: R$ #,##0
		displayFolder: Representação
		lineageTag: 33fb49fe-4536-521c-a61d-dd9665cb5339

	/// Soma o que as organizações com cadeira no colegiado escolhido receberam do Conselho nos 365 dias até a data.
	measure 'Repasses a quem tem cadeira' = [Repassado em 12 meses a quem tem cadeira] + 0
		formatString: R$ #,##0
		displayFolder: Representação
		lineageTag: 46957e96-c963-5fec-a0a4-fd2e40302af3

	/// Conta as organizações com cadeira que receberam algum pagamento nos 365 dias.
	measure 'Organizações com cadeira que receberam' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR orgs = CALCULATETABLE(VALUES('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(DISTINCTCOUNT('Pagamentos dos repasses'[Organização]), 'Pagamentos dos repasses'[Data] > d - 365, 'Pagamentos dos repasses'[Data] <= d, 'Pagamentos dos repasses'[Início do repasse] <= d, KEEPFILTERS('Pagamentos dos repasses'[Organização] IN orgs)) + 0
			```
		formatString: #,##0
		displayFolder: Representação
		lineageTag: 6087e924-30f5-57c2-b461-f2dc35ce6fa3

	/// Soma o valor das deliberações de repasse aprovadas pelo Plenário no período; na tabela, o valor de cada uma.
	measure 'Valor das deliberações' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR orgs = CALCULATETABLE(VALUES('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(SUM('Deliberações'[Valor]), 'Deliberações'[Data] >= inicio, 'Deliberações'[Data] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Deliberações'[Organização] IN orgs))
			```
		formatString: R$ #,##0
