		lineageTag: 3af83086-0241-5224-a451-569e010a9ced

	/// Conta os processos que saíram em diligência no período, para buscar informação antes do voto.
	measure 'Diligências' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Eventos'[Tramitação]), 'Eventos'[Desde] >= inicio, 'Eventos'[Desde] <= d, KEEPFILTERS('Eventos'[Status] = "Diligência")) + 0
