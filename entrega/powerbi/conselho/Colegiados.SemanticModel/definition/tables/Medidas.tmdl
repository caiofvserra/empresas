		lineageTag: ec88bab0-f334-5162-961c-eac8bfcbfeef

	/// Conta as deliberações de repasse aprovadas pelo Plenário no período, pelas atas. Com uma câmara escolhida, as de organizações com cadeira nela.
	measure 'Deliberações de repasse' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR orgs = CALCULATETABLE(VALUES('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(COUNTROWS('Deliberações'), 'Deliberações'[Data] >= inicio, 'Deliberações'[Data] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Deliberações'[Organização] IN orgs)) + 0
			```
		formatString: #,##0
