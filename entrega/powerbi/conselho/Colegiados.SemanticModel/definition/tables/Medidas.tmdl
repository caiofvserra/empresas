		lineageTag: 01782088-9d14-5e1a-b020-75702bb3ceb9

	/// Mostra a parte dos autos votados no período que a câmara arquivou, inclusive pela prescrição.
	measure 'Autos arquivados' = DIVIDE([Autos arquivados no período], [Autos votados])
