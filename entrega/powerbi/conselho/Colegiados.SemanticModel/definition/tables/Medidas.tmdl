		lineageTag: 8043062d-e321-5ee3-ac02-dc45fb3da470

	/// Conta os autos votados de empresas ou profissionais que já tinham multa antes: a multa vem em dobro (Lei 5.194/66, art. 73, parágrafo único).
	measure 'Autos de reincidentes' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))), KEEPFILTERS('Autos'[Reincidente] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 2d7030d4-e8ef-555e-9462-d3ac0896aa31

	/// Soma as multas da decisão das câmaras no período, antes do recurso. É um fluxo.
	measure 'Multas aplicadas' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(SUM('Autos'[Multa da câmara]), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))) + 0
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 854c1e96-e0ca-58dc-a445-58cecde9cb7d

	/// Conta os autos arquivados porque prescreveram.
	measure 'Autos arquivados pela prescrição' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))), KEEPFILTERS('Autos'[Desfecho] = "Arquivamento pela prescrição")) + 0
			```
		formatString: #,##0
