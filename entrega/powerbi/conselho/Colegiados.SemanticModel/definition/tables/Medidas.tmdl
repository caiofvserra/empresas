		displayFolder: Conselheiros
		lineageTag: c19a064b-98c1-5ba9-8d8e-d5535968f90c

	/// Conta as diárias pagas a cada conselheiro nos 12 meses.
	measure 'Diárias de conselheiros em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(SUM('Diárias'[Diárias]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem))
			```
		formatString: #,##0
		displayFolder: Conselheiros
		lineageTag: 3b8a72b4-e8cb-52f2-9f36-2fbcf20c2861

	/// Conta os meses dos 12 em que o conselheiro recebeu diária.
	measure 'Meses com diária de conselheiro' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Mês]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem))
			```
		formatString: 0
		displayFolder: Conselheiros
		lineageTag: 9984f5e0-6207-5cd2-bc8a-07581a7ab751

	/// Conta os conselheiros em exercício que receberam diária nos 12 meses.
	measure 'Conselheiros com diária' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Pessoa]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem)) + 0
			```
		formatString: #,##0
		displayFolder: Conselheiros
		lineageTag: c3dc33c5-6a1c-522b-8ee4-238d69208c7c

	/// Conta os autos de infração votados pelas câmaras no período, para os gráficos.
	measure 'Autos votados' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))))
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: c5c3a77c-b17c-579a-be3b-4fb4f8a9887d

	/// Conta os autos de infração votados pelas câmaras no período. Com o Plenário escolhido, só os autos que chegaram a ele em recurso.
	measure 'Autos votados nas câmaras' = [Autos votados] + 0
		formatString: #,##0
