	/// Conta os profissionais ativos da modalidade que cada câmara julga, na data escolhida; com uma câmara escolhida, só os dela.
	measure 'Profissionais ativos da câmara' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(SUM('Foto das câmaras'[Profissionais ativos]), 'Foto das câmaras'[Data] = d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Foto das câmaras'[Câmara] = c))
