		lineageTag: 43548d63-ce33-5ff5-beaf-73ab5734625c

	/// Conta os recursos que já chegaram ao Plenário e ainda não foram votados na data escolhida. É um estoque.
	measure 'Recursos esperando o Plenário' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Tramitações'[Instância] = "Plenário")) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 98058022-3891-5810-84d9-c3ea8e7516d3

	/// Conta os recursos votados pelo Plenário no período. Com uma câmara escolhida, conta os que vieram dela.
	measure 'Recursos votados pelo Plenário' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Tramitações'), REMOVEFILTERS('Colegiados'), 'Tramitações'[Instância] = "Plenário", 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Tramitações'[Câmara de origem] = c)) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 3d613c1a-844e-551c-9014-28c28111ac81

	/// Conta os recursos votados pelo Plenário no período em que ele reformou a decisão da câmara. Com uma câmara escolhida, conta os que vieram dela.
	measure 'Recursos reformados pelo Plenário' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Tramitações'), REMOVEFILTERS('Colegiados'), 'Tramitações'[Instância] = "Plenário", 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Tramitações'[Câmara de origem] = c), KEEPFILTERS('Tramitações'[Decisão do Plenário] = "Decisão reformada")) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 150f2e68-62a7-5486-b0f6-b8f09694a519

	/// Mostra a parte dos recursos votados pelo Plenário no período em que ele reformou a decisão da câmara.
	measure 'Reformadas pelo Plenário' = DIVIDE([Recursos reformados pelo Plenário], [Recursos votados pelo Plenário])
		formatString: 0.0%
		displayFolder: Decisões
		lineageTag: 61bdb652-fd9a-5e50-a1e1-12aab2995299

	/// Conta os recursos votados pelo Plenário no período, pela câmara de onde vieram. Com uma câmara escolhida, só os dela.
	measure 'Recursos votados no Plenário por câmara' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Tramitações'), REMOVEFILTERS('Colegiados'), 'Tramitações'[Instância] = "Plenário", 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Tramitações'[Câmara de origem] = c))
			```
		formatString: #,##0
