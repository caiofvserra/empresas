		lineageTag: a7c936ee-b5d6-5d54-8785-7066becb3b9d

	/// Conta os autos votados no período que a câmara arquivou, inclusive pela prescrição.
	measure 'Autos arquivados no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))), KEEPFILTERS('Autos'[Desfecho] IN {"Arquivamento", "Arquivamento pela prescrição"})) + 0
			```
		formatString: #,##0
