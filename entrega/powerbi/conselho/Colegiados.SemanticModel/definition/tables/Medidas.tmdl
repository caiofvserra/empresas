	/// Conta as organizações que indicaram os conselheiros em exercício.
	measure 'Organizações com cadeira' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(DISTINCTCOUNT('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c)) + 0
			```
		formatString: #,##0
		displayFolder: Representação
		lineageTag: a3f99d75-4323-575b-9535-4bbd2bfb7d1a

	/// Conta as mulheres entre os conselheiros em exercício.
	measure 'Conselheiras em exercício' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Conselheiros'), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c), KEEPFILTERS('Conselheiros'[Gênero] = "Feminino")) + 0
			```
		formatString: #,##0
		displayFolder: Representação
		lineageTag: c697f993-db8e-5dc9-aca0-b2fbf87bbf6e

	/// Mostra a parte de mulheres entre os conselheiros em exercício.
	measure Conselheiras = DIVIDE([Conselheiras em exercício], [Conselheiros em exercício])
		formatString: 0.0%
		displayFolder: Representação
		lineageTag: f0937662-db6e-5414-a84d-f7aacbd3421d

	/// Mostra a parte de mulheres entre os conselheiros em exercício de cada câmara do eixo.
	measure 'Mulheres entre os conselheiros' = ```
			VAR camaras = VALUES('Foto das câmaras'[Câmara])
			RETURN DIVIDE(CALCULATE([Conselheiras em exercício], TREATAS(camaras, 'Conselheiros'[Câmara])), CALCULATE([Conselheiros em exercício], TREATAS(camaras, 'Conselheiros'[Câmara])))
