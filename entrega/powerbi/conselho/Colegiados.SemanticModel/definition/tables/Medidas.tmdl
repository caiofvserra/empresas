		lineageTag: cb7cf07e-222b-5d1c-88cc-ce3648ea9453

	/// Soma, pelo ano da decisão da câmara (os quatro últimos), as multas já pagas na data escolhida.
	measure 'Multa paga' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), NOT ('Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d) && NOT ISBLANK('Autos'[Pago em]) && 'Autos'[Pago em] <= d), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 0d00e60a-81ef-5d60-acc9-67e2344e190d

	/// Soma, pelo ano da decisão, as multas que transitaram em julgado e ainda não foram pagas.
	measure 'Multa em cobrança' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), NOT ('Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d) && NOT (NOT ISBLANK('Autos'[Pago em]) && 'Autos'[Pago em] <= d) && NOT ISBLANK('Autos'[Trânsito em julgado]) && 'Autos'[Trânsito em julgado] <= d), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 60131de0-beb3-5ace-99a6-3ff8144a7189

	/// Soma, pelo ano da decisão, as multas ainda em recurso (no Plenário ou no Confea).
	measure 'Multa em recurso' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), NOT ('Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d) && NOT (NOT ISBLANK('Autos'[Pago em]) && 'Autos'[Pago em] <= d) && NOT (NOT ISBLANK('Autos'[Trânsito em julgado]) && 'Autos'[Trânsito em julgado] <= d)), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 23d2434c-aaff-5c62-bce8-dd2434dbf603

	/// Soma, pelo ano da decisão, as multas que o Plenário anulou ao reformar a decisão da câmara.
	measure 'Multa anulada no recurso' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), 'Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: eb645503-0606-5fc5-bd0c-78cbaf50e044

	/// Conta as cadeiras com conselheiro em exercício na data escolhida, do colegiado escolhido.
	measure 'Cadeiras ocupadas' = [Conselheiros em exercício]
