			RETURN CALCULATE(SUM('Foto das câmaras'[Profissionais ativas]), 'Foto das câmaras'[Data] = d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Foto das câmaras'[Câmara] = c))
