	/// Conta os processos esperando voto que estão com cada conselheiro na data escolhida, como relator ou no pedido de vista.
	measure 'Processos com o conselheiro' = CALCULATE([Processos na fila], 'Pessoas'[Papel] = "Conselheiro")
		formatString: #,##0
