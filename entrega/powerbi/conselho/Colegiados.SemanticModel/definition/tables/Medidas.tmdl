	/// Mostra o tempo típico de relato sem IA em cada trimestre do eixo, dos processos distribuídos depois que a IA chegou.
	measure 'Relato sem IA no trimestre' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] <= d, 'Tramitações'[Relato com IA] = 0, 'Tramitações'[Distribuído depois da IA] = 1)
