		lineageTag: 6b0060dd-6bd3-5fd7-bd85-efb51338c7fe

	/// Mostra o tempo típico de relato com IA em cada trimestre do eixo, até a data escolhida.
	measure 'Relato com IA no trimestre' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] <= d, 'Tramitações'[Relato com IA] = 1, 'Tramitações'[Distribuído depois da IA] = 1)
