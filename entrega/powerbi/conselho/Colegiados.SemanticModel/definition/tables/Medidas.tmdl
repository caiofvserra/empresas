/// Guarda as medidas do painel, em pastas por página.
table Medidas
	lineageTag: 0ed2f05b-834f-5bbd-b381-6933bdecf962

	/// Devolve a data de referência escolhida; sem escolha, a mais recente. As medidas de variação trocam a data pela de um ano antes.
	measure 'Data escolhida' = IF(ISFILTERED('Datas das fotos'[Data]), MAX('Datas das fotos'[Data]), MAX('Datas de referência'[Data]))
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 66b5b50c-e8d9-5ada-a6c5-82e43e13d3ef

	/// Devolve o período escolhido, em meses; sem escolha, 12.
	measure 'Meses do período' = SELECTEDVALUE('Período'[Meses], 12)
		formatString: 0
		displayFolder: Apoio
		lineageTag: 238df560-c7a0-5eaa-be36-6e6886d4e2d7

	/// Devolve o primeiro dia do primeiro mês do período: o período termina na data escolhida e começa no primeiro dia do mês, como no painel.
	measure 'Início do período' = ```
			VAR d = [Data escolhida]
			RETURN DATE(YEAR(d), MONTH(d) - [Meses do período] + 1, 1)
			```
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 4eea38c8-ff18-5baa-8d38-faa038ffec91

	/// Conta os conselheiros em exercício na data escolhida (mandato em curso, de organização já registrada), do colegiado escolhido; no Plenário, todos. Sem o + 0, para o gráfico dos terços mostrar só os terços em curso.
	measure 'Conselheiros no terço' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Conselheiros'), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 4ed4ef2e-8bd0-5fd4-8df7-a2063bd45c6f

	/// Conta os conselheiros em exercício na data escolhida, do colegiado escolhido; no Plenário, todos. O conselheiro representa uma modalidade, e não uma regional: a regional e o município não mudam este número.
	measure 'Conselheiros em exercício' = [Conselheiros no terço] + 0
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 71fcdd95-632a-5a8f-be49-614d6470f6a4

	/// Conta as entidades de classe que indicaram os conselheiros em exercício.
	measure 'Entidades com cadeira' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(DISTINCTCOUNT('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c), KEEPFILTERS('Conselheiros'[Natureza] = "Entidade de classe")) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 37db21f9-fb20-5237-b50a-d5f15cdc2d18

	/// Conta as instituições de ensino que indicaram os conselheiros em exercício.
	measure 'Escolas com cadeira' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(DISTINCTCOUNT('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c), KEEPFILTERS('Conselheiros'[Natureza] = "Instituição de ensino")) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 81a826de-9327-5aa4-9227-41d67c954b7f

	/// Conta os processos esperando voto na data escolhida, para os gráficos (sem o + 0, a pessoa ou o status sem processo some do gráfico).
	measure 'Processos na fila' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 1be89158-68e8-5b4a-afb7-81307b603ab1

	/// Conta os processos que já entraram no colegiado e ainda não foram votados na data escolhida, em qualquer status do Votenet. É um estoque: não tem acumulado do ano.
	measure 'Processos esperando voto' = [Processos na fila] + 0
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 66a1c292-38fe-5c5c-a579-968a83bc9331

	/// Conta os processos esperando voto que ainda não foram distribuídos a um relator.
	measure 'Aguardando distribuição' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Status] = "Aguardando distribuição")) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: d767bb76-9664-5054-9de0-c31eb3ff27e3

	/// Divide os processos esperando voto que estão com um conselheiro (relator ou pedido de vista) pelos conselheiros em exercício. Os que estão com a assessoria ficam de fora.
	measure 'Processos por conselheiro' = DIVIDE(CALCULATE([Processos esperando voto], 'Pessoas'[Papel] = "Conselheiro"), [Conselheiros em exercício])
		formatString: 0.0
		displayFolder: Colegiado
		lineageTag: 6a05309d-7a23-5a2f-aefd-e7b5a0b2aa40

	/// Conta os processos votados no período, nas câmaras e no Plenário. Um processo que foi ao Plenário conta duas vezes: uma em cada colegiado.
	measure 'Votados no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: c60cfda5-c851-53bb-bc80-5dad65450e62

	/// Conta os recursos votados pelo Plenário no período.
	measure 'Votados no Plenário no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS('Tramitações'[Instância] = "Plenário")) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 626c9fde-eb23-5478-a4a9-1f06b954eb6d

	/// Mostra o tempo típico (a mediana), em dias, da abertura no GovAdm ao voto da câmara, nos processos votados nas câmaras no período. É o marco do Confea para a 1ª instância.
	measure 'Da abertura à decisão' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias da abertura ao voto]), 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d)
			```
		formatString: #,##0" dias"
		displayFolder: Colegiado
		lineageTag: 786b3663-ddf3-5d0d-96f8-784b93fea45a

	/// Conta os processos esperando voto que entraram no colegiado antes de 1º de janeiro do ano da data escolhida: os pendentes de exercícios anteriores, marco do Confea.
	measure 'De exercícios anteriores' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[De exercício anterior] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 7a3cf379-ecf3-5d53-8b4c-8ae106d2d296

	/// Conta as idas à pauta em cada mês, nos meses do gráfico. Um processo pautado de novo depois de uma vista conta outra vez.
	measure 'Pautados no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Eventos'), 'Eventos'[Status] = "Pautado", 'Eventos'[Mês] = mes, 'Eventos'[Desde] <= d) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 316eda86-3e88-5b74-a9c1-7abecf991b43

	/// Conta os processos votados em cada mês, nos meses do gráfico.
	measure 'Votados no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Mês do voto] = mes, 'Tramitações'[Votado em] <= d) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: cf8e400f-d747-51e9-8944-a787b37b8580

	/// Conta os processos votados no mesmo mês um ano antes, para comparar.
	measure 'Votados no mesmo mês do ano anterior' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Mês do voto] = EDATE(mes, -12)) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 2c6f4e2f-c51a-5545-8044-42d7256222b4

	/// Conta os processos recebidos nas câmaras no período (o recebimento no GovAdm).
	measure 'Caminho: recebidos nas câmaras' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Tramitações'[Processo]), 'Tramitações'[Entrada] <= d, 'Tramitações'[Entrada do processo] >= inicio, 'Tramitações'[Entrada do processo] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 952620d4-1719-54d2-964f-a00c71e3ea8b

	/// Conta os processos votados pelas câmaras no período.
	measure 'Caminho: votados nas câmaras' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Tramitações'[Processo]), 'Tramitações'[Entrada] <= d, 'Tramitações'[Julgado na câmara em] >= inicio, 'Tramitações'[Julgado na câmara em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: d72590bc-f3e9-55c6-8be7-7b34771e4aeb

	/// Conta os recursos ao Plenário apresentados no período.
	measure 'Caminho: recursos ao Plenário' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Tramitações'[Processo]), 'Tramitações'[Entrada] <= d, 'Tramitações'[Recurso em] >= inicio, 'Tramitações'[Recurso em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 1a7be1b9-835d-5a6f-b755-30212ede6d94

	/// Conta os recursos votados pelo Plenário no período.
	measure 'Caminho: votados no Plenário' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Tramitações'[Processo]), 'Tramitações'[Entrada] <= d, 'Tramitações'[Plenário em] >= inicio, 'Tramitações'[Plenário em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: bc19456c-84b6-5fd2-8fd3-a164d9e9786f

	/// Conta os autos com recurso ao Confea no período.
	measure 'Caminho: recursos ao Confea' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Recurso ao Confea em] >= inicio, 'Autos'[Recurso ao Confea em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 03140165-fe28-5c47-90b1-868d7dba38c0

	/// Conta os autos que transitaram em julgado no período: a multa passa a ser cobrada.
	measure 'Caminho: transitados em julgado' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Trânsito em julgado] >= inicio, 'Autos'[Trânsito em julgado] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: 789ce935-25c7-5d33-ad06-e56d213f8150

	/// Conta os autos com a multa paga no período.
	measure 'Caminho: multas pagas' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Pago em] >= inicio, 'Autos'[Pago em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))) + 0
			```
		formatString: #,##0
		displayFolder: Colegiado
		lineageTag: d98bd237-d7e8-51a9-8734-19df0b69c6b2

	/// Conta os processos há mais de 120 dias no mesmo status do Votenet na data escolhida (decisão do Caio, 07/11/2026).
	measure 'Em alerta vermelho' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Alerta] = "Vermelho")) + 0
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 229e6de3-24ae-514d-bbce-6f7b7b4b1878

	/// Conta os processos de 90 a 120 dias no mesmo status do Votenet.
	measure 'Em alerta amarelo' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Alerta] = "Amarelo")) + 0
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 1e009e90-ac23-594a-9f9f-0a28e1cc6719

	/// Conta os processos esperando voto que entraram no colegiado há mais de um ano.
	measure 'Há mais de 1 ano no colegiado' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Mais de um ano] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 93d2a31f-cfa5-5961-a30b-2d170332a0ba

	/// Conta os autos perto da prescrição, para o gráfico por relator.
	measure 'Perto da prescrição' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Perto da prescrição] = 1))
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 63e9ed60-87f3-5e2a-a18f-88b8c4075a55

	/// Conta os autos de infração esperando voto que prescrevem em até 12 meses: cinco anos do fato (Lei 9.873/1999, art. 1º) ou três anos parados no mesmo status (a intercorrente, art. 1º, § 1º), o que vier primeiro. No Plenário, só corre a intercorrente.
	measure 'Autos perto da prescrição' = [Perto da prescrição] + 0
		formatString: #,##0
		displayFolder: Processos
		lineageTag: f64ab154-aa44-557e-bc93-953c9eea8715

	/// Soma as multas dos autos que prescrevem em até 12 meses.
	measure 'Multas dos autos perto da prescrição' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da fila'[Multa]), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Perto da prescrição] = 1)) + 0
			```
		formatString: R$ #,##0
		displayFolder: Processos
		lineageTag: f6647bcc-2fc6-5e8e-a3a0-16b4dbbaa6fb

	/// Conta os autos que prescrevem em até 12 meses por estarem parados há quase três anos no mesmo status.
	measure 'Perto da prescrição pela intercorrente' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Pela intercorrente] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 1d0c8240-1e51-5dea-bba8-f2f8d0d2877f

	/// Conta os processos há mais de dois anos no mesmo status: com três, o auto prescreve pela intercorrente.
	measure 'Parados há mais de 2 anos' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Foto da fila'[Parado há mais de dois anos] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: d1c96223-7741-5d79-b8f9-f4ab3d7d6fc6

	/// Mostra há quantos dias o processo está no status do Votenet, na data escolhida.
	measure 'Dias no status' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(MAX('Foto da fila'[Dias no status]), 'Foto da fila'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 5b08a0ae-3c37-574c-a5bd-c376c5805bdd

	/// Mostra há quantos dias o processo entrou no colegiado, na data escolhida.
	measure 'Dias desde a entrada' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(MAX('Foto da fila'[Dias desde a entrada]), 'Foto da fila'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 2013b4ca-8b16-5ee4-a83e-82a22f21e3b5

	/// Conta os processos recebidos nas câmaras no período, que a assessoria cadastra à mão no Votenet.
	measure 'Cadastrados no Votenet' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Entrada] >= inicio, 'Tramitações'[Entrada] <= d, KEEPFILTERS('Tramitações'[Instância] = "Câmara"))
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 488495d9-627b-56fb-9794-a50107fb0c4e

	/// Conta os recebidos no período que levaram mais de 15 dias até o cadastro no Votenet.
	measure 'Cadastrados no Votenet depois de 15 dias' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Entrada] >= inicio, 'Tramitações'[Entrada] <= d, KEEPFILTERS('Tramitações'[Instância] = "Câmara"), KEEPFILTERS('Tramitações'[Dias até o Votenet] > 15)) + 0
			```
		formatString: #,##0
		displayFolder: Processos
		lineageTag: 3d5bd941-3a0b-5d7f-8865-1499823c5452

	/// Mostra o tempo típico (a mediana), em dias, entre o recebimento na câmara pelo GovAdm e o cadastro no Votenet, nos processos recebidos no período.
	measure 'Do GovAdm ao Votenet' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias até o Votenet]), 'Tramitações'[Entrada] >= inicio, 'Tramitações'[Entrada] <= d, KEEPFILTERS('Tramitações'[Instância] = "Câmara"))
			```
		formatString: #,##0" dias"
		displayFolder: Processos
		lineageTag: b73b48ac-5688-580e-8734-fec49100f8ab

	/// Conta as sessões ordinárias do colegiado escolhido no período.
	measure 'Sessões no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Presenças'[Sessão]), 'Presenças'[Data] >= inicio, 'Presenças'[Data] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Conselheiros
		lineageTag: faceac48-a69e-501e-9309-1cd02b9a5c73

	/// Divide as presenças pelos lugares nas sessões ordinárias do período (cada conselheiro do colegiado em cada sessão), pela ata. Na base real, até a API de transparência publicar as atas, o jeton pago aproxima a presença.
	measure 'Presença nas sessões' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR presentes = CALCULATE(SUM('Presenças'[Presente]), 'Presenças'[Data] >= inicio, 'Presenças'[Data] <= d)
			VAR lugares = CALCULATE(COUNTROWS('Presenças'), 'Presenças'[Data] >= inicio, 'Presenças'[Data] <= d)
			RETURN DIVIDE(presentes, lugares)
			```
		formatString: 0.0%
		displayFolder: Conselheiros
		lineageTag: 4c6d12b0-56a7-53e2-b58b-91e8d766655f

	/// Mostra o tempo típico (a mediana), em dias, da distribuição ao relator ao relato assinado, nos relatos assinados no período antes do voto.
	measure 'Tempo de relato' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] >= inicio, 'Tramitações'[Assinado em] <= d)
			```
		formatString: #,##0" dias"
		displayFolder: Conselheiros
		lineageTag: 28cd3a67-bcf4-5ff9-a1a6-456fc733e902

	/// Mostra o tempo típico de relato dos relatos feitos com a IA no período.
	measure 'Relato com IA' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] >= inicio, 'Tramitações'[Assinado em] <= d, KEEPFILTERS('Tramitações'[Relato com IA] = 1))
			```
		formatString: #,##0" dias"
		displayFolder: Conselheiros
		lineageTag: 8e0a0972-cb04-5400-9b74-478a0d70ef1b

	/// Mostra o tempo típico de relato dos relatos sem IA, só dos processos distribuídos depois que a IA chegou (julho de 2025), para comparar.
	measure 'Relato sem IA' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] >= inicio, 'Tramitações'[Assinado em] <= d, KEEPFILTERS('Tramitações'[Relato com IA] = 0), KEEPFILTERS('Tramitações'[Distribuído depois da IA] = 1))
			```
		formatString: #,##0" dias"
		displayFolder: Conselheiros
		lineageTag: e6666454-9723-534e-ae80-06bcae87a8a1

	/// Conta os relatos feitos com a IA no período.
	measure 'Relatos com IA' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNT('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] >= inicio, 'Tramitações'[Assinado em] <= d, KEEPFILTERS('Tramitações'[Relato com IA] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Conselheiros
		lineageTag: 4a65d167-787c-5f6d-bd0b-73cf607a0510

	/// Conta os relatos sem IA no período, dos processos distribuídos depois que a IA chegou.
	measure 'Relatos sem IA' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNT('Tramitações'[Dias de relato]), 'Tramitações'[Assinado em] >= inicio, 'Tramitações'[Assinado em] <= d, KEEPFILTERS('Tramitações'[Relato com IA] = 0), KEEPFILTERS('Tramitações'[Distribuído depois da IA] = 1)) + 0
			```
		formatString: #,##0
