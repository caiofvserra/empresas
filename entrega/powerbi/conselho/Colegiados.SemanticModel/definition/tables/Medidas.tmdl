		lineageTag: 2c343aec-1e10-55ba-97da-c224894524a9

	/// Soma as diárias pagas nos 12 meses até a data a cada conselheiro em exercício nela, do colegiado escolhido.
	measure 'Valor das diárias de conselheiros' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(SUM('Diárias'[Valor]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem))
			```
		formatString: R$ #,##0
		displayFolder: Conselheiros
		lineageTag: e1ee77a0-9111-5b12-b5ba-2d887f593a21

	/// Soma as diárias pagas nos 12 meses até a data aos conselheiros em exercício nela, do colegiado escolhido. Quem recebeu aparece pelo nome na tabela.
	measure 'Diárias dos conselheiros' = [Valor das diárias de conselheiros] + 0
