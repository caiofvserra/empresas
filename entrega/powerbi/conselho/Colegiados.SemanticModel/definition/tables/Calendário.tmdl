/// Tem um mês por linha, de 2020 até 12 meses depois de hoje, para o gráfico mês a mês. Não se liga às outras tabelas: as medidas leem o mês do eixo.
table 'Calendário'
	lineageTag: bc8bfbaa-accc-50b4-8539-c5b272c604a5

	column 'Mês'
		dataType: dateTime
		formatString: mmm/yy
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 59ba4d6d-6116-5137-beb5-88b53e627aa6

	column 'Rótulo'
		dataType: string
		summarizeBy: none
		sourceColumn: Rótulo
		sortByColumn: 'Mês'
		lineageTag: 51c4e032-1a25-5434-9b23-80ca9fd89267

	column Ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Ano
		lineageTag: 87d56651-7f3f-5fe3-8f44-9f7984e285ea

	column 'Mês do ano'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Mês do ano
		lineageTag: 84e22b4a-97c3-509c-a1e5-9612e3e72e7b

	column 'Nome do mês'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome do mês
		sortByColumn: 'Mês do ano'
		lineageTag: 0b041c3b-d904-5c19-8eee-c583812c8728

	column Ordem
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem
		lineageTag: 5d90e7e4-630f-5d6e-b77f-976cd72825ff

	partition 'Calendário' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "calendario.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Rótulo", type text}, {"Ano", Int64.Type}, {"Mês do ano", Int64.Type}, {"Nome do mês", type text}, {"Ordem", Int64.Type}}, "pt-BR")
				in
				    Tipos
