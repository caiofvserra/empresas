/// Guarda cada pagamento de convênio, contrato ou patrocínio às organizações, com o canal e o início do instrumento.
table 'Pagamentos dos repasses'
	lineageTag: 0101a7fd-ce35-50a3-baab-6dd50d66aba0

	column Repasse
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Repasse
		lineageTag: e8d0528d-5a5a-5047-b8f3-c9258a5444e8

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: 8826e946-a0e6-5dcc-a5ea-81ce88b25dd3

	column Canal
		dataType: string
		summarizeBy: none
		sourceColumn: Canal
		lineageTag: db01447d-7375-5a0b-ba80-3a55097eb3d4

	column 'Início do repasse'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Início do repasse
		lineageTag: 06ffd309-8b81-5663-9376-e4418a37ea68

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Data
		lineageTag: 5f7f405a-1bc9-55ac-9046-0ca2d4ff3351

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: fa7a84b0-2131-528a-a7ae-796843054e6d

	partition 'Pagamentos dos repasses' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "pagamentos-repasses.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Repasse", type text}, {"Organização", type text}, {"Canal", type text}, {"Início do repasse", type date}, {"Data", type date}, {"Valor", type number}}, "pt-BR")
				in
				    Tipos
