/// Guarda, no último dia de cada mês, as cadeiras de cada câmara no Plenário e os profissionais ativos (e as profissionais ativas) da modalidade que ela julga.
table 'Foto das câmaras'
	lineageTag: 185772a1-a7b0-5b23-b928-73d9a2e7d70e

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Data
		lineageTag: 66d1ffe0-5c9e-5c56-a83f-0ae81a824435

	column 'Câmara'
		dataType: string
		summarizeBy: none
		sourceColumn: Câmara
		lineageTag: b1a6204a-8810-5c34-8d97-71e2038a6623

	column Cadeiras
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Cadeiras
		lineageTag: 1dfecb5c-b1a8-5166-bbab-2114482b6a65

	column 'Profissionais ativos'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Profissionais ativos
		lineageTag: 660ecbdf-e4e3-57f1-beb2-af27139b029a

	column 'Profissionais ativas'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Profissionais ativas
		lineageTag: 662863c5-d4dd-5e93-bea3-a49dfb784a90

	partition 'Foto das câmaras' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "foto-camaras.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Data", type date}, {"Câmara", type text}, {"Cadeiras", Int64.Type}, {"Profissionais ativos", Int64.Type}, {"Profissionais ativas", Int64.Type}}, "pt-BR")
				in
				    Tipos
