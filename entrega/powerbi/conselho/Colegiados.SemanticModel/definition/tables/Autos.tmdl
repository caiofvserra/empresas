/// Guarda cada auto de infração votado na câmara: o desfecho, a infração (alínea do art. 73 da Lei 5.194/66), a multa da câmara e a que vale depois do Plenário, e as datas do recurso ao Plenário e ao Confea, do trânsito em julgado e do pagamento.
table Autos
	lineageTag: f1bb5d28-9edb-55be-9393-79901f751441

	column Processo
		dataType: string
		summarizeBy: none
		sourceColumn: Processo
		lineageTag: 46db5949-bd07-5ab3-873f-49c1d0468ece

	column 'Câmara'
		dataType: string
		summarizeBy: none
		sourceColumn: Câmara
		lineageTag: 4556ba99-bb58-5b17-a98d-88a1d670dc2a

	column 'Código IBGE'
		dataType: string
