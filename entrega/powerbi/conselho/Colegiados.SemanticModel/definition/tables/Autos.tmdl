		sourceColumn: Reincidente
		lineageTag: 377d0adf-0813-537d-94ae-e3e71c88128a

	column 'Multa da câmara'
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Multa da câmara
		lineageTag: e50781d3-b344-53d5-aaea-b78b89ff4732

	column 'Multa final'
		dataType: double
		formatString: R$ #,##0
