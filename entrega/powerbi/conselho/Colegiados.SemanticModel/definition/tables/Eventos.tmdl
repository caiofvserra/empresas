/// Guarda cada ida à pauta e cada desvio do Votenet (pedido de vista, impedimento, diligência), com a data e a pessoa.
table Eventos
	isHidden
	lineageTag: ddd62976-dcba-597c-8e63-05ae5db6509b

	column 'Tramitação'
		dataType: string
		summarizeBy: none
		sourceColumn: Tramitação
		lineageTag: d65b78b2-922e-52dc-90b7-c32a0e603d51

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status
		lineageTag: d630d747-d662-5289-b211-4d6fe5eefcdc

	column Desde
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Desde
		lineageTag: 82bc46c8-d260-56ca-ae48-fa409afe4f75

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 69eb2067-0be4-51a5-84ca-f13f3d9bfc42

	column Pessoa
		dataType: string
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: 087e53d0-ab14-5e6e-8004-c028c8cb0a6b

	partition Eventos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "eventos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Tramitação", type text}, {"Status", type text}, {"Desde", type date}, {"Mês", type date}, {"Pessoa", type text}}, "pt-BR")
				in
				    Tipos
