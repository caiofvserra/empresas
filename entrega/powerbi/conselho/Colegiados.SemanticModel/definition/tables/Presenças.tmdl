/// Guarda, em cada sessão ordinária, cada conselheiro do colegiado e se esteve presente (pela ata).
table 'Presenças'
	isHidden
	lineageTag: 45ede69e-071f-51f0-a460-45468eec15fb

	column 'Sessão'
		dataType: string
		summarizeBy: none
		sourceColumn: Sessão
		lineageTag: f1d2c929-670f-5ff3-b63b-2cd1bdb5506a

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
		lineageTag: ae0c8181-1fee-5dd7-a1a0-0bf921a8b06a

	column Colegiado
		dataType: string
		summarizeBy: none
		sourceColumn: Colegiado
		lineageTag: aa598e5a-67d2-58dc-b368-ce22a45b7c4b

	column Pessoa
		dataType: string
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: 883475c4-df11-5f7e-8ffa-576cb8193503

	column Presente
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Presente
		lineageTag: 3a13cc7f-9c66-54f9-8cba-a0e72b654590

	partition 'Presenças' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "presencas.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Sessão", type text}, {"Data", type date}, {"Colegiado", type text}, {"Pessoa", type text}, {"Presente", Int64.Type}}, "pt-BR")
				in
				    Tipos
