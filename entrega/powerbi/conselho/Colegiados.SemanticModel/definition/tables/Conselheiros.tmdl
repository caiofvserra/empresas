/// Guarda cada mandato de cada cadeira: três anos, de janeiro a dezembro, com um terço renovado por ano. O reeleito aparece num mandato novo com a mesma pessoa. Está em exercício quem tem mandato em curso, de organização já registrada.
table Conselheiros
	lineageTag: 8c84ce12-1139-5020-951c-c99a2e29f2f5

	column Mandato
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Mandato
		lineageTag: 4efab50b-9f43-5009-96d5-87a36e74c1c8

	column Pessoa
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: 4630e8ca-5aa6-5a98-a0de-aeb2006c5a57

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: 06f0f786-4c55-5f40-a15e-e46e7428beef

	column 'Gênero'
		dataType: string
		summarizeBy: none
		sourceColumn: Gênero
		lineageTag: f6a38d1c-1064-55a2-8faf-ce648fc01229

	column 'Câmara'
		dataType: string
		summarizeBy: none
		sourceColumn: Câmara
		lineageTag: d42dd0dd-3c64-5103-afe8-898564c2b59c

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: aa24eaf1-9004-50d7-9f59-07e9a978606a

	column Sigla
		dataType: string
		summarizeBy: none
		sourceColumn: Sigla
		lineageTag: a99b5503-d90d-5941-b4f1-250bda3f5560

	column Natureza
		dataType: string
		summarizeBy: none
		sourceColumn: Natureza
		lineageTag: fd6e0d65-8525-5fb3-9e30-8d5df728fb08

	column 'Terço'
		dataType: string
		summarizeBy: none
		sourceColumn: Terço
		lineageTag: cd8e621c-79dc-54ae-bbee-4db400a606cf

	column 'Início'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Início
		lineageTag: 33089148-7efa-529e-bf32-9ef07016a6e1

	column Fim
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Fim
		lineageTag: 341a7d75-00e5-5177-bf79-0e7d4705886a

	column 'Organização registrada em'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Organização registrada em
		lineageTag: be462623-41fe-5749-8d67-78db73537188

	partition Conselheiros = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "conselheiros.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mandato", type text}, {"Pessoa", type text}, {"Nome", type text}, {"Gênero", type text}, {"Câmara", type text}, {"Organização", type text}, {"Sigla", type text}, {"Natureza", type text}, {"Terço", type text}, {"Início", type date}, {"Fim", type date}, {"Organização registrada em", type date}}, "pt-BR")
				in
				    Tipos
