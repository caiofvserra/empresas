/// Tem os fornecedores do Conselho, pela razão social. No cenário, os nomes são fictícios e terminam com "(demonstrativo)".
table Fornecedores
	lineageTag: c8d3da28-b88a-5d0a-8982-6650fab3da17

	column Fornecedor
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Fornecedor
		lineageTag: f79073ac-05bb-562e-b167-38f48366fb1d

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: b5b421ae-0216-513c-85b7-8916738dae1b

	column Objeto
		dataType: string
		summarizeBy: none
		sourceColumn: Objeto
		lineageTag: e6f062c2-9f43-53a8-a0d3-4bca5309ae0b

	column Natureza
		dataType: string
		summarizeBy: none
		sourceColumn: Natureza
		lineageTag: 8924799d-afb9-557f-b1b1-0835447cd7e4

	partition Fornecedores = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "fornecedores.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Fornecedor", type text}, {"Nome", type text}, {"Objeto", type text}, {"Natureza", type text}}, "pt-BR")
				in
				    Tipos
