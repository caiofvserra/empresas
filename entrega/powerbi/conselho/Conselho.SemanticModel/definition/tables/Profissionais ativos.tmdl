/// Conta os profissionais com registro ativo no último dia de cada mês, por município onde moram.
table 'Profissionais ativos'
	isHidden
	lineageTag: 544549ac-8e12-538a-b24c-b8045496d587

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
		lineageTag: b377b013-bdbc-54f5-b998-35bb50444252

	column 'Código IBGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: 4c6b27f3-a55d-5601-b77f-a2bbbeb9ba80

	column Ativos
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Ativos
		lineageTag: f70ec7a3-c1a6-5569-ad43-4a8b3a5c3926

	partition 'Profissionais ativos' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "profissionais-ativos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Data", type date}, {"Código IBGE", type text}, {"Ativos", Int64.Type}}, "pt-BR")
				in
				    Tipos
