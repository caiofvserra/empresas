/// Guarda os convênios, contratos e patrocínios com as organizações, com a vigência e o valor.
table Repasses
	lineageTag: 0df1a053-364f-55d5-af90-5cabf86e8358

	column Repasse
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Repasse
		lineageTag: 60978787-375d-5a85-bdd5-ac9fe09aa33c

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: 1a10080c-7cf0-522e-a347-1d94f48b36af

	column Canal
		dataType: string
		summarizeBy: none
		sourceColumn: Canal
		lineageTag: 0bac164b-0191-54b5-8fb8-abc3e4886238

	column Objeto
		dataType: string
		summarizeBy: none
		sourceColumn: Objeto
		lineageTag: a3fd10bd-9bc4-5f63-bbcb-77b5f931d9d4

	column 'Início'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Início
		lineageTag: 578a8813-ac98-559d-96bf-b8abba7896a6

	column Fim
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Fim
		lineageTag: ce3e2dd0-b5bc-5c26-9e17-346887c9215f

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 016e0dca-d572-5ec8-a117-a04205be9b99

	partition Repasses = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "repasses.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Repasse", type text}, {"Organização", type text}, {"Canal", type text}, {"Objeto", type text}, {"Início", type date}, {"Fim", type date}, {"Valor", type number}}, "pt-BR")
				in
				    Tipos
