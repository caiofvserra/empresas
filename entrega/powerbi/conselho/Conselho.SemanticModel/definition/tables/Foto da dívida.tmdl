/// Guarda a dívida de anuidade no último dia de cada mês: uma linha por devedor e idade da anuidade, com o valor vencido e não pago, se o devedor está acima do piso de execução, a parte perto de prescrever e, nas empresas, a situação do CNPJ na Receita Federal.
table 'Foto da dívida'
	lineageTag: d6f19a55-dad5-545f-abf8-24adf269736e

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Data
		lineageTag: 524be58e-6ff5-5ee4-8e79-24f61da64f83

	column Devedor
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Devedor
		lineageTag: 8131b781-06e2-528f-8899-68e94d3f824a

	column 'Tipo de devedor'
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo de devedor
		lineageTag: cd12c610-952b-50fa-8241-cb98267298db

	column 'Código IBGE'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: 852fb18c-3e97-5916-a326-32340c051183

	column 'Idade da anuidade'
		dataType: string
		summarizeBy: none
		sourceColumn: Idade da anuidade
		sortByColumn: 'Ordem da idade'
		lineageTag: bad56cd5-da90-5d13-b38b-31dd0f7db552

	column 'Ordem da idade'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem da idade
		lineageTag: 93f55edd-cb3a-560b-ade6-84753cc4db10

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 2ff77704-c3ad-5352-aabb-2e3cfb9bdd57

	column 'Acima do piso'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Acima do piso
		lineageTag: de9bd8a9-d193-58b3-9021-bcb142bca3ae

	column 'Perto de prescrever'
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Perto de prescrever
		lineageTag: b969cf7a-c683-5ea4-a304-c3428325971d

	column 'Situação do CNPJ'
		dataType: string
		summarizeBy: none
		sourceColumn: Situação do CNPJ
		lineageTag: eb6cb4d7-615a-5955-a310-388f71958222

	partition 'Foto da dívida' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "foto-divida.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Data", type date}, {"Devedor", type text}, {"Tipo de devedor", type text}, {"Código IBGE", type text}, {"Idade da anuidade", type text}, {"Ordem da idade", Int64.Type}, {"Valor", type number}, {"Acima do piso", Int64.Type}, {"Perto de prescrever", type number}, {"Situação do CNPJ", type text}}, "pt-BR")
				in
				    Tipos
