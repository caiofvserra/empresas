/// Tem as entidades de classe e as instituições de ensino registradas no Crea-SP.
table 'Organizações'
	lineageTag: f0ad315e-d264-5f94-8f93-0976e135f34d

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: 54d6190f-2f93-51ed-9b38-b317fc7dc590

	column Sigla
		dataType: string
		summarizeBy: none
		sourceColumn: Sigla
		lineageTag: 84ed1ce9-c427-53e7-b6e4-2b81f6c02b36

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: 897c5b88-6fb6-59e2-a32c-7080c7597ea1

	column Natureza
		dataType: string
		summarizeBy: none
		sourceColumn: Natureza
		lineageTag: ee21de6b-03f5-5d71-959f-d2f3409f3c66

	partition 'Organizações' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "organizacoes.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Organização", type text}, {"Sigla", type text}, {"Nome", type text}, {"Natureza", type text}}, "pt-BR")
				in
				    Tipos
