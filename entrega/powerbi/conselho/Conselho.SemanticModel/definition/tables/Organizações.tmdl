/// Tem as entidades de classe e as instituições de ensino registradas no Crea-SP, com a natureza, o município e as cadeiras no plenário.
table 'Organizações'
	lineageTag: f0ad315e-d264-5f94-8f93-0976e135f34d

	column 'Organização'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Organização
		lineageTag: 54d6190f-2f93-51ed-9b38-b317fc7dc590

	column Sigla
		dataType: string
		summarizeBy: none
		sourceColumn: Sigla
		lineageTag: 84ed1ce9-c427-53e7-b6e4-2b81f6c02b36

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: 897c5b88-6fb6-59e2-a32c-7080c7597ea1

	column Natureza
		dataType: string
		summarizeBy: none
		sourceColumn: Natureza
		lineageTag: ee21de6b-03f5-5d71-959f-d2f3409f3c66

	column Tipo
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo
		lineageTag: baaf6287-6e8c-5bad-9813-850fa92df5ae

	column 'Código IBGE'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: 5d491f39-f6a5-5a6f-9fd2-f561eb3b75a2

	column 'Registrada em'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Registrada em
		lineageTag: d01ec751-4411-512f-bfc4-c18976cc364e

	column Cadeiras
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Cadeiras
		lineageTag: 7918618d-aa03-5fab-b598-3d854caa452c

	column 'Ensino a distância'
		dataType: double
		formatString: 0%
		isHidden
		summarizeBy: none
		sourceColumn: Ensino a distância
		lineageTag: 9cdf684d-97e2-557f-a881-0de5cdd75a14

	partition 'Organizações' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "organizacoes.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Organização", type text}, {"Sigla", type text}, {"Nome", type text}, {"Natureza", type text}, {"Tipo", type text}, {"Código IBGE", type text}, {"Registrada em", type date}, {"Cadeiras", Int64.Type}, {"Ensino a distância", type number}}, "pt-BR")
				in
				    Tipos
