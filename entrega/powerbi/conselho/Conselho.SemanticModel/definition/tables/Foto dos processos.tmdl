/// Guarda, no último dia de cada mês, os processos em julgamento (com a fase, o tempo de espera e o prazo da prescrição) e os que têm recurso esperando o plenário.
table 'Foto dos processos'
	lineageTag: b9108ffc-7f30-5d0e-b31a-f8a468f92c17

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Data
		lineageTag: 9b44df73-c179-5b59-8b5f-748b9fde4796

	column Processo
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Processo
		lineageTag: 349a55dd-ddde-567b-84f5-52d5987f232c

	column Fase
		dataType: string
		summarizeBy: none
		sourceColumn: Fase
		lineageTag: 823d7212-fbd2-5780-ad41-44ea6584086f

	column 'Tempo em julgamento'
		dataType: string
		summarizeBy: none
		sourceColumn: Tempo em julgamento
		sortByColumn: 'Ordem do tempo'
		lineageTag: 463d0390-ea39-559e-9b1f-2f18a8c7d003

	column 'Ordem do tempo'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem do tempo
		lineageTag: 28bdc156-5475-51dc-a038-c4fed6b5e457

	column 'Prazo da prescrição'
		dataType: string
		summarizeBy: none
		sourceColumn: Prazo da prescrição
		sortByColumn: 'Ordem do prazo'
		lineageTag: f56ae4cb-8b25-55e5-bab1-a6d37a17d490

	column 'Ordem do prazo'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem do prazo
		lineageTag: 7ae9103b-f99c-5441-a111-bcc307cfef9a

	column 'Prescreve em até 12 meses'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Prescreve em até 12 meses
		lineageTag: bb9265dc-5e7c-52be-bdc2-dc9453aa2d0f

	column 'Recurso esperando o plenário'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Recurso esperando o plenário
		lineageTag: 065a1356-e754-5418-b609-c6ae055baa7b

	partition 'Foto dos processos' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "foto-processos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Data", type date}, {"Processo", type text}, {"Fase", type text}, {"Tempo em julgamento", type text}, {"Ordem do tempo", Int64.Type}, {"Prazo da prescrição", type text}, {"Ordem do prazo", Int64.Type}, {"Prescreve em até 12 meses", Int64.Type}, {"Recurso esperando o plenário", Int64.Type}}, "pt-BR")
				in
				    Tipos
