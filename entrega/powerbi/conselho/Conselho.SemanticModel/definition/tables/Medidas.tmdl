			RETURN DIVIDE([Profissionais ativos da câmara], CALCULATE(SUM('Foto das câmaras'[Profissionais ativos]), 'Foto das câmaras'[Data] = d, REMOVEFILTERS('Foto das câmaras'[Câmara])))
