	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Processos por conselheiro' = ```
			VAR t = TOPN(1, ADDCOLUMNS(CALCULATETABLE(VALUES('Pessoas'[Nome]), 'Pessoas'[Papel] = "Conselheiro"), "N", [Processos na fila]), [N], DESC, 'Pessoas'[Nome], ASC)
			RETURN IF(MAXX(t, [N]) > 0, "o maior: " & MAXX(t, 'Pessoas'[Nome]) & ", com " & FORMAT(MAXX(t, [N]), "#,##0"), "nenhum processo com conselheiro")
