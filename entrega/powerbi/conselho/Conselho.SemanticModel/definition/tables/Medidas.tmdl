		lineageTag: c50dcd5d-979d-5017-ab44-62d50b7b04ea

	/// Conta os processos em que o relator se declarou impedido no período: o processo volta à distribuição.
	measure Impedimentos = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Eventos'[Tramitação]), 'Eventos'[Desde] >= inicio, 'Eventos'[Desde] <= d, KEEPFILTERS('Eventos'[Status] = "Impedimento")) + 0
			```
		formatString: #,##0
