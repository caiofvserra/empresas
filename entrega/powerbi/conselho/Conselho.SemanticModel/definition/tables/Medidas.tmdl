			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(SUM('Foto das câmaras'[Cadeiras]), 'Foto das câmaras'[Data] = d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Foto das câmaras'[Câmara] = c))
