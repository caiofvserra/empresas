/// Guarda as medidas do painel de Gestão do Conselho, em pastas por página.
table Medidas
	lineageTag: c84979f2-3c69-5cdc-a34b-651ad696a977

	/// Devolve a data de referência escolhida; sem escolha, a mais recente. As medidas de variação trocam a data pela de um ano antes.
	measure 'Data escolhida' = IF(ISFILTERED('Datas das fotos'[Data]), MAX('Datas das fotos'[Data]), MAX('Datas de referência'[Data]))
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: c11bd1bf-549f-587d-85e0-a447c84979f8

	/// Devolve o período escolhido, em meses; sem escolha, 12.
	measure 'Meses do período' = SELECTEDVALUE('Período'[Meses], 12)
		formatString: 0
		displayFolder: Apoio
		lineageTag: bc947c67-db06-5759-8e01-167f28638c6c

	/// Devolve o primeiro dia do primeiro mês do período: o período termina na data escolhida e começa no primeiro dia do mês, como no painel.
	measure 'Início do período' = ```
			VAR d = [Data escolhida]
			RETURN DATE(YEAR(d), MONTH(d) - [Meses do período] + 1, 1)
			```
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 5d427e01-5534-5783-80c3-7f69e9c6259c

	/// Cinco vezes a anuidade de pessoa física do ano da data escolhida (Lei 12.514/2011, art. 8º, com a redação da Lei 14.195/2021). Abaixo dele, o Conselho não pode executar a dívida na Justiça. A anuidade do cenário é demonstrativa.
	measure 'Piso de execução' = ```
			VAR d = [Data escolhida]
			RETURN 5 * ROUND(520 * POWER(1.055, MAX(0, YEAR(d) - 2020)), 0)
			```
		formatString: R$ #,##0
		displayFolder: Apoio
		lineageTag: 3fbb586a-cafb-5074-b440-e7f202da4631

	/// A meta padrão de solicitações resolvidas no prazo é 80%, a mesma do painel.
	measure 'Meta de resolução no prazo' = 0.8
		formatString: 0.0%
		displayFolder: Apoio
		lineageTag: 98d1d59d-f920-546b-ac0f-5c05096973c6

	/// Soma a receita realizada no período, de anuidades, ARTs, multas e outras origens.
	measure 'Receita do Conselho' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Receitas'[Realizada]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= inicio, 'Receitas'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 5521943a-aea4-5648-95f5-d5a2182b048b

	/// Soma a receita realizada em cada mês, nos meses do gráfico.
	measure 'Receita no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(SUM('Receitas'[Realizada]), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: bc3addbb-6aba-54ed-acd8-21533e384da8

	/// Soma a receita realizada no mesmo mês um ano antes, para comparar.
	measure 'Receita no mesmo mês do ano anterior' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(SUM('Receitas'[Realizada]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] = EDATE(mes, -12)), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 2bf44d1b-2989-5479-9fa1-f5c301985fcc

	/// Soma a receita prevista de janeiro até cada mês do ano da data escolhida, até o mês dela.
	measure 'Receita prevista acumulada no ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d)
			RETURN IF(m <= MONTH(d), CALCULATE(SUM('Receitas'[Prevista]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(ano, 1, 1), 'Receitas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 9cd65212-c9ba-5888-a3f5-9b6a2dd662cb

	/// Soma a receita realizada de janeiro até cada mês do ano da data escolhida, até o mês dela.
	measure 'Receita realizada acumulada no ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d)
			RETURN IF(m <= MONTH(d), CALCULATE(SUM('Receitas'[Realizada]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(ano, 1, 1), 'Receitas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: b5d087bb-b4da-5cf1-92f5-6d83e5a408d0

	/// Soma a receita realizada de janeiro até cada mês do ano anterior ao da data escolhida.
	measure 'Receita realizada acumulada no ano anterior' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d) - 1
			RETURN IF(TRUE(), CALCULATE(SUM('Receitas'[Realizada]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(ano, 1, 1), 'Receitas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: af780ed1-f5c4-5373-9119-fc79fc9ceb28

	/// Soma as anuidades de profissionais e os boletos de empresas vencidos e não pagos na data escolhida, até cinco anos depois do vencimento (depois disso, prescrevem).
	measure 'Anuidades vencidas' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: d06cb7dc-d84d-5706-b5c0-638456cd767b

	/// Conta os profissionais e as empresas com anuidade vencida e não paga na data escolhida.
	measure 'Devedores de anuidade' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(DISTINCTCOUNT('Foto da dívida'[Devedor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Receita
		lineageTag: f0f3d1b4-41ff-58d6-bc33-459cb92a3209

	/// Soma as anuidades vencidas de profissionais na data escolhida.
	measure 'Anuidades vencidas de profissionais' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Tipo de devedor] = "Profissional"))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 8d604712-dc94-5bb8-b7e1-dbcac473214b

	/// Soma os boletos vencidos de empresas na data escolhida. Com a situação do CNPJ na Receita Federal, mostra quanto é de empresa baixada ou inapta, com pouca chance de ser recebido.
	measure 'Anuidades vencidas de empresas' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Tipo de devedor] = "Empresa"))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 006dfc89-ef03-5d77-9b6d-ce61c427442a

	/// Soma a dívida dos devedores que, somando todas as anuidades vencidas, ficam abaixo do piso de execução.
	measure 'Vencidas abaixo do piso' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Acima do piso] = 0))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: d77fa24c-5b95-5f2e-adc5-e5e4c8a43b3d

	/// Soma a dívida dos devedores que somam o piso de execução ou mais.
	measure 'Vencidas acima do piso' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Acima do piso] = 1))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 4f8d0341-21bc-519b-a06a-13798f37da3e

	/// Mostra a parte da dívida que é de devedores abaixo do piso de execução: só pode ser cobrada fora da Justiça.
	measure 'Abaixo do piso de execução' = DIVIDE([Vencidas abaixo do piso], [Anuidades vencidas])
		formatString: 0.0%
		displayFolder: Receita
		lineageTag: db7e13f1-ad5e-5a7f-828f-02f9cf45edb2

	/// Soma as anuidades vencidas há mais de quatro anos na data escolhida: prescrevem em menos de um ano (Código Tributário Nacional, art. 174).
	measure 'Perto de prescrever' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Perto de prescrever]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 33aeac17-68b1-5a25-ace2-921f916e44b6

	/// Conta os devedores com ao menos uma anuidade vencida há mais de quatro anos.
	measure 'Devedores perto de prescrever' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(DISTINCTCOUNT('Foto da dívida'[Devedor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Perto de prescrever] > 0))
			```
		formatString: #,##0
		displayFolder: Receita
		lineageTag: 3dc46c84-4f7b-59e2-8dfb-be3c79dde76d

	/// Soma a dívida vencida e não paga no dia anterior ao início do período.
	measure 'Dívida no início do período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR x = inicio - 1
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Vencimento] < x, 'Títulos'[Vencimento] >= x - 1826, ISBLANK('Títulos'[Pago em]) || 'Títulos'[Pago em] > x) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: b49e46a1-7ab4-5db7-ac95-e749448e6088

	/// Soma as anuidades e os boletos que venceram no período sem ser pagos no vencimento.
	measure 'Novos vencimentos no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Vencimento] >= inicio - 1, 'Títulos'[Vencimento] < d, FILTER('Títulos', ISBLANK('Títulos'[Pago em]) || 'Títulos'[Pago em] > 'Títulos'[Vencimento])) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 3bf15ba6-ec63-5c30-8112-1b3e7a67e509

	/// Soma o que foi pago no período depois do vencimento, antes da prescrição.
	measure 'Recebido da dívida no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Pago em] >= inicio, 'Títulos'[Pago em] <= d, 'Títulos'[Dias até o pagamento] > 0, 'Títulos'[Dias até o pagamento] <= 1826) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 551eacf9-3d38-58bf-87c8-aea118c46a90

	/// Soma a dívida que completou cinco anos do vencimento no período sem ser paga: prescreveu.
	measure 'Prescrito no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Vencimento] >= inicio - 1 - 1826, 'Títulos'[Vencimento] < d - 1826, ISBLANK('Títulos'[Pago em]) || 'Títulos'[Pago em] > d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 2ae57059-0534-52a3-94d4-4b311755d7a6

	/// Mostra quanto do que estava vencido no início do período, mais o que venceu nele, foi recebido no período.
	measure 'Recebido da dívida' = DIVIDE([Recebido da dívida no período], [Dívida no início do período] + [Novos vencimentos no período])
		formatString: 0.0%
		displayFolder: Receita
		lineageTag: 0ccea29c-1dc8-5e6a-8c59-35a40d7a974b

	/// Soma a despesa realizada nos 12 meses até o mês da data escolhida. Com uma regional escolhida, só a despesa lançada nela, sem a sede.
	measure 'Despesa em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Despesas'[Realizado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= inicio, 'Despesas'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 47475d32-fc4e-5e7c-8a7d-f5cac6232563

	/// Soma a despesa orçada nos 12 meses até o mês da data escolhida.
	measure 'Orçado em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Despesas'[Orçado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= inicio, 'Despesas'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: db5faecb-002e-59d1-9292-2393316302ec

	/// Soma a despesa de fiscalização, atendimento e ações institucionais nos 12 meses.
	measure 'Despesa em atividades-fim em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Despesas'[Realizado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= inicio, 'Despesas'[Mês] <= d, 'Despesas'[Atividade] = "Atividade-fim") + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 76ee6c47-4c24-54d5-82fa-b35f0d6a8cfe

	/// Mostra a parte da despesa dos 12 meses que foi para as atividades-fim: fiscalização, atendimento e ações institucionais.
	measure 'Em atividades-fim' = DIVIDE([Despesa em atividades-fim em 12 meses], [Despesa em 12 meses])
		formatString: 0.0%
		displayFolder: Orçamento e despesa
		lineageTag: 5eb76d26-1742-5cd8-8a3d-103ee81fcadb

	/// Soma a despesa de fiscalização lançada em cada GRE nos 12 meses (sem a sede).
	measure 'Despesa de fiscalização em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Despesas'[Realizado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= inicio, 'Despesas'[Mês] <= d, 'Despesas'[Função] = "Fiscalização", 'Despesas'[GRE] <> "") + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 33736ea4-b18d-5efa-a4d1-810c567d2e35

	/// Soma a despesa realizada até a data escolhida, no mês ou ano do gráfico.
	measure 'Despesa realizada' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Despesas'[Realizado]), 'Despesas'[Mês] <= d)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 9938bbf9-d252-508f-8830-87e101c9adb0

	/// Soma a despesa realizada de janeiro até o mês da data escolhida.
	measure 'Despesa realizada no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Despesas'[Realizado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(YEAR(d), 1, 1), 'Despesas'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: b6932db8-f704-5e0a-9fd9-19b03b7b6633

	/// Soma a despesa orçada de janeiro até o mês da data escolhida.
	measure 'Despesa orçada no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Despesas'[Orçado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(YEAR(d), 1, 1), 'Despesas'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 27247985-b379-5997-a5a3-df0d0634623c

	/// Mostra quanto da despesa orçada de janeiro até o mês da data escolhida foi realizada.
	measure 'Execução do orçamento no ano' = DIVIDE([Despesa realizada no ano], [Despesa orçada no ano])
		formatString: 0.0%
		displayFolder: Orçamento e despesa
		lineageTag: 82ca138c-fde5-5d96-9220-45649e22b95f

	/// Soma a despesa orçada de janeiro até cada mês do ano da data escolhida, até o mês dela.
	measure 'Despesa orçada acumulada no ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d)
			RETURN IF(m <= MONTH(d), CALCULATE(SUM('Despesas'[Orçado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: c1feb2d6-d91a-5a2c-8629-a89e056de453

	/// Soma a despesa realizada de janeiro até cada mês do ano da data escolhida, até o mês dela.
	measure 'Despesa realizada acumulada no ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d)
			RETURN IF(m <= MONTH(d), CALCULATE(SUM('Despesas'[Realizado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 072f3bb7-251d-592d-8990-f64fe11ce4d0

	/// Soma a despesa realizada de janeiro até cada mês do ano anterior ao da data escolhida.
	measure 'Despesa realizada acumulada no ano anterior' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d) - 1
			RETURN IF(TRUE(), CALCULATE(SUM('Despesas'[Realizado]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 226bbd35-01d2-5657-8d20-21ed3555bf28

	/// Soma o valor das diárias pagas nos 12 meses até o mês da data escolhida. Com uma regional escolhida, só as lançadas nela.
	measure 'Diárias e passagens' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Diárias'[Valor]), REMOVEFILTERS('Calendário'), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: fec31ebc-2f1b-5e3e-8404-fca4e6243ad5

	/// Conta as diárias pagas nos 12 meses.
	measure 'Diárias pagas em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Diárias'[Diárias]), REMOVEFILTERS('Calendário'), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: c2c8a5d6-24a0-5698-8a36-c8cec14e1edf

	/// Soma os quilômetros rodados nas viagens com diária nos 12 meses.
	measure 'Quilômetros em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Diárias'[Quilômetros]), REMOVEFILTERS('Calendário'), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 561eab36-4160-5b0c-832d-182e3aea2e47

	/// Conta os meses dos 12 em que a pessoa recebeu diária.
	measure 'Meses com diária' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Mês]), REMOVEFILTERS('Calendário'), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= d)
			```
		formatString: 0
		displayFolder: Orçamento e despesa
		lineageTag: 98106e81-6ad7-5e3f-8b05-ab79170618ea

	/// Conta os contratos em vigor na data escolhida.
	measure 'Contratos vigentes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Contratos'), 'Contratos'[Início] <= d, 'Contratos'[Fim] >= d) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 524a87e1-4273-51b3-a961-6199bb14ddde

	/// Soma o valor dos contratos em vigor na data escolhida.
	measure 'Valor dos contratos vigentes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Contratos'[Valor]), 'Contratos'[Início] <= d, 'Contratos'[Fim] >= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 71bc5b99-d3f8-5cff-a3a8-55017331761e

	/// Conta os contratos vigentes que terminam nos 90 dias seguintes à data escolhida.
	measure 'Contratos que terminam em 90 dias' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Contratos'), 'Contratos'[Início] <= d, 'Contratos'[Fim] >= d, 'Contratos'[Fim] <= d + 90) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: e7bb2fa0-bf44-591a-9400-c4b8877eda5d

	/// Conta os contratos vigentes na data escolhida que terminam em cada um dos 12 meses seguintes, a começar pelo mês dela.
	measure 'Contratos que terminam no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR primeiro = DATE(YEAR(d), MONTH(d), 1)
			RETURN IF(mes >= primeiro && mes <= EDATE(primeiro, 11), CALCULATE(COUNTROWS('Contratos'), 'Contratos'[Início] <= d, 'Contratos'[Fim] >= d, 'Contratos'[Fim] >= mes, 'Contratos'[Fim] <= EOMONTH(mes, 0)) + 0)
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 0a9239ed-164f-580b-ad80-7ad5efe4c2c0

	/// Soma o valor empenhado nos 12 meses até o mês da data escolhida.
	measure 'Empenhado em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Empenhos'[Valor]), REMOVEFILTERS('Calendário'), 'Empenhos'[Mês] >= inicio, 'Empenhos'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 620cb172-dc35-599c-8b47-9e4a07443c4f

	/// Soma o valor pago dos empenhos dos 12 meses.
	measure 'Pago em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - 11, 1)
			RETURN CALCULATE(SUM('Empenhos'[Pago]), REMOVEFILTERS('Calendário'), 'Empenhos'[Mês] >= inicio, 'Empenhos'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: a6bba436-2654-5844-867a-744eece1bf5d

	/// Conta os servidores efetivos. Com uma regional escolhida, só os lotados nela.
	measure 'Servidores efetivos' = IF(ISCROSSFILTERED('Regionais'), CALCULATE(COUNTROWS('Pessoas'), 'Pessoas'[Tipo] = "Servidor", 'Pessoas'[Vínculo] = "Efetivo", TREATAS(VALUES('Regionais'[GRE]), 'Pessoas'[Lotação])), CALCULATE(COUNTROWS('Pessoas'), 'Pessoas'[Tipo] = "Servidor", 'Pessoas'[Vínculo] = "Efetivo"))
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 26f711e0-2b17-5dd6-a26f-6e18f54e7381

	/// Conta os servidores comissionados. Com uma regional escolhida, só os lotados nela.
	measure 'Servidores comissionados' = IF(ISCROSSFILTERED('Regionais'), CALCULATE(COUNTROWS('Pessoas'), 'Pessoas'[Tipo] = "Servidor", 'Pessoas'[Vínculo] = "Comissionado", TREATAS(VALUES('Regionais'[GRE]), 'Pessoas'[Lotação])), CALCULATE(COUNTROWS('Pessoas'), 'Pessoas'[Tipo] = "Servidor", 'Pessoas'[Vínculo] = "Comissionado"))
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 0267bf9e-b91a-5be8-87ed-96568fa974f1

	/// Soma o custo mensal dos postos (salário e encargos). Com uma regional escolhida, só os lotados nela.
	measure 'Custo mensal do pessoal' = IF(ISCROSSFILTERED('Regionais'), CALCULATE(SUM('Pessoas'[Custo mensal]), 'Pessoas'[Tipo] = "Servidor", TREATAS(VALUES('Regionais'[GRE]), 'Pessoas'[Lotação])), CALCULATE(SUM('Pessoas'[Custo mensal]), 'Pessoas'[Tipo] = "Servidor"))
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 645cd245-51ea-509f-adbe-c88d3d8c49c4

	/// Conta os processos que já entraram nas câmaras e ainda não foram julgados na data escolhida.
	measure 'Processos em julgamento' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos processos'), REMOVEFILTERS('Calendário'), 'Foto dos processos'[Data] = d, KEEPFILTERS('Foto dos processos'[Fase] <> ""))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: dc31c62a-1aa2-53cc-997b-a76294984263

	/// Conta os processos que entraram nas câmaras no período.
	measure 'Processos que entraram no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Processos'), REMOVEFILTERS('Calendário'), 'Processos'[Entrada] >= inicio, 'Processos'[Entrada] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 5274c0a4-587c-5646-8bc3-caecab88597d

	/// Conta os processos julgados pelas câmaras no período.
	measure 'Julgados no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Processos'), REMOVEFILTERS('Calendário'), 'Processos'[Julgado em] >= inicio, 'Processos'[Julgado em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 88d85d77-c75f-59b1-b5da-d9ef6638edce

	/// Conta os autos de infração julgados no período, pela decisão da câmara.
	measure 'Autos julgados no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Processos'), REMOVEFILTERS('Calendário'), 'Processos'[Julgado em] >= inicio, 'Processos'[Julgado em] <= d, KEEPFILTERS('Processos'[Tipo] = "Auto de infração"))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: a87f3117-1c52-59d1-8e5a-a07fe8734b92

	/// Mostra o tempo típico (a mediana), em dias, da entrada ao julgamento dos processos julgados no período.
	measure 'Tempo até o julgamento' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Processos'[Dias até o julgamento]), REMOVEFILTERS('Calendário'), 'Processos'[Julgado em] >= inicio, 'Processos'[Julgado em] <= d)
			```
		formatString: #,##0" dias"
		displayFolder: Câmaras e plenário
		lineageTag: 9c3b154b-9636-5f5d-a795-ac236753a6b4

	/// Conta os autos de infração sem julgamento que completam cinco anos do fato em até 12 meses (Lei 9.873/1999, art. 1º).
	measure 'Autos perto da prescrição' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos processos'), REMOVEFILTERS('Calendário'), 'Foto dos processos'[Data] = d, KEEPFILTERS('Foto dos processos'[Prescreve em até 12 meses] = 1))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 36ae8705-7106-5387-9be8-1d9d62662ea8

	/// Soma o valor das multas dos autos que prescrevem em até 12 meses.
	measure 'Multas dos autos perto da prescrição' = ```
			VAR d = [Data escolhida]
			RETURN SUMX(CALCULATETABLE('Foto dos processos', REMOVEFILTERS('Calendário'), 'Foto dos processos'[Data] = d, 'Foto dos processos'[Prescreve em até 12 meses] = 1), RELATED('Processos'[Multa])) + 0
			```
		formatString: R$ #,##0
		displayFolder: Câmaras e plenário
		lineageTag: cebd094b-bd49-542d-9b9b-f38370a95c58

	/// Conta os autos arquivados pela prescrição no período.
	measure 'Autos prescritos no período' = CALCULATE([Julgados no período], 'Processos'[Decisão] = "Arquivado pela prescrição")
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 065d72e2-d30c-5b0c-ae3d-907a300aa2bf

	/// Conta os processos em que a parte recorreu da decisão da câmara e o plenário ainda não julgou, na data escolhida.
	measure 'Recursos esperando o plenário' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos processos'), REMOVEFILTERS('Calendário'), 'Foto dos processos'[Data] = d, KEEPFILTERS('Foto dos processos'[Recurso esperando o plenário] = 1))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: af108ce3-c861-5861-953e-627b4011998e

	/// Conta os processos que entraram em cada mês, nos meses do gráfico.
	measure 'Entraram no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(COUNTROWS('Processos') + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 346ef0d8-c21b-5a3a-a12e-43900ce37935

	/// Conta os processos julgados em cada mês, nos meses do gráfico.
	measure 'Julgados no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Processos'), USERELATIONSHIP('Processos'[Mês do julgamento], 'Calendário'[Mês])) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: f6ce9875-c819-587b-bcd4-a19d4b02fa8c

	/// Conta os processos em julgamento no último dia de cada mês (no mês da data escolhida, nela).
	measure 'Em julgamento no fim do mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Foto dos processos'), REMOVEFILTERS('Calendário'), 'Foto dos processos'[Data] = MIN(EOMONTH(mes, 0), d), 'Foto dos processos'[Fase] <> ""), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 9161d469-139b-53d7-b202-a41121153e98

	/// Conta as cadeiras de cada câmara no plenário na data escolhida, pelas modalidades das entidades e escolas que as indicam.
	measure 'Cadeiras da câmara' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto do plenário'[Cadeiras]), REMOVEFILTERS('Calendário'), 'Foto do plenário'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Câmaras e plenário
		lineageTag: 4d21c41e-49f5-50b8-a6e6-f2c66084d2d1

	/// Mostra a parte das cadeiras do plenário que é de cada câmara.
	measure 'Parte das cadeiras' = DIVIDE([Cadeiras da câmara], CALCULATE([Cadeiras da câmara], REMOVEFILTERS('Câmaras')))
		formatString: 0.0%
		displayFolder: Câmaras e plenário
		lineageTag: d4d2bc7d-2b1f-55eb-9867-e3354236220e

	/// Mostra a parte dos profissionais ativos que é da modalidade que cada câmara julga. A Ambiental e Sanitária não tem modalidade própria no cenário.
	measure 'Parte dos profissionais ativos' = ```
			VAR d = [Data escolhida]
			VAR camara = CALCULATE(SUM('Foto do plenário'[Profissionais ativos]), 'Foto do plenário'[Data] = d)
			VAR todas = CALCULATE(SUM('Foto do plenário'[Profissionais ativos]), 'Foto do plenário'[Data] = d, REMOVEFILTERS('Câmaras'))
			RETURN DIVIDE(camara, todas)
			```
		formatString: 0.0%
		displayFolder: Câmaras e plenário
		lineageTag: 28405f70-819e-5b0a-b918-d2a8c516d037

	/// Conta as entidades de classe e as instituições de ensino registradas até a data escolhida.
	measure 'Organizações registradas' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Organizações'), 'Organizações'[Registrada em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Entidades e escolas
		lineageTag: e30dce79-1965-5883-b043-e0118c0869a6

	/// Soma as cadeiras no plenário das organizações registradas até a data escolhida.
	measure 'Cadeiras no plenário' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Organizações'[Cadeiras]), 'Organizações'[Registrada em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Entidades e escolas
		lineageTag: e635c334-3f48-57a6-babf-0dec056b7a27

	/// Soma os pagamentos de convênios, contratos e patrocínios às organizações nos 365 dias até a data escolhida.
	measure 'Repasses em 12 meses' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Pagamentos dos repasses'[Valor]), REMOVEFILTERS('Calendário'), 'Pagamentos dos repasses'[Data] > d - 365, 'Pagamentos dos repasses'[Data] <= d, 'Repasses'[Início] <= d, 'Organizações'[Registrada em] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Entidades e escolas
		lineageTag: 6aaef487-df16-5e2d-a820-3a8f7dd384b0

	/// Soma os pagamentos às organizações nos 365 dias anteriores, para comparar.
	measure 'Repasses nos 12 meses anteriores' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Pagamentos dos repasses'[Valor]), REMOVEFILTERS('Calendário'), 'Pagamentos dos repasses'[Data] > d - 730, 'Pagamentos dos repasses'[Data] <= d - 365, 'Repasses'[Início] <= d, 'Organizações'[Registrada em] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Entidades e escolas
		lineageTag: 2a1a849d-cdfe-52db-b7c7-8c851ff33752

	/// Compara os repasses dos 12 meses com os dos 12 meses anteriores, como o cartão do painel.
	measure 'Variação em um ano: Repasses em 12 meses' = DIVIDE([Repasses em 12 meses] - [Repasses nos 12 meses anteriores], [Repasses nos 12 meses anteriores])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Entidades e escolas
		lineageTag: 26a005a7-7219-501d-865c-d15fa5c561ac

	/// Soma os pagamentos às organizações registradas, no ano do gráfico, até a data escolhida.
	measure 'Repassado no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Pagamentos dos repasses'[Valor]), 'Pagamentos dos repasses'[Data] <= d, 'Organizações'[Registrada em] <= d)
			```
		formatString: R$ #,##0
		displayFolder: Entidades e escolas
		lineageTag: f0f4aba4-37cb-53be-befb-fb9c8ee6ac83

	/// Soma tudo o que foi pago à organização até a data escolhida.
	measure 'Repassado até a data' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Pagamentos dos repasses'[Valor]), REMOVEFILTERS('Calendário'), 'Pagamentos dos repasses'[Data] <= d, 'Repasses'[Início] <= d, 'Organizações'[Registrada em] <= d)
			```
		formatString: R$ #,##0
		displayFolder: Entidades e escolas
		lineageTag: 98df3932-ccfe-5f74-988d-657a73fa5575

	/// Conta os convênios, contratos e patrocínios em vigor na data escolhida.
	measure 'Instrumentos vigentes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Repasses'), 'Repasses'[Início] <= d, 'Repasses'[Fim] >= d, 'Organizações'[Registrada em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Entidades e escolas
		lineageTag: 3d516f51-2657-5c17-ac58-b3d997c91b64

	/// Conta as organizações com ao menos um instrumento em vigor.
	measure 'Organizações com instrumento vigente' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(DISTINCTCOUNT('Repasses'[Organização]), 'Repasses'[Início] <= d, 'Repasses'[Fim] >= d, 'Organizações'[Registrada em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Entidades e escolas
		lineageTag: 18c514f5-76a1-5ae3-a8d5-3f4d78a02d16

	/// Conta as solicitações abertas no período.
	measure 'Solicitações de atendimento' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Solicitações'), REMOVEFILTERS('Calendário'), 'Solicitações'[Aberta em] >= inicio, 'Solicitações'[Aberta em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: b9c485d4-08ee-5a72-9615-1cfcff7942d1

	/// Conta as solicitações do período feitas por empresas.
	measure 'Solicitações de empresas' = CALCULATE([Solicitações de atendimento], 'Solicitações'[Solicitante] = "Empresa")
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: b79f6b9a-db0d-5edc-985f-ebb2b614769d

	/// Conta as solicitações do período resolvidas até a data escolhida, dentro do prazo.
	measure 'Resolvidas no prazo' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN COUNTROWS(FILTER(CALCULATETABLE('Solicitações', REMOVEFILTERS('Calendário'), 'Solicitações'[Aberta em] >= inicio, 'Solicitações'[Aberta em] <= d), NOT ISBLANK('Solicitações'[Resolvida em]) && 'Solicitações'[Resolvida em] <= d && 'Solicitações'[Resolvida em] <= 'Solicitações'[Prazo])) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: 0c21d172-23d8-5a20-a734-915a88bfe1af

	/// Conta as solicitações do período resolvidas depois do prazo.
	measure 'Resolvidas com atraso' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN COUNTROWS(FILTER(CALCULATETABLE('Solicitações', REMOVEFILTERS('Calendário'), 'Solicitações'[Aberta em] >= inicio, 'Solicitações'[Aberta em] <= d), NOT ISBLANK('Solicitações'[Resolvida em]) && 'Solicitações'[Resolvida em] <= d && 'Solicitações'[Resolvida em] > 'Solicitações'[Prazo])) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: 7068d182-5748-5c58-bbe5-a75adb62bf7f

	/// Conta as solicitações do período ainda abertas na data escolhida, com o prazo já vencido.
	measure 'Abertas com prazo vencido' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN COUNTROWS(FILTER(CALCULATETABLE('Solicitações', REMOVEFILTERS('Calendário'), 'Solicitações'[Aberta em] >= inicio, 'Solicitações'[Aberta em] <= d), NOT (NOT ISBLANK('Solicitações'[Resolvida em]) && 'Solicitações'[Resolvida em] <= d) && 'Solicitações'[Prazo] < d)) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: 2e33dc10-7331-5056-8679-2a78c1fdbb51

	/// Conta as solicitações do período ainda abertas, dentro do prazo.
	measure 'Abertas no prazo' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN COUNTROWS(FILTER(CALCULATETABLE('Solicitações', REMOVEFILTERS('Calendário'), 'Solicitações'[Aberta em] >= inicio, 'Solicitações'[Aberta em] <= d), NOT (NOT ISBLANK('Solicitações'[Resolvida em]) && 'Solicitações'[Resolvida em] <= d) && 'Solicitações'[Prazo] >= d)) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: e0c2e7a8-3df6-5c12-9bdd-c710f38d1edb

	/// Mostra a parte das solicitações do período resolvidas no prazo, entre as resolvidas e as que já passaram do prazo. As abertas ainda no prazo ficam de fora.
	measure 'Solicitações resolvidas no prazo' = DIVIDE([Resolvidas no prazo], [Resolvidas no prazo] + [Resolvidas com atraso] + [Abertas com prazo vencido])
		formatString: 0.0%
		displayFolder: Atendimento
		lineageTag: f1f986b2-04a5-53b8-90bc-562a7eb55f49

	/// Mostra o tempo típico (a mediana), em dias, da abertura à resolução das solicitações do período resolvidas até a data escolhida.
	measure 'Tempo de resolução' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Solicitações'[Dias até resolver]), REMOVEFILTERS('Calendário'), 'Solicitações'[Aberta em] >= inicio, 'Solicitações'[Aberta em] <= d, 'Solicitações'[Resolvida em] <= d)
			```
		formatString: #,##0" dias"
		displayFolder: Atendimento
		lineageTag: f181fa20-a4a8-562e-b964-4a784872b543

	/// Conta as solicitações abertas em cada mês, nos meses do gráfico.
	measure 'Solicitações no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(COUNTROWS('Solicitações') + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: c7ba0ea2-1906-583c-9e40-83ba32795aff

	/// Conta os profissionais com registro ativo na data escolhida, pelo município onde moram.
	measure 'Profissionais ativos' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Profissionais ativos'[Ativos]), REMOVEFILTERS('Calendário'), 'Profissionais ativos'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: 2a27bfee-8768-5b8c-925f-25b646a0d05d

	/// Conta os profissionais ativos que moram a mais de 50 km, em linha reta, da unidade de atendimento mais próxima.
	measure 'Ativos a mais de 50 km' = CALCULATE([Profissionais ativos], 'Municípios'[Distância até a unidade (km)] > 50)
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: 1c222d90-e241-5d06-8bbe-aad89662b87b

	/// Mostra a parte dos profissionais ativos que moram a mais de 50 km, em linha reta, da unidade mais próxima. Pela estrada, a distância costuma ser de 20% a 40% maior.
	measure 'Moram a mais de 50 km de uma unidade' = DIVIDE([Ativos a mais de 50 km], [Profissionais ativos])
		formatString: 0.0%
		displayFolder: Atendimento
		lineageTag: fb11799e-d419-5e7c-b9f6-31e6f7248c71

	/// Soma as horas de mesa disponíveis nos coworkings no período.
	measure 'Horas disponíveis no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Meses dos coworkings'[Horas disponíveis]), REMOVEFILTERS('Calendário'), 'Meses dos coworkings'[Mês] >= inicio, 'Meses dos coworkings'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: 5a6f7894-1916-564a-8f79-597cd49afe9b

	/// Soma as horas de mesa usadas nos coworkings no período.
	measure 'Horas usadas no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Meses dos coworkings'[Horas usadas]), REMOVEFILTERS('Calendário'), 'Meses dos coworkings'[Mês] >= inicio, 'Meses dos coworkings'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: de976db8-6da3-5046-9e9d-85603dc4bdf1

	/// Soma o custo dos coworkings no período.
	measure 'Custo dos coworkings no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Meses dos coworkings'[Custo]), REMOVEFILTERS('Calendário'), 'Meses dos coworkings'[Mês] >= inicio, 'Meses dos coworkings'[Mês] <= d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Atendimento
		lineageTag: 4765af5e-802f-5908-be53-c2d6019d8597

	/// Mostra a parte das horas de mesa disponíveis no período que foi usada.
	measure 'Ocupação dos coworkings' = DIVIDE([Horas usadas no período], [Horas disponíveis no período])
		formatString: 0.0%
		displayFolder: Atendimento
		lineageTag: 75fb82e4-8e30-5172-ba59-32dc52071185

	/// Conta os profissionais que usaram os coworkings no período.
	measure 'Usuários dos coworkings' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Usuários dos coworkings'[Profissional]), REMOVEFILTERS('Calendário'), 'Usuários dos coworkings'[Mês] >= inicio, 'Usuários dos coworkings'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: c8fb5df4-fb86-50ce-be63-4d6c0dc09b91

	/// Conta as unidades de coworking no recorte.
	measure 'Unidades de coworking' = COUNTROWS('Coworkings') + 0
		formatString: #,##0
		displayFolder: Atendimento
		lineageTag: f61d2d8c-a4ea-524a-a46e-8a74c70a3605

	/// Compara o cartão com o mesmo número de meses terminados no fim do mesmo mês um ano antes.
	measure 'Variação em um ano: Receita do Conselho' = ```
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Receita do Conselho]
			VAR antes = CALCULATE([Receita do Conselho], 'Datas das fotos'[Data] = alvo)
			RETURN IF(antes > 0, DIVIDE(agora - antes, antes))
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Receita
		lineageTag: 21ec719a-ba01-54d8-aeaf-135200704837

	/// Escreve a comparação que o cartão mostra embaixo do número.
	measure 'Comparação: Receita do Conselho' = ```
			VAR v = [Variação em um ano: Receita do Conselho]
			RETURN IF(ISBLANK(v), "sem comparação", FORMAT(v, "+0.0%;-0.0%;0.0%") & " em relação a um ano antes")
			```
		displayFolder: Receita
		lineageTag: 8c317092-d26a-510c-aade-0bbaf38783e3

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Receita do Conselho' = "em " & [Meses do período] & " meses, de anuidades, ARTs, multas e outras origens"
