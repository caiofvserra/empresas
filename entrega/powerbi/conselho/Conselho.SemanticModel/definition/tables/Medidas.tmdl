		lineageTag: 3365612d-f6f8-5cff-b2b3-ec9597ae1062

	/// Conta os processos com pedido de vista no período: saíram da pauta para outro conselheiro ler.
	measure 'Pedidos de vista' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Eventos'[Tramitação]), 'Eventos'[Desde] >= inicio, 'Eventos'[Desde] <= d, KEEPFILTERS('Eventos'[Status] = "Pedido de vista")) + 0
