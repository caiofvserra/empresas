		lineageTag: a67c9f39-d780-5b4f-8df2-eac1347a9c00

	/// Soma as diárias pagas nos 12 meses até a data a cada conselheiro em exercício nela, do colegiado escolhido.
	measure 'Valor das diárias de conselheiros' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(SUM('Diárias'[Valor]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem))
			```
		formatString: R$ #,##0
		displayFolder: Conselheiros
		lineageTag: 60220251-45f1-5f03-a2ce-0ec994d5f57c

	/// Soma as diárias pagas nos 12 meses até a data aos conselheiros em exercício nela, do colegiado escolhido. Quem recebeu aparece pelo nome na tabela.
	measure 'Diárias dos conselheiros' = [Valor das diárias de conselheiros] + 0
		formatString: R$ #,##0
		displayFolder: Conselheiros
		lineageTag: 4e43e3dc-14ec-574a-9f82-867400ca2ddf

	/// Conta as diárias pagas a cada conselheiro nos 12 meses.
	measure 'Diárias de conselheiros em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(SUM('Diárias'[Diárias]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem))
			```
		formatString: #,##0
		displayFolder: Conselheiros
		lineageTag: b828daf1-5c18-5597-ab99-6b09fd4887d8

	/// Conta os meses dos 12 em que o conselheiro recebeu diária.
	measure 'Meses com diária de conselheiro' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Mês]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem))
			```
		formatString: 0
		displayFolder: Conselheiros
		lineageTag: d0e988a1-a219-5bbb-bd5a-79098fa2a7b4

	/// Conta os conselheiros em exercício que receberam diária nos 12 meses.
	measure 'Conselheiros com diária' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR quem = CALCULATETABLE(VALUES('Conselheiros'[Pessoa]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Pessoa]), 'Diárias'[Mês] >= DATE(YEAR(d), MONTH(d) - 12 + 1, 1), 'Diárias'[Mês] <= d, KEEPFILTERS('Diárias'[Pessoa] IN quem)) + 0
			```
		formatString: #,##0
		displayFolder: Conselheiros
		lineageTag: 8eef2b2c-02fd-500a-8433-4a8442545e71

	/// Conta os autos de infração votados pelas câmaras no período, para os gráficos.
	measure 'Autos votados' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))))
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 0603606d-1441-5f23-8dce-77f5313e1800

	/// Conta os autos de infração votados pelas câmaras no período. Com o Plenário escolhido, só os autos que chegaram a ele em recurso.
	measure 'Autos votados nas câmaras' = [Autos votados] + 0
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: b1022e00-c854-56d6-8910-d9c84e74bf51

	/// Conta os autos votados de empresas ou profissionais que já tinham multa antes: a multa vem em dobro (Lei 5.194/66, art. 73, parágrafo único).
	measure 'Autos de reincidentes' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))), KEEPFILTERS('Autos'[Reincidente] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: f5753421-cad7-5783-8f14-a889cd625258

	/// Soma as multas da decisão das câmaras no período, antes do recurso. É um fluxo.
	measure 'Multas aplicadas' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(SUM('Autos'[Multa da câmara]), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))) + 0
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: f68e826d-5ba3-5843-9473-db95a838a4d2

	/// Conta os autos arquivados porque prescreveram.
	measure 'Autos arquivados pela prescrição' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))), KEEPFILTERS('Autos'[Desfecho] = "Arquivamento pela prescrição")) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 1e45598d-d28c-5043-adc8-a7f55f1c3eca

	/// Conta os autos votados no período que a câmara arquivou, inclusive pela prescrição.
	measure 'Autos arquivados no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Autos'), 'Autos'[Julgado em] >= inicio, 'Autos'[Julgado em] <= d, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d))), KEEPFILTERS('Autos'[Desfecho] IN {"Arquivamento", "Arquivamento pela prescrição"})) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 278d28a9-7f64-5333-9399-3b4185a6e0cc

	/// Mostra a parte dos autos votados no período que a câmara arquivou, inclusive pela prescrição.
	measure 'Autos arquivados' = DIVIDE([Autos arquivados no período], [Autos votados])
		formatString: 0.0%
		displayFolder: Decisões
		lineageTag: 76d16fec-7226-5b8e-b809-5d4492c227f7

	/// Conta os recursos que já chegaram ao Plenário e ainda não foram votados na data escolhida. É um estoque.
	measure 'Recursos esperando o Plenário' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto da fila'), 'Foto da fila'[Data] = d, KEEPFILTERS('Tramitações'[Instância] = "Plenário")) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 5f45a8c3-a8e5-5b81-82ed-555b5f8b636e

	/// Conta os recursos votados pelo Plenário no período.
	measure 'Recursos votados pelo Plenário' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS('Tramitações'[Instância] = "Plenário")) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 85b1f4f1-b4be-506b-8e90-6c89cb5d5cde

	/// Conta os recursos votados pelo Plenário no período em que ele reformou a decisão da câmara.
	measure 'Recursos reformados pelo Plenário' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Tramitações'), 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS('Tramitações'[Instância] = "Plenário"), KEEPFILTERS('Tramitações'[Decisão do Plenário] = "Decisão reformada")) + 0
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 1fbf6de9-9316-56b7-a9d7-6481d09b662c

	/// Mostra a parte dos recursos votados pelo Plenário no período em que ele reformou a decisão da câmara.
	measure 'Reformadas pelo Plenário' = DIVIDE([Recursos reformados pelo Plenário], [Recursos votados pelo Plenário])
		formatString: 0.0%
		displayFolder: Decisões
		lineageTag: 47f05da9-41ca-5a27-9eb0-46f152f018ce

	/// Conta os recursos votados pelo Plenário no período, pela câmara de onde vieram. Com uma câmara escolhida, só os dela.
	measure 'Recursos votados no Plenário por câmara' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Tramitações'), REMOVEFILTERS('Colegiados'), 'Tramitações'[Instância] = "Plenário", 'Tramitações'[Votado em] >= inicio, 'Tramitações'[Votado em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Tramitações'[Câmara de origem] = c))
			```
		formatString: #,##0
		displayFolder: Decisões
		lineageTag: 3036c823-2073-5619-8f9a-026b0523d972

	/// Soma, pelo ano da decisão da câmara (os quatro últimos), as multas já pagas na data escolhida.
	measure 'Multa paga' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), NOT ('Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d) && NOT ISBLANK('Autos'[Pago em]) && 'Autos'[Pago em] <= d), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: d7ddc97d-79f2-5113-ae58-f5852576b44e

	/// Soma, pelo ano da decisão, as multas que transitaram em julgado e ainda não foram pagas.
	measure 'Multa em cobrança' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), NOT ('Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d) && NOT (NOT ISBLANK('Autos'[Pago em]) && 'Autos'[Pago em] <= d) && NOT ISBLANK('Autos'[Trânsito em julgado]) && 'Autos'[Trânsito em julgado] <= d), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 74a39919-c8fa-5f77-ab8e-d3613809c20c

	/// Soma, pelo ano da decisão, as multas ainda em recurso (no Plenário ou no Confea).
	measure 'Multa em recurso' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), NOT ('Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d) && NOT (NOT ISBLANK('Autos'[Pago em]) && 'Autos'[Pago em] <= d) && NOT (NOT ISBLANK('Autos'[Trânsito em julgado]) && 'Autos'[Trânsito em julgado] <= d)), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 89cc40d3-8050-5829-acaa-1ddbd8ee49a0

	/// Soma, pelo ano da decisão, as multas que o Plenário anulou ao reformar a decisão da câmara.
	measure 'Multa anulada no recurso' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN SUMX(FILTER(CALCULATETABLE('Autos', 'Autos'[Julgado em] <= d, 'Autos'[Ano da decisão] >= YEAR(d) - 3, 'Autos'[Multa da câmara] > 0, KEEPFILTERS(FILTER(ALL('Autos'[Câmara], 'Autos'[Recurso ao Plenário em]), ISBLANK(c) || 'Autos'[Câmara] = c || (c = "Plenário" && NOT ISBLANK('Autos'[Recurso ao Plenário em]) && 'Autos'[Recurso ao Plenário em] <= d)))), 'Autos'[Multa final] = 0 && NOT ISBLANK('Autos'[Plenário em]) && 'Autos'[Plenário em] <= d), 'Autos'[Multa da câmara])
			```
		formatString: R$ #,##0
		displayFolder: Decisões
		lineageTag: 5fd5acf4-1d6a-5cd6-95e3-766cf9be30e7

	/// Conta as cadeiras com conselheiro em exercício na data escolhida, do colegiado escolhido.
	measure 'Cadeiras ocupadas' = [Conselheiros em exercício]
		formatString: #,##0
		displayFolder: Representação
		lineageTag: 44b4be1d-51e1-5273-8547-96558b935350

	/// Conta as organizações que indicaram os conselheiros em exercício.
	measure 'Organizações com cadeira' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(DISTINCTCOUNT('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c)) + 0
			```
		formatString: #,##0
		displayFolder: Representação
		lineageTag: e8569fca-c213-50e0-b05d-8d422fd5abe1

	/// Conta as mulheres entre os conselheiros em exercício.
	measure 'Conselheiras em exercício' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(COUNTROWS('Conselheiros'), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c), KEEPFILTERS('Conselheiros'[Gênero] = "Feminino")) + 0
			```
		formatString: #,##0
		displayFolder: Representação
		lineageTag: 34dd867e-004e-5d7c-b4e9-eb764841f4df

	/// Mostra a parte de mulheres entre os conselheiros em exercício.
	measure Conselheiras = DIVIDE([Conselheiras em exercício], [Conselheiros em exercício])
		formatString: 0.0%
		displayFolder: Representação
		lineageTag: 007f7acd-5017-589f-a3f7-0c0567b8e246

	/// Mostra a parte de mulheres entre os conselheiros em exercício de cada câmara do eixo.
	measure 'Mulheres entre os conselheiros' = ```
			VAR camaras = VALUES('Foto das câmaras'[Câmara])
			RETURN DIVIDE(CALCULATE([Conselheiras em exercício], TREATAS(camaras, 'Conselheiros'[Câmara])), CALCULATE([Conselheiros em exercício], TREATAS(camaras, 'Conselheiros'[Câmara])))
			```
		formatString: 0.0%
		displayFolder: Representação
		lineageTag: 0549d548-8477-5d36-a68e-adc05e761cff

	/// Conta os profissionais ativos da modalidade que cada câmara julga, na data escolhida; com uma câmara escolhida, só os dela.
	measure 'Profissionais ativos da câmara' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(SUM('Foto das câmaras'[Profissionais ativos]), 'Foto das câmaras'[Data] = d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Foto das câmaras'[Câmara] = c))
			```
		formatString: #,##0
		displayFolder: Representação
		lineageTag: 5d321cc5-2e87-5e4f-a8f2-139d66c2b5aa

	/// Conta as mulheres entre os profissionais ativos da modalidade que cada câmara julga.
	measure 'Profissionais ativas da câmara' = ```
			VAR d = [Data escolhida]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			RETURN CALCULATE(SUM('Foto das câmaras'[Profissionais ativas]), 'Foto das câmaras'[Data] = d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Foto das câmaras'[Câmara] = c))
