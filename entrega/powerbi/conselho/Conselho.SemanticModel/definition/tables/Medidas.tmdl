		lineageTag: 709d8e5f-278d-56f9-b47e-7397cf6f94ba

	/// Conta as deliberações em que quem propôs o repasse é conselheiro indicado pela organização que recebe.
	measure 'Propostos pela própria organização' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR c = SELECTEDVALUE('Colegiados'[Colegiado])
			VAR orgs = CALCULATETABLE(VALUES('Conselheiros'[Organização]), 'Conselheiros'[Início] <= d, 'Conselheiros'[Fim] >= d, 'Conselheiros'[Organização registrada em] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Conselheiros'[Câmara] = c))
			RETURN CALCULATE(COUNTROWS('Deliberações'), 'Deliberações'[Data] >= inicio, 'Deliberações'[Data] <= d, KEEPFILTERS(ISBLANK(c) || c = "Plenário" || 'Deliberações'[Organização] IN orgs), KEEPFILTERS('Deliberações'[Proposta pela própria organização] = 1)) + 0
