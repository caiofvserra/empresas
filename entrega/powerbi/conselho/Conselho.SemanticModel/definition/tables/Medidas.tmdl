	/// Mostra a parte das cadeiras do Plenário que é de cada câmara.
	measure 'Parte das cadeiras' = ```
			VAR d = [Data escolhida]
			RETURN DIVIDE([Cadeiras da câmara], CALCULATE(SUM('Foto das câmaras'[Cadeiras]), 'Foto das câmaras'[Data] = d, REMOVEFILTERS('Foto das câmaras'[Câmara])))
			```
		formatString: 0.0%
