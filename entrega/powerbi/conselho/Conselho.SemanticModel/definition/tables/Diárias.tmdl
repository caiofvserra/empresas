/// Guarda as diárias pagas a cada pessoa em cada mês, com a categoria e a GRE do lançamento. As diárias de cada pessoa somam o total de cada categoria.
table 'Diárias'
	lineageTag: 70d56916-5a60-5e5c-8178-601e5e70d6af

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 9febe981-9247-5747-b3ef-95690085f27c

	column Pessoa
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: 512af76a-c89f-5630-919f-13b28c99a96d

	column Categoria
		dataType: string
		summarizeBy: none
		sourceColumn: Categoria
		lineageTag: 5b34bc9a-95d5-57a8-b0ec-31426fb06eeb

	column GRE
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: GRE
		lineageTag: 31e574e5-aa8a-5d03-b8e2-c72d9d8ba850

	column 'Diárias'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Diárias
		lineageTag: 267a890e-f7eb-54c4-a276-81f6930e270f

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: abde9f67-fdf9-55a9-8dbf-7f4f420ea0d6

	column 'Quilômetros'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Quilômetros
		lineageTag: 1a5f7826-d483-5e70-bc56-7e6e0ab79b2f

	partition 'Diárias' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "diarias.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Pessoa", type text}, {"Categoria", type text}, {"GRE", type text}, {"Diárias", Int64.Type}, {"Valor", type number}, {"Quilômetros", Int64.Type}}, "pt-BR")
				in
				    Tipos
