/// Tem os 645 municípios de SP e a GRE de cada um pela tabela oficial. A regional e o município recortam só os processos, pelo lugar do processo.
table 'Municípios'
	lineageTag: 8c7ac691-40b4-500b-a920-83c9c5cb29e6

	column 'Código IBGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: 1d208e24-e1be-5a66-a394-72cccb54994f

	column 'Município'
		dataType: string
		summarizeBy: none
		sourceColumn: Município
		lineageTag: 670b7157-46dc-52ad-9c04-19cf96d941cc

	column GRE
		dataType: string
		summarizeBy: none
		sourceColumn: GRE
		lineageTag: 6bbdf242-f287-5794-b1bf-5dfae0a15489

	partition 'Municípios' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "municipios.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Código IBGE", type text}, {"Município", type text}, {"GRE", type text}}, "pt-BR")
				in
				    Tipos
