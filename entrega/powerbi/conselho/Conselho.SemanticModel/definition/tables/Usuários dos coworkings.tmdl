/// Guarda os profissionais que usaram cada unidade em cada mês.
table 'Usuários dos coworkings'
	isHidden
	lineageTag: 7d2b96ee-d565-5db0-a589-9f16e835f96f

	column Unidade
		dataType: string
		summarizeBy: none
		sourceColumn: Unidade
		lineageTag: 043db6a3-46c6-54b9-b898-8b4b75ee2706

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 00ef8c89-b10d-51a3-8081-bbd10bdbcab8

	column Profissional
		dataType: string
		summarizeBy: none
		sourceColumn: Profissional
		lineageTag: 53f6bbf0-c198-5e6a-8c08-88c8ce746b47

	partition 'Usuários dos coworkings' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "coworkings-usuarios.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Unidade", type text}, {"Mês", type date}, {"Profissional", type text}}, "pt-BR")
				in
				    Tipos
