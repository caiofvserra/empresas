/// Guarda, no último dia de cada mês, as cadeiras de cada câmara no plenário e os profissionais ativos da modalidade que ela julga.
table 'Foto do plenário'
	isHidden
	lineageTag: cd590caa-99c9-5358-9b34-7352d80c17b5

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
		lineageTag: b4cefb25-9675-5a6f-9bf8-029da1f8afb4

	column 'Câmara'
		dataType: string
		summarizeBy: none
		sourceColumn: Câmara
		lineageTag: ed436313-42d4-5561-a8f2-b0dbab8c6f36

	column Cadeiras
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Cadeiras
		lineageTag: cf326235-5dc7-5e4b-a37c-da5d6176f660

	column 'Profissionais ativos'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Profissionais ativos
		lineageTag: 1e76d9aa-f3b1-5b68-bc91-aee226984eeb

	partition 'Foto do plenário' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "foto-plenario.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Data", type date}, {"Câmara", type text}, {"Cadeiras", Int64.Type}, {"Profissionais ativos", Int64.Type}}, "pt-BR")
				in
				    Tipos
