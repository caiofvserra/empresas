				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Processo", type text}, {"Câmara", type text}, {"Código IBGE", type text}, {"Julgado em", type date}, {"Ano da decisão", Int64.Type}, {"Desfecho", type text}, {"Ordem do desfecho", Int64.Type}, {"Infração", type text}, {"Reincidente", Int64.Type}, {"Multa da câmara", type number}, {"Multa final", type number}, {"Recurso ao Plenário em", type date}, {"Plenário em", type date}, {"Recurso ao Confea em", type date}, {"Trânsito em julgado", type date}, {"Pago em", type date}}, "pt-BR")
				in
				    Tipos
