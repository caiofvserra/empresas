/// Guarda o número de meses somados nos fluxos, contados para trás a partir da data de referência. No Power BI Desktop, é um parâmetro do tipo "Intervalo numérico", de 1 a 36 meses.
table 'Período'
	lineageTag: 9a8f215b-1aba-5e15-934b-243397817bfe

	column Meses
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]
		lineageTag: 10c7a071-dcd5-526b-92a2-ef59b1e4e650

		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

	partition 'Período' = calculated
		mode: import
		source = GENERATESERIES(1, 36, 1)
