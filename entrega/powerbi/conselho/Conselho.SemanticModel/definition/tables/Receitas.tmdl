/// Guarda a receita prevista e a realizada de cada mês, por origem. A receita do Conselho é do estado inteiro: não muda com a regional.
table Receitas
	lineageTag: 5be2c95b-1a0e-56e1-b216-35c3110cda84

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 9075f464-977f-5bc2-9029-1bec759e5c1b

	column Origem
		dataType: string
		summarizeBy: none
		sourceColumn: Origem
		lineageTag: 09efe71b-c79b-5e49-bdf6-d5a32370bf42

	column Prevista
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Prevista
		lineageTag: 1e269186-1a2e-5604-b34a-9b4e97dabd23

	column Realizada
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Realizada
		lineageTag: c482aea9-46b1-5a47-b2e5-4ee1c270f40e

	partition Receitas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "receitas.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Origem", type text}, {"Prevista", type number}, {"Realizada", type number}}, "pt-BR")
				in
				    Tipos
