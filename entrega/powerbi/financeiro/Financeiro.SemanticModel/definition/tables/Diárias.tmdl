/// Guarda o valor pago a cada pessoa em cada mês e o número de pagamentos.
table 'Diárias'
	isHidden
	lineageTag: de21af6b-330b-58f5-a8a2-bcf3883e0286

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 52718f88-36b6-575a-9848-1c106afc5011

	column Pessoa
		dataType: string
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: d1c590c9-ff3d-5aa3-8a6a-8bb17bba9c9a

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: e3089af2-89f4-59e0-9d97-39da9ae85997

	column Pagamentos
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Pagamentos
		lineageTag: cfadea29-3137-5c87-827e-ef9115625d0a

	partition 'Diárias' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "diarias.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Pessoa", type text}, {"Valor", type number}, {"Pagamentos", Int64.Type}}, "pt-BR")
				in
				    Tipos
