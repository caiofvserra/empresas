/// Guarda a despesa empenhada de cada mês desde 2013, por grupo, da Transparência do Crea-SP (dado real, do estado inteiro).
table Despesas
	lineageTag: f25b5270-3979-55da-8bc0-9f6876f05647

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 3f53b2cb-a6d0-5c15-80ea-e963915491cc

	column Grupo
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Grupo
		lineageTag: bd75e816-4d6d-5714-80db-341e6ddae81d

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: c948e29d-0ac5-555b-bde9-0cd56684f086

	partition Despesas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "despesas.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Grupo", type text}, {"Valor", type number}}, "pt-BR")
				in
				    Tipos
