/// Tem os 645 municípios de SP e a GRE de cada um pela tabela oficial. A regional e o município recortam a arrecadação (pelo peso do município), a dívida e a adimplência; a receita, a despesa e o orçamento são do estado inteiro.
table 'Municípios'
	lineageTag: 8c6a472a-7abe-57d0-adb8-ab22f50ef641

	column 'Código IBGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: f0be7fd3-4bc7-5e79-8a38-a99bce0d5974

	column 'Município'
		dataType: string
		summarizeBy: none
		sourceColumn: Município
		lineageTag: 86d967d0-75b6-52f2-8b09-6868aa5f7987

	column GRE
		dataType: string
		summarizeBy: none
		sourceColumn: GRE
		lineageTag: 8c09d3c5-1443-57b3-9b60-ceddf8a97112

	partition 'Municípios' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "municipios.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Código IBGE", type text}, {"Município", type text}, {"GRE", type text}}, "pt-BR")
				in
				    Tipos
