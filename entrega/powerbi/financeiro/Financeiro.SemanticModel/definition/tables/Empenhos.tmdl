/// Guarda cada empenho, com o mês, o fornecedor, o valor empenhado, o pago e o contrato.
table Empenhos
	lineageTag: 2a1351e1-362c-58e3-a010-a0f96554f40a

	column Empenho
		dataType: string
		summarizeBy: none
		sourceColumn: Empenho
		lineageTag: 8ab57a74-0ff4-591e-8ea3-aa4c550b584b

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: ad14b364-680d-519e-9b26-18dce479c23f

	column Fornecedor
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Fornecedor
		lineageTag: 0ca34bd7-53ae-5479-b9d4-f18f9f0dc4ea

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 0977b91e-a0e2-5274-a128-0c36e942e781

	column Pago
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Pago
		lineageTag: 4fccbea1-314e-5dd7-b7ca-7a5905368068

	column Contrato
		dataType: string
		summarizeBy: none
		sourceColumn: Contrato
		lineageTag: 27f3a82c-be69-52ce-afb3-a1044b78042d

	partition Empenhos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "empenhos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Empenho", type text}, {"Mês", type date}, {"Fornecedor", type text}, {"Valor", type number}, {"Pago", type number}, {"Contrato", type text}}, "pt-BR")
				in
				    Tipos
