/// Tem quem recebeu diária, jeton ou deslocamento nos últimos 37 meses, pelo nome publicado nos pagamentos da Transparência, com a categoria (conselheiro, empregado, inspetor, colaborador, jeton). O CPF não é gravado.
table Pessoas
	lineageTag: 1db3640e-fe81-53f8-8e61-eaa60e2b3963

	column Pessoa
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Pessoa
		lineageTag: e8f92a08-6408-5dfa-b5d1-c7a0686b9853

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: 150d57d0-07e3-5856-9b82-cf2821129fdb

	column Categoria
		dataType: string
		summarizeBy: none
		sourceColumn: Categoria
		lineageTag: bb1c0820-516e-50aa-9d9b-6d1887908909

	partition Pessoas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "pessoas.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Pessoa", type text}, {"Nome", type text}, {"Categoria", type text}}, "pt-BR")
				in
				    Tipos
