	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Contratos vigentes' = FORMAT([Valor dos contratos vigentes], "R$ #,##0") & "; " & FORMAT([Contratos que terminam em 90 dias], "#,##0") & " terminam em 90 dias"
