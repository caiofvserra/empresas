	column Medidas
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Medidas
		lineageTag: a7b0a23b-58e0-587d-936a-5ce34a5e116a

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [#"Medidas" = type text], {})
				in
				    Fonte
