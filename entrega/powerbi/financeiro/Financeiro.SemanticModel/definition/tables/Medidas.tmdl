/// Guarda as medidas do painel, em pastas por página.
table Medidas
	lineageTag: 01b60e7b-4bd3-57b1-bcb0-29c3ed3e59c2

	/// Devolve a data de referência escolhida; sem escolha, a mais recente. As medidas de variação trocam a data pela de um ano antes.
	measure 'Data escolhida' = IF(ISFILTERED('Datas das fotos'[Data]), MAX('Datas das fotos'[Data]), MAX('Datas de referência'[Data]))
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 9c7750ac-8465-50ae-b02e-dd347ff45acf

	/// Devolve o período escolhido, em meses; sem escolha, 12.
	measure 'Meses do período' = SELECTEDVALUE('Período'[Meses], 12)
		formatString: 0
		displayFolder: Apoio
		lineageTag: d7edea80-b5cb-5cbe-b5d7-8738099dadb7

	/// Devolve o primeiro dia do primeiro mês do período: o período termina na data escolhida e começa no primeiro dia do mês, como no painel.
	measure 'Início do período' = ```
			VAR d = [Data escolhida]
			RETURN DATE(YEAR(d), MONTH(d) - [Meses do período] + 1, 1)
			```
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 2157b5e8-a8ab-5176-8c44-bf503012b371

	/// Calcula cinco vezes a anuidade de pessoa física do ano da data escolhida (Lei 12.514/2011, art. 8º, com a redação da Lei 14.195/2021). Abaixo dele, o Conselho não pode executar a dívida na Justiça. A anuidade do cenário é demonstrativa.
	measure 'Piso de execução' = ```
			VAR d = [Data escolhida]
			RETURN 5 * ROUND(520 * POWER(1.055, MAX(0, YEAR(d) - 2020)), 0)
			```
		formatString: R$ #,##0
		displayFolder: Apoio
		lineageTag: b6121e65-acd7-55a3-990f-cf6ddafbfe7a

	/// Guarda os profissionais ativos de SP no Confea, na data da coleta, para a receita e a despesa por profissional ativo.
	measure 'Profissionais ativos em SP' = 346824
		formatString: #,##0
		displayFolder: Apoio
		lineageTag: 2d83b5fc-804c-5bd2-ad09-8db457ca54bb

	/// Mostra a parte do recorte (regional ou município) no peso do estado, no tipo de receita do contexto; sem recorte, 100%. A arrecadação do recorte é a do estado vezes esta parte, tipo a tipo.
	measure 'Parte do recorte' = ```
			VAR total = CALCULATE(SUM('Pesos'[Peso]), REMOVEFILTERS('Municípios'), REMOVEFILTERS('Regionais'))
			RETURN IF(ISCROSSFILTERED('Municípios'), DIVIDE(SUM('Pesos'[Peso]), total), 1)
			```
		formatString: 0.0%
		displayFolder: Apoio
		lineageTag: 72607b4b-bfb0-5dc1-9e13-b113bd3c3ce4

	/// Soma a arrecadação do recorte do primeiro dia do mês até a data escolhida.
	measure 'Arrecadado no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Arrecadação'[Valor]), REMOVEFILTERS('Dias'), 'Arrecadação'[Dia] >= mes, 'Arrecadação'[Dia] <= d) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 2da47d35-9587-54cf-818d-37bd06750ac0

	/// Mostra a meta do mês da data, tipo a tipo, vezes a parte do recorte.
	measure 'Meta do mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Metas'[Meta]), 'Metas'[Mês] = mes) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: c6389264-ff52-5a2a-94f0-809cec50e23d

	/// Mostra quanto falta para a meta do mês; zero quando a meta foi batida.
	measure 'Falta para a meta do mês' = MAX(0, [Meta do mês] - [Arrecadado no mês])
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 1a855c81-12ec-5eeb-bded-b9996389df4e

	/// Conta os dias úteis do mês da data.
	measure 'Dias úteis do mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(COUNTROWS('Dias'), REMOVEFILTERS('Dias'), 'Dias'[Mês] = mes, 'Dias'[Útil] = 1) + 0
			```
		formatString: #,##0
		displayFolder: Arrecadação
		lineageTag: cab473fd-d44e-54e7-a7e4-e53566f2d800

	/// Conta os dias úteis do mês até a data escolhida.
	measure 'Dias úteis passados' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(COUNTROWS('Dias'), REMOVEFILTERS('Dias'), 'Dias'[Mês] = mes, 'Dias'[Útil] = 1, 'Dias'[Dia] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Arrecadação
		lineageTag: c1a02e3a-0904-5bc0-ab06-4232d2fee047

	/// Conta os dias úteis do mês depois da data escolhida.
	measure 'Dias úteis que faltam' = [Dias úteis do mês] - [Dias úteis passados]
		formatString: #,##0
		displayFolder: Arrecadação
		lineageTag: 2342fcdc-2681-52ae-9685-eb44c6bd99f9

	/// Divide o que falta para a meta pelos dias úteis que faltam no mês. Em branco quando a meta foi batida ou o mês fechou.
	measure 'Média diária necessária' = IF([Dias úteis que faltam] > 0 && [Falta para a meta do mês] > 0, DIVIDE([Falta para a meta do mês], [Dias úteis que faltam]))
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 8fd2bfca-8515-5b4c-85fe-e1923b52a94b

	/// Repete a média dos dias úteis já passados até o fim do mês.
	measure 'O mês no ritmo atual' = DIVIDE([Arrecadado no mês], [Dias úteis passados]) * [Dias úteis do mês]
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: e0220398-6d4f-57fa-88a1-0a3083a2bb77

	/// Soma a arrecadação do recorte de 1º de janeiro até a data escolhida.
	measure 'Arrecadado no ano' = ```
			VAR d = [Data escolhida]
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Arrecadação'[Valor]), REMOVEFILTERS('Dias'), 'Arrecadação'[Dia] >= DATE(YEAR(d), 1, 1), 'Arrecadação'[Dia] <= d) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 3bb92af9-f8fa-54db-8fa8-83014cf51604

	/// Soma a meta de janeiro até o mês da data, no recorte.
	measure 'Meta até o mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Metas'[Meta]), 'Metas'[Mês] >= DATE(YEAR(d), 1, 1), 'Metas'[Mês] <= mes) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: f467960a-5e11-58d4-b6a6-ab82169ce035

	/// Soma a meta dos 12 meses do ano da data, no recorte.
	measure 'Meta do ano' = ```
			VAR d = [Data escolhida]
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Metas'[Meta]), YEAR('Metas'[Mês]) = YEAR(d)) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 5ddd4f80-96f7-5746-aec8-25583ce69681

	/// Soma a arrecadação do recorte em cada dia do mês da data, até ela.
	measure 'Arrecadado no dia' = ```
			VAR d = [Data escolhida]
			VAR dia = DATE(YEAR(d), MONTH(d), MAX('Dias'[Dia do mês]))
			RETURN IF(dia <= d && MONTH(dia) = MONTH(d), SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Arrecadação'[Valor]), REMOVEFILTERS('Dias'), 'Arrecadação'[Dia] >= dia, 'Arrecadação'[Dia] <= dia) * [Parte do recorte]))
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: f861c32b-be95-538d-bc02-e323316eebfe

	/// Soma a arrecadação do recorte do primeiro dia do mês até cada dia, até a data.
	measure 'Arrecadado acumulado no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			VAR dia = DATE(YEAR(d), MONTH(d), MAX('Dias'[Dia do mês]))
			RETURN IF(dia <= d && MONTH(dia) = MONTH(d), SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Arrecadação'[Valor]), REMOVEFILTERS('Dias'), 'Arrecadação'[Dia] >= mes, 'Arrecadação'[Dia] <= dia) * [Parte do recorte]))
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: ab90f73c-e99a-563e-a55a-169418ba55d5

	/// Divide a meta do mês igualmente pelos dias úteis e acumula até cada dia, a linha tracejada do painel.
	measure 'Meta acumulada no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			VAR dia = DATE(YEAR(d), MONTH(d), MAX('Dias'[Dia do mês]))
			VAR ate = CALCULATE(COUNTROWS('Dias'), REMOVEFILTERS('Dias'), 'Dias'[Mês] = mes, 'Dias'[Útil] = 1, 'Dias'[Dia] <= dia)
			RETURN IF(MONTH(dia) = MONTH(d), DIVIDE([Meta do mês] * ate, [Dias úteis do mês]))
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 8805e16d-c4a1-502b-912d-0a1534ce9a58

	/// Soma a arrecadação do recorte em cada dia do mês da data, para a matriz do calendário (semana nas linhas, dia da semana nas colunas).
	measure 'Arrecadado no dia do calendário' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			VAR dia = CALCULATE(MAX('Dias'[Dia]), KEEPFILTERS('Dias'[Mês] = mes))
			RETURN IF(NOT ISBLANK(dia) && dia <= d, SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Arrecadação'[Valor]), REMOVEFILTERS('Dias'), 'Arrecadação'[Dia] >= dia, 'Arrecadação'[Dia] <= dia) * [Parte do recorte]))
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 1eaa4e46-9412-5e24-a371-8fee1181170f

	/// Soma a arrecadação do recorte em cada mês do ano da data, até o mês dela.
	measure 'Arrecadado em cada mês do ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR inicio = DATE(YEAR(d), m, 1)
			RETURN IF(m <= MONTH(d), SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] = inicio) * [Parte do recorte]))
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 761cde78-d098-582a-b597-1ec013fbb86d

	/// Mostra a meta de cada mês do ano da data, no recorte.
	measure 'Meta de cada mês do ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR inicio = DATE(YEAR(d), m, 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Metas'[Meta]), REMOVEFILTERS('Calendário'), 'Metas'[Mês] = inicio) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: e6eef0f2-a530-572c-8a8c-a0ea0aef2773

	/// Soma a arrecadação do recorte em cada mês do ano anterior ao da data.
	measure 'Arrecadado no mesmo mês do ano anterior' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR inicio = DATE(YEAR(d) - 1, m, 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] = inicio) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: ac88a331-fd94-56ef-a7ab-7dc9e1a0a2f4

	/// Soma a arrecadação do recorte no mês da data, por tipo.
	measure 'Tipo no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] = mes) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: ae1a7417-8e26-59bd-8349-f60f9e050982

	/// Soma a arrecadação do recorte no mesmo mês do ano anterior, por tipo.
	measure 'Tipo no mês do ano anterior' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] = EDATE(mes, -12)) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 2ff04f5c-5be1-5876-a6e3-0df49af408ed

	/// Compara o mês da data com o mesmo mês do ano anterior.
	measure 'Variação no mês' = IF([Tipo no mês do ano anterior] > 0, DIVIDE([Tipo no mês], [Tipo no mês do ano anterior]) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Arrecadação
		lineageTag: b30cf177-f9ae-539d-882c-d1afcfe99166

	/// Soma a arrecadação do recorte de janeiro até o mês da data, por tipo.
	measure 'Tipo no ano' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(YEAR(d), 1, 1), 'Receitas'[Mês] <= mes) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: cc412fc3-dc41-5501-a1ca-271b77dcae3e

	/// Soma a arrecadação do recorte de janeiro até o mesmo mês do ano anterior, por tipo.
	measure 'Tipo no ano anterior' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(YEAR(d) - 1, 1, 1), 'Receitas'[Mês] <= EDATE(mes, -12)) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 3ec8b239-6396-5883-93d6-3bb176285972

	/// Divide o arrecadado de janeiro até o mês pela meta do mesmo intervalo, por tipo.
	measure 'Tipo no ano na meta' = DIVIDE([Tipo no ano], [Meta até o mês])
		formatString: 0.0%
		displayFolder: Arrecadação
		lineageTag: a09cb191-7a4a-556b-ad91-51c970ad5e58

	/// Compara o acumulado do ano com o mesmo intervalo do ano anterior.
	measure 'Variação no ano' = IF([Tipo no ano anterior] > 0, DIVIDE([Tipo no ano], [Tipo no ano anterior]) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Arrecadação
		lineageTag: d3afa923-4cc0-53e1-a925-d8bb18e405aa

	/// Soma a arrecadação de 1º de janeiro até a data em cada município, para o mapa.
	measure 'Arrecadado no ano por município' = ```
			VAR d = [Data escolhida]
			RETURN SUMX(VALUES('Tipos de receita'[Tipo]), CALCULATE(SUM('Arrecadação'[Valor]), REMOVEFILTERS('Dias'), 'Arrecadação'[Dia] >= DATE(YEAR(d), 1, 1), 'Arrecadação'[Dia] <= d) * [Parte do recorte])
			```
		formatString: R$ #,##0
		displayFolder: Arrecadação
		lineageTag: 23fd0589-97a2-5417-91f3-1a41b79327d0

	/// Soma a receita realizada nos meses do período, terminados no mês da data.
	measure 'Receita no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= inicio, 'Receitas'[Mês] <= fim) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 98e5e97e-9790-5018-b943-2366746b0481

	/// Soma as taxas de ART recebidas no período.
	measure 'Receita de ART no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= inicio, 'Receitas'[Mês] <= fim, KEEPFILTERS('Receitas'[Tipo] = "ART")) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 0fbc0622-8c1c-5b54-97ad-6d5a1362b1df

	/// Mostra a parte da receita do período que veio das taxas de ART.
	measure 'Parte da ART na receita' = DIVIDE([Receita de ART no período], [Receita no período])
		formatString: 0.0%
		displayFolder: Receita
		lineageTag: dc606a4a-28ec-5668-ac6d-4822b1abde17

	/// Soma as anuidades recebidas no período, do ano e de anos anteriores.
	measure 'Anuidades no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= inicio, 'Receitas'[Mês] <= fim, KEEPFILTERS('Receitas'[Tipo] = "Anuidades")) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: ce0a21dd-b7cb-575f-8da6-2835c3cf6276

	/// Soma o recebido da dívida ativa no período.
	measure 'Recebido da dívida ativa' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= inicio, 'Receitas'[Mês] <= fim, KEEPFILTERS('Receitas'[Tipo] = "Dívida ativa")) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 3c14bb7a-a693-5e20-bd53-2bb25738a1e1

	/// Soma a receita dos 12 meses terminados no mês da data.
	measure 'Receita em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= EDATE(fim, -11), 'Receitas'[Mês] <= fim) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 6e91080f-1994-558d-bd38-eb17c9239c16

	/// Divide a receita de 12 meses pelos profissionais ativos de SP no Confea.
	measure 'Receita por profissional ativo' = DIVIDE([Receita em 12 meses], [Profissionais ativos em SP])
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 3a086c6c-9661-5dde-882b-7194ac837313

	/// Soma a receita de cada ano do eixo, até o mês da data no ano dela.
	measure 'Receita no ano' = ```
			VAR d = [Data escolhida]
			VAR ano = MAX('Calendário'[Ano])
			RETURN IF(ano <= YEAR(d), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(ano, 1, 1), 'Receitas'[Mês] <= MIN(DATE(ano, 12, 1), DATE(YEAR(d), MONTH(d), 1))) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 82c08958-0dc6-5dd6-81b7-5bb0cc2d9a6f

	/// Soma as taxas de ART de cada ano do eixo, até o mês da data no ano dela.
	measure 'Receita de ART no ano' = ```
			VAR d = [Data escolhida]
			VAR ano = MAX('Calendário'[Ano])
			RETURN IF(ano <= YEAR(d), CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(ano, 1, 1), 'Receitas'[Mês] <= MIN(DATE(ano, 12, 1), DATE(YEAR(d), MONTH(d), 1)), KEEPFILTERS('Receitas'[Tipo] = "ART")) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: bee9f284-6fd1-5aba-b6ab-21ec2ecbb591

	/// Mostra a parte da ART na receita de cada ano do eixo.
	measure 'Parte da ART no ano' = DIVIDE([Receita de ART no ano], [Receita no ano])
		formatString: 0.0%
		displayFolder: Receita
		lineageTag: 927e3a43-026e-550d-b48a-83db8547c4da

	/// Soma a receita realizada em cada mês, nos meses do gráfico.
	measure 'Receita no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(SUM('Receitas'[Valor]), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: a8e8e49c-5446-591a-8837-66f4d7db66eb

	/// Soma a receita realizada de cada mês de cada ano, até o mês da data, para a matriz de ano por mês.
	measure 'Receita de cada mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			RETURN IF(HASONEVALUE('Calendário'[Mês]) && mes <= d, SUM('Receitas'[Valor]))
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 12a9ddff-1f64-5635-9092-40875198b416

	/// Soma a receita orçada para o ano da data, com as reformulações, por tipo.
	measure 'Receita orçada no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Orçamento'[Atual]), 'Orçamento'[Natureza] = "Receita", 'Orçamento'[Ano] = YEAR(d), TREATAS(VALUES('Tipos de receita'[Tipo]), 'Orçamento'[Grupo])) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: 6245d5e8-b5a8-564e-9e5e-5ba06e709509

	/// Soma a receita realizada de janeiro até o mês da data, por tipo.
	measure 'Receita realizada no ano' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(YEAR(d), 1, 1), 'Receitas'[Mês] <= mes) + 0
			```
		formatString: R$ #,##0
		displayFolder: Receita
		lineageTag: ede2d967-47bb-5f95-9391-dfcf84916234

	/// Soma as anuidades de profissionais e os boletos de empresas vencidos e não pagos na data escolhida, até cinco anos depois do vencimento (depois disso, prescrevem).
	measure 'Anuidades vencidas' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d)
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 06e1d317-e632-550d-b1bf-dc1f881e862c

	/// Conta os profissionais e as empresas com anuidade vencida e não paga na data escolhida.
	measure 'Devedores de anuidade' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(DISTINCTCOUNT('Foto da dívida'[Devedor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Dívida e cobrança
		lineageTag: c96141c5-4d30-5963-913f-698d13d97ae4

	/// Soma as anuidades vencidas de profissionais na data escolhida.
	measure 'Anuidades vencidas de profissionais' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Tipo de devedor] = "Profissional"))
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: fb06d62f-ca9c-50e1-bda7-9ce7142daf62

	/// Soma os boletos vencidos de empresas na data escolhida. Com a situação do CNPJ na Receita Federal, mostra quanto é de empresa baixada ou inapta, com pouca chance de pagar.
	measure 'Anuidades vencidas de empresas' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Tipo de devedor] = "Empresa"))
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 4320284e-ed80-5978-8c80-13a681be4c99

	/// Soma a dívida dos devedores que, somando todas as anuidades vencidas, ficam abaixo do piso de execução.
	measure 'Vencidas abaixo do piso' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Acima do piso] = 0))
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 93082499-ad7b-51c7-9313-85718225ed9c

	/// Soma a dívida dos devedores que somam o piso de execução ou mais.
	measure 'Vencidas acima do piso' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Acima do piso] = 1))
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: f908cf72-d2c9-5d78-bcf4-490a38904ed1

	/// Mostra a parte da dívida que é de devedores abaixo do piso de execução: só pode ser cobrada fora da Justiça.
	measure 'Abaixo do piso de execução' = DIVIDE([Vencidas abaixo do piso], [Anuidades vencidas])
		formatString: 0.0%
		displayFolder: Dívida e cobrança
		lineageTag: 5f77a3ae-feb2-5378-bfbf-4bb672d97f61

	/// Soma as anuidades vencidas há mais de quatro anos na data escolhida: prescrevem em menos de um ano (Código Tributário Nacional, art. 174).
	measure 'Perto de prescrever' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Perto de prescrever]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d)
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 93c7a9ba-375d-55ac-87c0-21e26b1aae27

	/// Conta os devedores com ao menos uma anuidade vencida há mais de quatro anos.
	measure 'Devedores perto de prescrever' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(DISTINCTCOUNT('Foto da dívida'[Devedor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Perto de prescrever] > 0))
			```
		formatString: #,##0
		displayFolder: Dívida e cobrança
		lineageTag: b6c20fe9-dcc2-5a23-a25e-d1a14f117a34

	/// Soma a dívida vencida e não paga no dia anterior ao início do período.
	measure 'Dívida no início do período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR x = inicio - 1
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Vencimento] < x, 'Títulos'[Vencimento] >= x - 1826, ISBLANK('Títulos'[Pago em]) || 'Títulos'[Pago em] > x) + 0
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: acb98f64-0f9a-5386-90b3-eecc55d8c1b1

	/// Soma as anuidades e os boletos que venceram no período sem ser pagos no vencimento.
	measure 'Novos vencimentos no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Vencimento] >= inicio - 1, 'Títulos'[Vencimento] < d, FILTER('Títulos', ISBLANK('Títulos'[Pago em]) || 'Títulos'[Pago em] > 'Títulos'[Vencimento])) + 0
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 0d4fe105-195d-5363-b7fd-907dabe76296

	/// Soma o que foi pago no período depois do vencimento, antes da prescrição.
	measure 'Recebido da dívida no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Pago em] >= inicio, 'Títulos'[Pago em] <= d, 'Títulos'[Dias até o pagamento] > 0, 'Títulos'[Dias até o pagamento] <= 1826) + 0
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 0e910cfc-8354-56b6-8284-5a247ae5abe9

	/// Soma a dívida que completou cinco anos do vencimento no período sem ser paga: prescreveu.
	measure 'Prescrito no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUM('Títulos'[Valor]), 'Títulos'[Vencimento] >= inicio - 1 - 1826, 'Títulos'[Vencimento] < d - 1826, ISBLANK('Títulos'[Pago em]) || 'Títulos'[Pago em] > d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 62eac94a-9e10-5230-9f3f-f76258419d89

	/// Mostra quanto do que estava vencido no início do período, mais o que venceu nele, foi recebido no período.
	measure 'Recebido da dívida' = DIVIDE([Recebido da dívida no período], [Dívida no início do período] + [Novos vencimentos no período])
		formatString: 0.0%
		displayFolder: Dívida e cobrança
		lineageTag: e618f287-639b-55d1-8196-c90fcf26df2c

	/// Soma a dívida dos devedores acima do piso com anuidade vencida há um ano ou mais: a que pode ir a protesto.
	measure 'Anuidade protestável' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da dívida'[Valor]), REMOVEFILTERS('Calendário'), 'Foto da dívida'[Data] = d, KEEPFILTERS('Foto da dívida'[Protestável] = 1))
			```
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: a86e1e7e-f0c8-54d8-a3c8-8be6ef7ec805

	/// Mostra o valor protestado em cada categoria: a anuidade protestável vezes o fator da categoria (demonstrativo).
	measure Protestado = SUMX(VALUES('Categorias de protesto'[Categoria]), CALCULATE(MAX('Categorias de protesto'[Fator por milhão]))) / 1000000 * [Anuidade protestável]
		formatString: R$ #,##0
		displayFolder: Dívida e cobrança
		lineageTag: c0b099e5-8ac4-5e33-8c12-ffcdf811926e

	/// Conta os profissionais com registro ativo na data escolhida, pelo município onde moram.
	measure 'Profissionais ativos' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da adimplência'[Ativos]), REMOVEFILTERS('Calendário'), 'Foto da adimplência'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 743b0c09-25a5-5c43-b5c9-c931f776217e

	/// Conta os profissionais ativos com anuidade em atraso na data escolhida.
	measure 'Profissionais em atraso' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto da adimplência'[Em atraso]), REMOVEFILTERS('Calendário'), 'Foto da adimplência'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Dívida e cobrança
		lineageTag: 47f2759f-d37d-5685-9dd9-39b7b04404b6

	/// Mostra a parte dos profissionais ativos sem anuidade em atraso na data escolhida.
	measure 'Profissionais em dia' = DIVIDE([Profissionais ativos] - [Profissionais em atraso], [Profissionais ativos])
		formatString: 0.0%
		displayFolder: Dívida e cobrança
		lineageTag: be1a337d-e3cd-533b-a9ab-2265f5cbeeba

	/// Soma a despesa empenhada nos meses do período, terminados no mês da data.
	measure 'Despesa no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= inicio, 'Despesas'[Mês] <= fim) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 48ce02ce-537f-5a60-bb3b-d74669409be5

	/// Soma a despesa empenhada de janeiro até o mês da data.
	measure 'Despesa realizada no ano' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(YEAR(d), 1, 1), 'Despesas'[Mês] <= mes) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 9bf6c7f7-92be-50bd-ac75-962f9762c4e8

	/// Soma a despesa orçada para o ano da data, com as reformulações.
	measure 'Despesa orçada no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Orçamento'[Atual]), 'Orçamento'[Natureza] = "Despesa", 'Orçamento'[Ano] = YEAR(d)) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 439993f8-2c9e-5d46-b643-4000717947b5

	/// Mostra quanto do orçamento de despesa do ano já foi empenhado até o mês da data.
	measure 'Execução do orçamento no ano' = DIVIDE([Despesa realizada no ano], [Despesa orçada no ano])
		formatString: 0.0%
		displayFolder: Orçamento e despesa
		lineageTag: 36659d33-3b7c-5499-8f64-c94b10440cdc

	/// Subtrai a despesa empenhada da receita realizada no período.
	measure 'Receita menos despesa no período' = [Receita no período] - [Despesa no período]
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: a146a275-9e93-5aab-9cc2-d2ed1ad5e642

	/// Compara o resultado com os mesmos meses um ano antes, sobre o valor absoluto de um ano antes, porque o resultado pode ser negativo.
	measure 'Variação em um ano: Receita menos despesa no período' = ```
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Receita menos despesa no período]
			VAR antes = CALCULATE([Receita menos despesa no período], 'Datas das fotos'[Data] = alvo)
			RETURN IF(antes <> 0, DIVIDE(agora - antes, ABS(antes)))
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Orçamento e despesa
		lineageTag: 1382cfc9-0113-5fdf-a906-e6d1dc0a02e2

	/// Soma a despesa de diárias, passagens e deslocamento empenhada no período.
	measure 'Diárias e deslocamento no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= inicio, 'Despesas'[Mês] <= fim, KEEPFILTERS('Despesas'[Grupo] = "Diárias e deslocamento")) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: ffcc13bd-d9ff-56e7-930c-5eb539708cc4

	/// Soma o pago a cada pessoa em diárias, jetons e deslocamento no período, pelos pagamentos da Transparência.
	measure 'Diárias no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Diárias'[Valor]), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= fim) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: a8a4c326-bb41-5668-844e-753e085c5fe5

	/// Conta os pagamentos de diária, jeton e deslocamento no período.
	measure 'Pagamentos de diária no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Diárias'[Pagamentos]), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= fim) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 58a206d9-6b17-52fb-bcc3-ca1135eece18

	/// Conta os meses do período em que a pessoa recebeu.
	measure 'Meses com diária' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Mês]), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= fim) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 072a961e-b2c2-56a0-a032-5316671c34b1

	/// Conta as pessoas que receberam diária, jeton ou deslocamento no período.
	measure 'Pessoas com diária no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(DISTINCTCOUNT('Diárias'[Pessoa]), 'Diárias'[Mês] >= inicio, 'Diárias'[Mês] <= fim, 'Diárias'[Valor] > 0) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 9cd3934e-742b-5350-ab47-4be653b060ff

	/// Soma o pago a conselheiros (diárias e jetons) no período.
	measure 'Diárias de conselheiros no período' = CALCULATE([Diárias no período], 'Pessoas'[Categoria] IN {"Conselheiros", "Jetons"})
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: a9cf47bb-233b-5c19-93fd-1d937f658354

	/// Soma o pago a cada fornecedor no período.
	measure 'Pago no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			VAR fim = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Pagamentos'[Valor]), 'Pagamentos'[Mês] >= inicio, 'Pagamentos'[Mês] <= fim) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 3b1e7f5c-1d7a-5342-b0b3-cb749646a4b1

	/// Conta os contratos em vigor na data escolhida.
	measure 'Contratos vigentes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Contratos'), 'Contratos'[Início] <= d, 'Contratos'[Fim] > d) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: fdfefbea-f508-5b10-a4ed-44a280877fd1

	/// Soma o valor dos contratos em vigor na data escolhida.
	measure 'Valor dos contratos vigentes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Contratos'[Valor]), 'Contratos'[Início] <= d, 'Contratos'[Fim] > d) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 194263a2-7ecc-59a4-bf5d-37ead00ef4a9

	/// Conta os contratos vigentes que terminam nos três meses seguintes à data escolhida.
	measure 'Contratos que terminam em 90 dias' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Contratos'), 'Contratos'[Início] <= d, 'Contratos'[Fim] > d, 'Contratos'[Fim] <= EDATE(d, 3)) + 0
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: ec5e6b71-c79e-5917-9b93-b5892b32eeb0

	/// Conta os contratos vigentes na data escolhida que terminam em cada um dos 12 meses seguintes, a começar pelo mês dela.
	measure 'Contratos que terminam no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR primeiro = DATE(YEAR(d), MONTH(d), 1)
			RETURN IF(mes >= primeiro && mes <= EDATE(primeiro, 11), CALCULATE(COUNTROWS('Contratos'), 'Contratos'[Início] <= d, 'Contratos'[Fim] > d, 'Contratos'[Fim] >= mes, 'Contratos'[Fim] <= EOMONTH(mes, 0)) + 0)
			```
		formatString: #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 806ee474-bbec-5d1e-94f3-6a3c96a76afd

	/// Soma a despesa empenhada de janeiro até cada mês do ano da data, até o mês dela.
	measure 'Despesa realizada acumulada no ano' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d)
			RETURN IF(m <= MONTH(d), CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: e40ce00c-3943-5cce-9258-b584489147a7

	/// Soma a despesa empenhada de janeiro até cada mês do ano anterior ao da data.
	measure 'Despesa realizada acumulada no ano anterior' = ```
			VAR d = [Data escolhida]
			VAR m = MAX('Calendário'[Mês do ano])
			VAR ano = YEAR(d) - 1
			RETURN IF(TRUE(), CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= DATE(ano, m, 1)) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 4b1f6b2c-6627-5042-8790-5ee41661c2a5

	/// Divide o orçamento de despesa do ano em doze partes iguais e acumula até cada mês, a linha tracejada do painel.
	measure 'Ritmo do orçado' = ```
			VAR m = MAX('Calendário'[Mês do ano])
			RETURN [Despesa orçada no ano] * m / 12
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: cc9544c6-d412-56cc-9ddd-113e4b9665ab

	/// Soma a despesa orçada para o ano da data, com as reformulações, por grupo.
	measure 'Orçado do grupo no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Orçamento'[Atual]), 'Orçamento'[Natureza] = "Despesa", 'Orçamento'[Ano] = YEAR(d), TREATAS(VALUES('Grupos de despesa'[Grupo]), 'Orçamento'[Grupo])) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 61b65df5-19cb-52d3-b60f-e0fd5bc7070e

	/// Soma a despesa empenhada de janeiro até o mês da data, por grupo.
	measure 'Realizado do grupo no ano' = ```
			VAR d = [Data escolhida]
			VAR mes = DATE(YEAR(d), MONTH(d), 1)
			RETURN CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(YEAR(d), 1, 1), 'Despesas'[Mês] <= mes) + 0
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 147a1eee-0d16-5b94-ad2f-9cc63545a2f7

	/// Soma a despesa de cada ano do eixo, até o mês da data no ano dela.
	measure 'Despesa no ano' = ```
			VAR d = [Data escolhida]
			VAR ano = MAX('Calendário'[Ano])
			RETURN IF(ano <= YEAR(d), CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= MIN(DATE(ano, 12, 1), DATE(YEAR(d), MONTH(d), 1))) + 0)
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 219e2da8-567d-53ce-b911-f4904f1f805b

	/// Subtrai a despesa da receita de cada ano do eixo.
	measure 'Resultado no ano' = [Receita no ano] - [Despesa no ano]
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 14fe3402-5abf-5694-bc59-4a0ab0667fed

	/// Divide a despesa do último ano fechado pelos profissionais ativos de SP no Confea.
	measure 'Despesa por profissional ativo' = ```
			VAR d = [Data escolhida]
			VAR ano = YEAR(d) - 1
			RETURN DIVIDE(CALCULATE(SUM('Despesas'[Valor]), REMOVEFILTERS('Calendário'), 'Despesas'[Mês] >= DATE(ano, 1, 1), 'Despesas'[Mês] <= DATE(ano, 12, 1)), [Profissionais ativos em SP])
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: 2e57b63c-bc1d-5dc6-8598-53f473889a57

	/// Divide a receita do último ano fechado pelos profissionais ativos de SP no Confea.
	measure 'Receita por profissional ativo no ano fechado' = ```
			VAR d = [Data escolhida]
			VAR ano = YEAR(d) - 1
			RETURN DIVIDE(CALCULATE(SUM('Receitas'[Valor]), REMOVEFILTERS('Calendário'), 'Receitas'[Mês] >= DATE(ano, 1, 1), 'Receitas'[Mês] <= DATE(ano, 12, 1)), [Profissionais ativos em SP])
			```
		formatString: R$ #,##0
		displayFolder: Orçamento e despesa
		lineageTag: b3772777-f5d4-53c9-8b41-a1ef5d579a9e

	/// Compara o cartão com o mesmo número de meses terminados no fim do mesmo mês um ano antes.
	measure 'Variação em um ano: Arrecadado no mês' = ```
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Arrecadado no mês]
			VAR antes = CALCULATE([Arrecadado no mês], 'Datas das fotos'[Data] = alvo)
			RETURN IF(antes > 0, DIVIDE(agora - antes, antes))
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Arrecadação
		lineageTag: b5434091-fa4b-58fb-9c9a-83e91ccbc160

	/// Escreve a comparação que o cartão mostra embaixo do número.
	measure 'Comparação: Arrecadado no mês' = ```
			VAR v = [Variação em um ano: Arrecadado no mês]
			RETURN IF(ISBLANK(v), "sem comparação", FORMAT(v, "+0.0%;-0.0%;0.0%") & " em relação a um ano antes")
			```
		displayFolder: Arrecadação
		lineageTag: 705c3dad-7df4-5d1b-b3ff-c775fb1c2058

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Arrecadado no mês' = FORMAT(DIVIDE([Arrecadado no mês], [Meta do mês]), "0.0%") & " da meta do mês, de " & FORMAT([Meta do mês], "R$ #,##0")
		displayFolder: Arrecadação
		lineageTag: 11fb0e46-cb00-5a00-80be-f3ee51f8adbd

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
