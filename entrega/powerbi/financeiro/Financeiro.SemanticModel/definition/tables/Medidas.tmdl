	/// Escreve a comparação que o cartão mostra embaixo do número.
	measure 'Comparação: Despesa em 12 meses' = ```
			VAR v = [Variação em um ano: Despesa em 12 meses]
			RETURN IF(ISBLANK(v), "sem comparação", FORMAT(v, "+0.0%;-0.0%;0.0%") & " em relação aos 12 meses anteriores")
			```
		displayFolder: Orçamento e despesa
		lineageTag: 1299e567-4214-53e9-92d8-8dff962659ea

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Despesa em 12 meses' = IF(ISCROSSFILTERED('Regionais'), "só a despesa lançada na regional escolhida", "sede e regionais")
