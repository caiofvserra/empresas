	measure 'Detalhe: Execução do orçamento no ano' = FORMAT([Despesa realizada no ano], "R$ #,##0") & " realizados de " & FORMAT([Despesa orçada no ano], "R$ #,##0") & " orçados até o mês da data"
		displayFolder: Orçamento e despesa
