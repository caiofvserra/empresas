/// Tem os contratos do Conselho, com a vigência, o valor e os aditivos.
table Contratos
	lineageTag: da106401-fb1b-5c5b-a5a0-4c9992bce384

	column Contrato
		dataType: string
		summarizeBy: none
		sourceColumn: Contrato
		lineageTag: bfee64c6-13e5-58b8-8df5-b4bea3897a0d

	column Fornecedor
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Fornecedor
		lineageTag: 8ad62131-deef-51d3-92ea-2dc9938ae3ca

	column 'Nome do fornecedor'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome do fornecedor
		lineageTag: e5d4c253-0cba-5ae9-91f0-88ab2060b484

	column Objeto
		dataType: string
		summarizeBy: none
		sourceColumn: Objeto
		lineageTag: 48510237-0d30-53f5-a6e7-816f11ce049c

	column Modalidade
		dataType: string
		summarizeBy: none
		sourceColumn: Modalidade
		lineageTag: 81114d8e-637f-5068-8d92-b9360554cad9

	column 'Início'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Início
		lineageTag: 6f3c7d29-d1e9-5ceb-9870-55418cf0416e

	column Fim
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Fim
		lineageTag: e2bfe872-e4b6-53a8-8742-2d4a8ceded67

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 5ca47e0c-eef5-5282-be31-13244c1906e1

	column Aditivos
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Aditivos
		lineageTag: 89327e93-3032-5b9d-9cf5-894b56b3b148

	partition Contratos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "contratos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Contrato", type text}, {"Fornecedor", type text}, {"Nome do fornecedor", type text}, {"Objeto", type text}, {"Modalidade", type text}, {"Início", type date}, {"Fim", type date}, {"Valor", type number}, {"Aditivos", Int64.Type}}, "pt-BR")
				in
				    Tipos
