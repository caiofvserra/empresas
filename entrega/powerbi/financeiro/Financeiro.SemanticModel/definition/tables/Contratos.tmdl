/// Tem os contratos do Crea-SP publicados na Transparência, com a contratada, o CNPJ, o valor e a vigência.
table Contratos
	lineageTag: da106401-fb1b-5c5b-a5a0-4c9992bce384

	column Contrato
		dataType: string
		summarizeBy: none
		sourceColumn: Contrato
		lineageTag: bfee64c6-13e5-58b8-8df5-b4bea3897a0d

	column Contratada
		dataType: string
		summarizeBy: none
		sourceColumn: Contratada
		lineageTag: c140e3d3-ecb2-5d19-bea3-addb0101750c

	column CNPJ
		dataType: string
		summarizeBy: none
		sourceColumn: CNPJ
		lineageTag: d37bb679-1a9c-59c3-9b79-b4a15967d4d2

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 5ca47e0c-eef5-5282-be31-13244c1906e1

	column 'Início'
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Início
		lineageTag: 6f3c7d29-d1e9-5ceb-9870-55418cf0416e

	column Fim
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Fim
		lineageTag: e2bfe872-e4b6-53a8-8742-2d4a8ceded67

	partition Contratos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "contratos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Contrato", type text}, {"Contratada", type text}, {"CNPJ", type text}, {"Valor", type number}, {"Início", type date}, {"Fim", type date}}, "pt-BR")
				in
				    Tipos
