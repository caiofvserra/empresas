/// Tem as 150 empresas que mais receberam do Crea-SP nos últimos 37 meses (sem a folha e a cota-parte), pela razão social e o CNPJ, com o objeto mais frequente.
table Fornecedores
	lineageTag: 9274f413-8851-53c9-bf29-a01b3dddba98

	column Fornecedor
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Fornecedor
		lineageTag: d32098b1-8434-51df-a8eb-a919ebed7ffc

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome
		lineageTag: 926c9f57-e9d6-50b9-825e-f1df014853be

	column CNPJ
		dataType: string
		summarizeBy: none
		sourceColumn: CNPJ
		lineageTag: de5ac9f9-0c0b-585f-b3f3-73d1ea28139c

	column Objeto
		dataType: string
		summarizeBy: none
		sourceColumn: Objeto
		lineageTag: 341b01b7-1727-5479-bec7-5bdfba3095b2

	partition Fornecedores = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "fornecedores.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Fornecedor", type text}, {"Nome", type text}, {"CNPJ", type text}, {"Objeto", type text}}, "pt-BR")
				in
				    Tipos
