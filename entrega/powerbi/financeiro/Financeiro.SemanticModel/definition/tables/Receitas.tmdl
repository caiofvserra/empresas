/// Guarda a receita realizada de cada mês desde 2013, por tipo, da Transparência do Crea-SP (dado real, do estado inteiro).
table Receitas
	lineageTag: f0b1bc88-f477-5a6a-95c6-8150d6c4370b

	column 'Mês'
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: 6b25220f-b5bb-5059-9518-3fd7bb5e7e74

	column Tipo
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Tipo
		lineageTag: 128167cf-7aca-59a9-a04d-66e7f9cc38ee

	column Valor
		dataType: double
		formatString: R$ #,##0
		isHidden
		summarizeBy: none
		sourceColumn: Valor
		lineageTag: 6d2449f1-6b8f-5adf-80db-41d93732b38e

	partition Receitas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "receitas.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Tipo", type text}, {"Valor", type number}}, "pt-BR")
				in
				    Tipos
