/// Tem um mês por linha, de 2013 (o primeiro ano da Transparência) até 12 meses depois de hoje, para os gráficos mês a mês e ano a ano e os contratos que terminam.
table 'Calendário'
	lineageTag: 48c00a4a-8921-5f48-a6a0-d1e2832f5d85

	column 'Mês'
		dataType: dateTime
		formatString: mmm/yy
		summarizeBy: none
		sourceColumn: Mês
		lineageTag: e15b738d-cf44-514b-9d02-8a85d69af606

	column 'Rótulo'
		dataType: string
		summarizeBy: none
		sourceColumn: Rótulo
		sortByColumn: 'Mês'
		lineageTag: 421799d2-5aa5-5138-9b82-b91ab110e447

	column Ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Ano
		lineageTag: 11f28871-bea2-52cf-8b17-6aa91f956a4a

	column 'Mês do ano'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Mês do ano
		lineageTag: 79014eea-9194-5c18-868b-19c2407fd65b

	column 'Nome do mês'
		dataType: string
		summarizeBy: none
		sourceColumn: Nome do mês
		sortByColumn: 'Mês do ano'
		lineageTag: e98524db-0612-56ad-bb0c-011363a88508

	column Ordem
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem
		lineageTag: 16775f04-1d0b-5e2a-b2a8-7dfc6e07b25f

	partition 'Calendário' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "calendario.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Mês", type date}, {"Rótulo", type text}, {"Ano", Int64.Type}, {"Mês do ano", Int64.Type}, {"Nome do mês", type text}, {"Ordem", Int64.Type}}, "pt-BR")
				in
				    Tipos
