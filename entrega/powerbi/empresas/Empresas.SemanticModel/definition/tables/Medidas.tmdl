	/// Conta os estabelecimentos com atividade da lista abertos em cada mês que já têm registro ou visto na data escolhida.
	measure 'Abertas no mês já registradas' = ```
			VAR d = [Data escolhida]
			VAR receita = CALCULATE(MAX('Estabelecimentos'[Mês de abertura]), REMOVEFILTERS(), 'Estabelecimentos'[Aberto em] <= d)
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR m = MAX('Calendário'[Mês])
			RETURN IF(m >= inicio && m <= d && m <= receita, CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[Registro ativo] = 1, 'Estabelecimentos'[Classe] <> "") + 0)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 8576fc45-e87a-590f-9ca5-341dd01b7e48

	/// Conta os estabelecimentos com atividade da lista abertos em cada mês que não têm registro na data escolhida.
	measure 'Abertas no mês sem registro' = ```
			VAR d = [Data escolhida]
			VAR receita = CALCULATE(MAX('Estabelecimentos'[Mês de abertura]), REMOVEFILTERS(), 'Estabelecimentos'[Aberto em] <= d)
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR m = MAX('Calendário'[Mês])
			RETURN IF(m >= inicio && m <= d && m <= receita, CALCULATE(COUNTROWS('Estabelecimentos'), 'Estabelecimentos'[Classe] <> "") - CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[Registro ativo] = 1, 'Estabelecimentos'[Classe] <> "") + 0)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: f237cc41-9385-578b-8229-fd69d1a2f704

	/// Conta as entradas de cada mês, nos meses do gráfico.
	measure 'Entradas no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Entradas e saídas'), 'Entradas e saídas'[Tipo] = "Entrada") + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 8e1e0873-a6e1-5e55-bffe-1c5be228b2a2

	/// Conta as empresas que fizeram o primeiro registro no Crea-SP em cada mês (ou trimestre), nos meses do gráfico.
	measure 'Primeiros registros no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('Entradas e saídas'), 'Entradas e saídas'[Tipo] = "Entrada", 'Entradas e saídas'[Primeira vez] = 1) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
