	/// Conta, entre as registradas com RT, aquelas cujo profissional do vínculo vigente está com o registro cancelado ou interrompido na data escolhida.
	measure 'RT com registro profissional cancelado ou interrompido' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[Registrada] = 1, 'Foto das empresas'[RT cancelado ou interrompido] = 1)
