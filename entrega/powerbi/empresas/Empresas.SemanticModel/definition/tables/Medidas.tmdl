	column Medidas
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Medidas
		lineageTag: 4f5ea9cd-d000-5bc3-92c9-4895a718d2d4

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [#"Medidas" = type text], {})
				in
				    Fonte
