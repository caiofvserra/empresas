	measure 'Comparação: Registradas sem nenhuma ART' = ```
			VAR v = [Variação em um ano: Registradas sem nenhuma ART]
			RETURN IF(ISBLANK(v), "sem comparação", FORMAT(v, "+0.0;-0.0;0.0") & " p.p. em relação a um ano antes")
			```
		displayFolder: RT e ART
		lineageTag: 32cc7493-ff7d-5fb1-b003-238b51dff6b2

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Registradas sem nenhuma ART' = FORMAT([Registradas sem ART no período], "#,##0") & " empresas registradas sem ART no período"
		displayFolder: RT e ART
		lineageTag: f1376a60-dfda-5462-a4d1-b138527bd837

