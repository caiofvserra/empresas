/// Guarda as medidas do painel de Empresas, em pastas por página.
table Medidas
	lineageTag: c28744e1-729b-50a3-af33-7d69edbd8f28

	/// Devolve a data de referência escolhida; sem escolha, a mais recente. As medidas de variação trocam a data pela de um ano antes.
	measure 'Data escolhida' = IF(ISFILTERED('Datas das fotos'[Data]), MAX('Datas das fotos'[Data]), MAX('Datas de referência'[Data]))
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: e2cd791e-60e4-5c14-972c-a10692845e69

	/// Devolve o período escolhido, em meses; sem escolha, 12.
	measure 'Meses do período' = SELECTEDVALUE('Período'[Meses], 12)
		formatString: 0
		displayFolder: Apoio
		lineageTag: 8574d36e-a41f-5798-ad5a-478677226995

	/// Devolve o primeiro dia do primeiro mês do período: o período termina na data escolhida e começa no primeiro dia do mês, como no painel.
	measure 'Início do período' = ```
			VAR d = [Data escolhida]
			RETURN DATE(YEAR(d), MONTH(d) - [Meses do período] + 1, 1)
			```
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: a15af246-ec6a-5030-8836-124ebac3c687

	/// A meta padrão da parte do mercado registrada é 65%, a mesma do painel.
	measure 'Meta da parte do mercado registrada' = 0.65
		formatString: 0.0%
		displayFolder: Apoio
		lineageTag: 7089cce4-e6d5-5466-8492-35ac077c0371

	/// A meta padrão de empresas registradas com responsável técnico é 95%, porque o RT é condição do registro (Lei 5.194/66, art. 8º, parágrafo único).
	measure 'Meta de RT' = 0.95
		formatString: 0.0%
		displayFolder: Apoio
		lineageTag: 4f33e4e6-dd0e-56c4-ba8a-9d9e91fb404d

	/// Conta as empresas, pela raiz do CNPJ, com ao menos um registro ou visto ativo na data escolhida.
	measure 'Empresas registradas' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Registrada]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 5eac6779-5d27-5573-ab72-4de12266e4e2

	/// Conta os CNPJs completos com registro ou visto vigente na data escolhida.
	measure 'Estabelecimentos registrados' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Estabelecimentos registrados]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: fea26860-c2d5-5d92-bbab-6ef830ec1d8f

	/// Conta os vistos vigentes de empresas registradas em outro Crea.
	measure 'Vistos de empresas de fora de SP' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Vistos]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: eb63fe60-a5a2-5206-8495-69c818a9f46f

	/// Conta os estabelecimentos ativos na Receita com atividade da lista do Crea-SP, abertos até a data escolhida.
	measure 'Estabelecimentos no mercado' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[No mercado] = 1)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 3dba5ed3-a8d3-53c5-b717-661b31690f06

	/// Conta os estabelecimentos do mercado com registro ou visto vigente na data escolhida.
	measure 'Estabelecimentos do mercado com registro' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[No mercado] = 1, 'Foto dos estabelecimentos'[Situação no cadastro] = "Com registro ou visto")
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: a19c4129-f543-50ef-a341-0071579ed636

	/// Conta os estabelecimentos do mercado que já tiveram registro, mas não o têm na data escolhida.
	measure 'Estabelecimentos do mercado só com histórico' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[No mercado] = 1, 'Foto dos estabelecimentos'[Situação no cadastro] = "Só teve registro no passado")
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 14f4d736-aa40-5214-a721-fd7e15090e8d

	/// Conta os estabelecimentos do mercado que nunca apareceram no cadastro até a data escolhida.
	measure 'Estabelecimentos do mercado sem registro' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[No mercado] = 1, 'Foto dos estabelecimentos'[Situação no cadastro] = "Nunca apareceu no cadastro")
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: c9324417-d296-57f1-85ed-396f3262d0a4

	/// Mostra a parte dos estabelecimentos do mercado com registro ou visto vigente na data escolhida. Atividade da lista não prova obrigação de registro.
	measure 'Parte do mercado que está registrada' = DIVIDE([Estabelecimentos do mercado com registro], [Estabelecimentos no mercado])
		formatString: 0.0%
		displayFolder: Registro e mercado
		lineageTag: de7154b4-096b-5706-b72d-579cae02e63b

	/// Mostra, em pontos percentuais, quanto a parte do mercado registrada está acima ou abaixo da meta.
	measure 'Distância da meta da parte registrada' = ([Parte do mercado que está registrada] - [Meta da parte do mercado registrada]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Registro e mercado
		lineageTag: 956d2d2e-01c9-55e8-be78-db167d2392f3

	/// Mostra a mesma parte, só nas atividades de registro obrigatório.
	measure 'Parte registrada nas atividades de registro obrigatório' = DIVIDE(CALCULATE([Estabelecimentos do mercado com registro], 'Estabelecimentos'[Classe] = "Registro obrigatório"), CALCULATE([Estabelecimentos no mercado], 'Estabelecimentos'[Classe] = "Registro obrigatório"))
		formatString: 0.0%
		displayFolder: Registro e mercado
		lineageTag: 8fbcfe65-8d4a-5a8f-9e34-ef5dbea13584

	/// Conta os estabelecimentos ativos na Receita com atividade de registro obrigatório que nunca tiveram registro ou visto no Crea-SP. Não estar no cadastro não quer dizer irregular.
	measure 'Atividade obrigatória e nenhum registro' = CALCULATE([Estabelecimentos do mercado sem registro], 'Estabelecimentos'[Classe] = "Registro obrigatório")
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 5f3cad9b-a89d-5531-837a-164398a6c68a

	/// Conta as empresas registradas com anuidade vencida e não paga na data escolhida.
	measure 'Registradas com anuidade vencida' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[Registrada] = 1, 'Foto das empresas'[Anuidade vencida] = 1)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: f9372e8b-40cf-53f1-aa8f-b7e3cbf80af8

	/// Conta as empresas registradas sem anuidade vencida na data escolhida.
	measure 'Registradas sem anuidade vencida' = [Empresas registradas] - [Registradas com anuidade vencida]
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 12a280cd-da8b-5bbf-89ce-3135be87f2b2

	/// Mostra a parte das empresas registradas sem anuidade vencida na data escolhida.
	measure 'Registradas em dia com a anuidade' = DIVIDE([Registradas sem anuidade vencida], [Empresas registradas])
		formatString: 0.0%
		displayFolder: Registro e mercado
		lineageTag: 2d6db8ce-3f6a-5fac-9df1-b89643bd5cd7

	/// Conta as empresas registradas com pendência aberta no cadastro, como atividade não informada, regional não identificada, município diferente do da Receita ou CNPJ baixado.
	measure 'Registradas com cadastro incompleto' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[Registrada] = 1, 'Foto das empresas'[Cadastro incompleto] = 1)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: a8a577cf-13d0-54f9-baf9-608776bd9b8e

	/// Escreve a pendência aberta mais comum entre as registradas e quantas empresas a têm, como a linha de apoio do cartão.
	measure 'Pendência mais comum' = ```
			VAR d = [Data escolhida]
			VAR porTipo = CALCULATETABLE(ADDCOLUMNS(VALUES('Pendências do cadastro'[Pendência]), "Empresas com a pendência", CALCULATE(DISTINCTCOUNT('Pendências do cadastro'[Empresa]))), 'Pendências do cadastro'[Data] = d)
			VAR topo = TOPN(1, porTipo, [Empresas com a pendência], DESC, 'Pendências do cadastro'[Pendência], ASC)
			RETURN IF(COUNTROWS(topo) = 0, "nenhuma pendência aberta", FORMAT(MAXX(topo, [Empresas com a pendência]), "#,##0") & " " & MAXX(topo, 'Pendências do cadastro'[Pendência]))
			```
		displayFolder: Registro e mercado
		lineageTag: 051fae9d-2e28-54c3-ae96-def5e443ec52

	/// Conta as empresas registradas ou com estabelecimento de atividade da lista na Receita na data escolhida: o começo do funil.
	measure 'Empresas do mercado' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[No mercado do funil] = 1)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 73ccd9c8-4f8b-58c2-93a4-76a03ea3dcd1

	/// Conta as empresas do mercado com a situação "registro ativo" na data escolhida.
	measure 'Mercado: registro ativo' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[No mercado do funil] = 1, 'Foto das empresas'[Situação no funil] = "Registro ativo")
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 367f7721-4e50-5cab-80a5-fde9fe4b632c

	/// Conta as empresas do mercado com a situação "registro inativo" na data escolhida.
	measure 'Mercado: registro inativo' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[No mercado do funil] = 1, 'Foto das empresas'[Situação no funil] = "Registro inativo")
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 3f586338-c381-53e6-a12f-072095e00a01

	/// Conta as empresas do mercado com a situação "nunca registrada" na data escolhida.
	measure 'Mercado: nunca registrada' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[No mercado do funil] = 1, 'Foto das empresas'[Situação no funil] = "Nunca registrada")
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: c2294a28-754f-559a-865a-23e04ccef289

	/// Conta as empresas registradas sem responsável técnico de vínculo vigente, como a etapa do funil.
	measure 'Registradas sem RT identificado' = [Empresas registradas] - [Registradas com RT]
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 99699895-0498-5e57-9c6d-855d4241ac7c

	/// Conta as empresas registradas em cada faixa de tempo desde o primeiro registro e de capital social; fica em branco quando a faixa não tem nenhuma.
	measure 'Registradas no tempo e no capital' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto das empresas'), 'Foto das empresas'[Data] = d, 'Foto das empresas'[Registrada] = 1)
			```
		formatString: #,##0
		displayFolder: Registro e mercado
		lineageTag: 2b1668db-ddb6-57fd-9add-c9e3d786a4e2

	/// Conta as empresas que passaram a ter registro ativo no período, pela primeira vez ou de volta depois de uma baixa ou um cancelamento.
	measure 'Empresas que entraram na base' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Entradas e saídas'), 'Entradas e saídas'[Tipo] = "Entrada", 'Entradas e saídas'[Mês] >= inicio, 'Entradas e saídas'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 933dcfad-2eec-503f-a5e2-22e528b40050

	/// Conta as entradas do período em que o primeiro registro da empresa é do próprio mês.
	measure 'Entraram pela primeira vez' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Entradas e saídas'), 'Entradas e saídas'[Tipo] = "Entrada", 'Entradas e saídas'[Mês] >= inicio, 'Entradas e saídas'[Mês] <= d, 'Entradas e saídas'[Primeira vez] = 1) + 0
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 5b0a5dc6-e2ee-55c4-bb8e-23fe53514abd

	/// Conta as entradas de empresas que já tinham tido registro.
	measure Retornos = [Empresas que entraram na base] - [Entraram pela primeira vez]
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 17463cd6-3de0-53f8-a5a3-c16e27f2a2b9

	/// Conta as entradas no mesmo mês em que uma ação de fiscalização de registro da empresa foi regularizada.
	measure 'Entradas após fiscalização' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Entradas e saídas'), 'Entradas e saídas'[Tipo] = "Entrada", 'Entradas e saídas'[Mês] >= inicio, 'Entradas e saídas'[Mês] <= d, 'Entradas e saídas'[Após fiscalização] = 1) + 0
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: b430555e-af4e-5f58-9f3b-d5465a963c45

	/// Conta as empresas cujo registro deixou de estar ativo no período, por baixa ou cancelamento.
	measure 'Empresas que saíram da base' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Entradas e saídas'), 'Entradas e saídas'[Tipo] = "Saída", 'Entradas e saídas'[Mês] >= inicio, 'Entradas e saídas'[Mês] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: fd46219e-3a59-5158-807d-5986d0217273

	/// Mostra quantas empresas entraram a mais do que saíram no período.
	measure 'Entradas menos saídas no período' = [Empresas que entraram na base] - [Empresas que saíram da base]
		formatString: +#,##0;-#,##0;0
		displayFolder: Evolução
		lineageTag: 01a0af18-9bf2-5f16-9d8f-ec4070d349bb

	/// Conta os estabelecimentos com atividade da lista do Crea-SP abertos na Receita no período. O arquivo da Receita chega com atraso: o último mês pode faltar.
	measure 'Empresas de engenharia abertas no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Estabelecimentos'), 'Estabelecimentos'[Classe] <> "", 'Estabelecimentos'[Aberto em] >= inicio, 'Estabelecimentos'[Aberto em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 45532dba-cc7f-563c-8b9d-4472ff72ece3

	/// Conta as abertas no período que têm registro ativo na data escolhida.
	measure 'Abertas no período que já se registraram' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos estabelecimentos'), 'Foto dos estabelecimentos'[Data] = d, 'Foto dos estabelecimentos'[Registro ativo] = 1, 'Estabelecimentos'[Classe] <> "", 'Estabelecimentos'[Aberto em] >= inicio, 'Estabelecimentos'[Aberto em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 0ca0dd1a-8bb4-57b8-8657-b642148bec31

	/// Mostra a parte das abertas no período que já se registrou.
	measure 'Parte das abertas que já se registrou' = DIVIDE([Abertas no período que já se registraram], [Empresas de engenharia abertas no período])
		formatString: 0.0%
		displayFolder: Evolução
		lineageTag: 342366ea-dfbe-5090-8a5d-e972f588bd9f

	/// Conta as empresas que estavam registradas 3 meses antes da data escolhida; é a base da permanência.
	measure 'Registradas 3 meses antes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Registrada 3 meses antes]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 7f8c6722-e801-5bb0-af63-668a712ed243

	/// Conta as registradas 3 meses antes que continuam registradas na data escolhida.
	measure 'Registradas 3 meses antes que continuam' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Continua registrada desde 3 meses]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 109ff117-b26c-5fed-8265-d8af0b384cee

	/// Mostra, das empresas registradas 3 meses antes da data escolhida, a parte que continua registrada. Quem entrou depois não conta.
	measure 'Continuam registradas depois de 3 meses' = DIVIDE([Registradas 3 meses antes que continuam], [Registradas 3 meses antes])
		formatString: 0.0%
		displayFolder: Evolução
		lineageTag: d152b8c2-ab11-5a80-88ea-0e4a9759d09f

	/// Conta as empresas que estavam registradas 6 meses antes da data escolhida; é a base da permanência.
	measure 'Registradas 6 meses antes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Registrada 6 meses antes]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: e2ff0871-8d91-5f77-a518-27393e8c8cf4

	/// Conta as registradas 6 meses antes que continuam registradas na data escolhida.
	measure 'Registradas 6 meses antes que continuam' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Continua registrada desde 6 meses]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 42f6a454-b96c-5b82-aa35-2bcc2dca9251

	/// Mostra, das empresas registradas 6 meses antes da data escolhida, a parte que continua registrada. Quem entrou depois não conta.
	measure 'Continuam registradas depois de 6 meses' = DIVIDE([Registradas 6 meses antes que continuam], [Registradas 6 meses antes])
		formatString: 0.0%
		displayFolder: Evolução
		lineageTag: 76787e71-8a6d-5dc7-a397-0499fd2932b8

	/// Conta as empresas que estavam registradas 12 meses antes da data escolhida; é a base da permanência.
	measure 'Registradas 12 meses antes' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Registrada 12 meses antes]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 3341fb56-a5cc-5278-924b-62ce7c04a85d

	/// Conta as registradas 12 meses antes que continuam registradas na data escolhida.
	measure 'Registradas 12 meses antes que continuam' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Foto das empresas'[Continua registrada desde 12 meses]), 'Foto das empresas'[Data] = d)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 432b2d8b-66c5-5825-984d-ac5355fa73a0

	/// Mostra, das empresas registradas 12 meses antes da data escolhida, a parte que continua registrada. Quem entrou depois não conta.
	measure 'Continuam registradas depois de 12 meses' = DIVIDE([Registradas 12 meses antes que continuam], [Registradas 12 meses antes])
		formatString: 0.0%
		displayFolder: Evolução
		lineageTag: b1e0eb0c-f148-5096-a711-dc8483dd1563

	/// Conta os empregados com carteira em ocupações de engenharia no mês da data escolhida. A fonte, a RAIS (Relação Anual de Informações Sociais) com o Novo CAGED (Cadastro Geral de Empregados e Desempregados), sai em totais por regional.
	measure 'Emprego formal em engenharia' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Emprego formal'[Empregados]), 'Emprego formal'[Mês] = DATE(YEAR(d), MONTH(d), 1))
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: e24682e6-feb0-5970-82a8-6ece8292c371

	/// Soma os empregados com carteira em engenharia no fim de cada mês.
	measure 'Emprego formal no mês' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR receita = CALCULATE(MAX('Estabelecimentos'[Mês de abertura]), REMOVEFILTERS(), 'Estabelecimentos'[Aberto em] <= d)
			VAR m = MAX('Calendário'[Mês])
			RETURN IF(m >= inicio && m <= d, SUM('Emprego formal'[Empregados]))
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 4ae8c673-8208-51a9-9b45-c3fbd456fffa

	/// Mostra a série com o primeiro mês do gráfico igual a 100, para comparar o ritmo de séries com unidades diferentes.
	measure 'Índice: Emprego formal no mês' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR agora = [Emprego formal no mês]
			VAR base = CALCULATE([Emprego formal no mês], REMOVEFILTERS('Calendário'), 'Calendário'[Mês] = inicio)
			RETURN IF(NOT ISBLANK(agora) && base > 0, ROUND(agora / base * 100, 1))
