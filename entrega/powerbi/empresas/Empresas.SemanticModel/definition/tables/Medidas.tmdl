	/// Divide as ARTs de empresas do período pelos profissionais ativos da mesma modalidade na data escolhida, vezes 100. Os profissionais seguem a regional e o município escolhidos; a modalidade sem ART fica de fora.
	measure 'ARTs a cada 100 profissionais ativos' = ```
			VAR d = [Data escolhida]
			VAR arts = [ARTs de empresas]
			VAR ativos = CALCULATE(SUM('Profissionais ativos'[Ativos]), 'Profissionais ativos'[Data] = d)
			RETURN IF(arts > 0 && ativos > 0, arts / ativos * 100)
			```
		formatString: 0.0
		displayFolder: RT e ART
		lineageTag: ace55c3a-584c-5c14-9142-25a254784ddd

	/// Conta as ARTs registradas em cada mês, nos meses do gráfico.
	measure 'ARTs no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('ARTs')) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: RT e ART
		lineageTag: 98f79971-4bcd-55c7-bb22-c7a9ebecc518

	/// Conta as ARTs do mesmo mês um ano antes, para comparar.
	measure 'ARTs no mesmo mês do ano anterior' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1)
			VAR meses = CALCULATE(COUNTROWS('Calendário'), KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d))
			RETURN IF(meses > 0, CALCULATE(CALCULATE(COUNTROWS('ARTs'), REMOVEFILTERS('Calendário'), 'ARTs'[Mês] = EDATE(mes, -12)) + 0, KEEPFILTERS('Calendário'[Mês] >= inicio && 'Calendário'[Mês] <= d)))
			```
		formatString: #,##0
		displayFolder: RT e ART
		lineageTag: f80cca3d-e6d7-5817-81ad-1805ae447efc

	/// ! Demonstração: o bloco depende de acordo com Receita Federal (CPF completo dos sócios). Os números são do cenário e não valem para o Crea-SP. Plano B: O quadro de sócios aberto da Receita mostra o nome completo e seis dígitos do CPF. Comparar nome e dígitos com o cadastro de profissionais, que tem o CPF completo, identifica quase todos os sócios profissionais. Os poucos casos ambíguos ficam como candidatos.
	measure '! Sócios que são profissionais' = CALCULATE(SUM('Parcerias'[Valor]), 'Parcerias'[Bloco] = "Sócios que são profissionais")
		formatString: #,##0
		displayFolder: Vínculos
		lineageTag: 623cde0e-480c-5b98-a8c5-e8866dad85dd

	/// ! Demonstração: o bloco depende de acordo com Receita Federal (CPF completo dos sócios). Os números são do cenário e não valem para o Crea-SP. Plano B: O quadro de sócios aberto da Receita mostra o nome completo e seis dígitos do CPF. Comparar nome e dígitos com o cadastro de profissionais, que tem o CPF completo, identifica quase todos os sócios profissionais. Os poucos casos ambíguos ficam como candidatos.
	measure '! Nome com engenharia e diretoria' = CALCULATE(SUM('Parcerias'[Valor]), 'Parcerias'[Bloco] = "Nome com engenharia e diretoria")
		formatString: #,##0
		displayFolder: Vínculos
		lineageTag: dc82775d-6f08-5c1f-8179-cbf55bc8bb18

	/// Liga pelo CNPJ as fontes abertas da ANEEL (Agência Nacional de Energia Elétrica), da ANP (Agência Nacional do Petróleo), da ANM (Agência Nacional de Mineração) e do BNDES (Banco Nacional de Desenvolvimento Econômico e Social). Os números são do cenário na data de hoje.
	measure 'Usinas, postos, minas e financiamentos' = CALCULATE(SUM('Parcerias'[Valor]), 'Parcerias'[Bloco] = "Usinas, postos, minas e financiamentos")
		formatString: #,##0
		displayFolder: Vínculos
		lineageTag: dde4957d-c85e-5497-a0b8-a7453d3b4f6a

	/// ! Demonstração: o bloco depende de acordo com Ministério do Trabalho (RAIS identificada e eSocial). Os números são do cenário e não valem para o Crea-SP. Plano B: Continuar com o emprego formal em totais por município e ocupação (RAIS e Novo CAGED públicos). Por empresa, não há substituto: o bloco sai do demonstrativo e fica só a leitura regional.
	measure '! Empregados técnicos por empresa' = CALCULATE(SUM('Parcerias'[Valor]), 'Parcerias'[Bloco] = "Empregados técnicos por empresa")
		formatString: #,##0
		displayFolder: Vínculos
		lineageTag: 0bd33e4c-3303-5bee-bd70-63447bab0295

	/// ! Demonstração: o bloco depende de acordo com DETRAN-SP e com INMETRO. Os números são do cenário e não valem para o Crea-SP. Plano B: Coletar as listas de empresas credenciadas que o DETRAN-SP publica no site, por atividade e município, e ligar pelo CNPJ ou pela razão social. Perde-se a validade de cada credenciamento quando a lista não a traz. Coletar as listas públicas de laboratórios e organismos acreditados que o INMETRO mantém no site, com o CNPJ e o escopo. Este é o caso em que o acordo menos faz falta.
	measure '! Credenciadas no DETRAN-SP e no INMETRO' = CALCULATE(SUM('Parcerias'[Valor]), 'Parcerias'[Bloco] = "Credenciadas no DETRAN-SP e no INMETRO")
		formatString: #,##0
		displayFolder: Vínculos
		lineageTag: ef5e606a-9daf-5b18-86a0-2c92da8fc235

	/// ! Demonstração: o bloco depende de acordo com Junta Comercial do Estado de São Paulo (JUCESP). Os números são do cenário e não valem para o Crea-SP. Plano B: Comparar a atividade (CNAE) de cada empresa no arquivo mensal da Receita com a do mês anterior. A inclusão de engenharia aparece com a data aproximada do mês, sem o texto do objeto social.
	measure '! Engenharia incluída no contrato social' = CALCULATE(SUM('Parcerias'[Valor]), 'Parcerias'[Bloco] = "Engenharia incluída no contrato social")
		formatString: #,##0
		displayFolder: Vínculos
		lineageTag: 9bd2871a-a116-516c-acf4-e4823d4fe6f9

	/// Compara o cartão com o fim do mesmo mês um ano antes.
	measure 'Variação em um ano: Empresas registradas' = ```
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Empresas registradas]
			VAR antes = CALCULATE([Empresas registradas], 'Datas das fotos'[Data] = alvo)
			RETURN IF(antes > 0, DIVIDE(agora - antes, antes))
