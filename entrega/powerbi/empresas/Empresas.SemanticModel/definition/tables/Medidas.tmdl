		lineageTag: 4b753869-5970-5d43-a973-d831d09b70f0

	/// Soma o saldo de crédito a empresas de engenharia no fim de cada mês. ! Demonstração: o bloco depende de acordo com Banco Central (crédito em totais). Os números são do cenário e não valem para o Crea-SP. Plano B: Usar a estatística bancária por município (ESTBAN) e o painel de crédito por atividade e estado (SCR.data), ambos públicos e mensais. Perde-se o cruzamento de município com atividade ao mesmo tempo.
	measure '! Crédito a empresas de engenharia no mês' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR receita = CALCULATE(MAX('Estabelecimentos'[Mês de abertura]), REMOVEFILTERS(), 'Estabelecimentos'[Aberto em] <= d)
			VAR m = MAX('Calendário'[Mês])
			RETURN IF(m >= inicio && m <= d, SUM('Crédito'[Saldo]))
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 29b6edee-6995-5964-9367-a946904862b3

	/// Mostra a série com o primeiro mês do gráfico igual a 100, para comparar o ritmo de séries com unidades diferentes.
	measure 'Índice: Crédito a empresas de engenharia no mês !' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR agora = [! Crédito a empresas de engenharia no mês]
			VAR base = CALCULATE([! Crédito a empresas de engenharia no mês], REMOVEFILTERS('Calendário'), 'Calendário'[Mês] = inicio)
			RETURN IF(NOT ISBLANK(agora) && base > 0, ROUND(agora / base * 100, 1))
			```
		formatString: 0.0
		displayFolder: Evolução
		lineageTag: a389b240-51d2-5302-b26c-2418e568ef05

	/// Conta os estabelecimentos com atividade da lista abertos na Receita nos 12 meses até cada mês. A série termina no último mês com arquivo da Receita.
	measure 'Abertas na Receita em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR receita = CALCULATE(MAX('Estabelecimentos'[Mês de abertura]), REMOVEFILTERS(), 'Estabelecimentos'[Aberto em] <= d)
			VAR m = MAX('Calendário'[Mês])
			RETURN IF(m >= inicio && m <= d && m <= receita, CALCULATE(COUNTROWS('Estabelecimentos'), REMOVEFILTERS('Calendário'), 'Estabelecimentos'[Classe] <> "", 'Estabelecimentos'[Mês de abertura] >= EDATE(m, -11), 'Estabelecimentos'[Mês de abertura] <= m) + 0)
			```
		formatString: #,##0
		displayFolder: Evolução
		lineageTag: 0015ef48-3756-5bc6-b04e-ca10e09cf46f

	/// Mostra a série com o primeiro mês do gráfico igual a 100, para comparar o ritmo de séries com unidades diferentes.
	measure 'Índice: Abertas na Receita em 12 meses' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR agora = [Abertas na Receita em 12 meses]
			VAR base = CALCULATE([Abertas na Receita em 12 meses], REMOVEFILTERS('Calendário'), 'Calendário'[Mês] = inicio)
			RETURN IF(NOT ISBLANK(agora) && base > 0, ROUND(agora / base * 100, 1))
