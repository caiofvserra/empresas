	/// Conta os meses do gráfico de economia, do primeiro ao mês da data escolhida.
	measure 'Meses no gráfico da economia' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
