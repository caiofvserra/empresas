	/// Compara o emprego formal do mês da data escolhida com o do primeiro mês do gráfico de economia, como o cartão do painel.
	measure 'Variação do emprego nos meses do gráfico' = ```
			VAR d = [Data escolhida]
			VAR inicio = MAX(DATE(YEAR(d), MONTH(d) - MAX(24, [Meses do período]) + 1, 1), CALCULATE(MIN('Calendário'[Mês]), REMOVEFILTERS('Calendário'), 'Calendário'[Ordem] = 12))
			VAR primeiro = CALCULATE(SUM('Emprego formal'[Empregados]), 'Emprego formal'[Mês] = inicio)
			VAR ultimo = [Emprego formal em engenharia]
			RETURN IF(primeiro > 0, DIVIDE(ultimo - primeiro, primeiro))
			```
