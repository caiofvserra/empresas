/// Tem as nove câmaras especializadas. Escolha uma por vez: as medidas leem a escolha e só a aplicam aos indicadores que o painel de origem divide por câmara.
table 'Câmaras'
	lineageTag: fcfe64aa-bc50-54f0-8d2e-0bb2c2920569

	column 'Câmara'
		dataType: string
		summarizeBy: none
		sourceColumn: Câmara
		sortByColumn: Ordem
		lineageTag: 0ae69dc1-a6ea-50bf-b015-a8899de3085c

	column Ordem
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Ordem
		lineageTag: b082aa54-79fd-5e62-be0a-497c4fa42a07

	partition 'Câmaras' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "camaras.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Câmara", type text}, {"Ordem", Int64.Type}}, "pt-BR")
				in
				    Tipos
