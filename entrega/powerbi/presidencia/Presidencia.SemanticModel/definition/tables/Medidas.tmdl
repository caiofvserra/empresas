/// Guarda as medidas do painel, em pastas por página.
table Medidas
	lineageTag: 80e17cca-ec4a-582c-b471-c762d957dd69

	/// Devolve a data de referência escolhida; sem escolha, hoje. As medidas de variação e as séries trocam a data pela de outro mês.
	measure 'Data escolhida' = IF(ISFILTERED('Datas das fotos'[Data]), MAX('Datas das fotos'[Data]), MAX('Datas de referência'[Data]))
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 81289237-1126-510d-93d7-0defe27ac106

	/// Soma o numerador da foto no recorte, com o jeito de ler de cada indicador (coluna Leitura) e a câmara só onde o indicador divide.
	measure Numerador = ```
			VAR d = [Data escolhida]
			VAR cidade = ISFILTERED('Municípios')
			VAR gre = IF(cidade, SELECTEDVALUE('Municípios'[GRE]), SELECTEDVALUE('Regionais'[GRE]))
			VAR camara = SELECTEDVALUE('Câmaras'[Câmara])
			RETURN SUMX(VALUES('Indicadores'[Indicador]),
			  VAR forma = LOOKUPVALUE('Indicadores'[Leitura], 'Indicadores'[Indicador], 'Indicadores'[Indicador])
			  VAR divide = LOOKUPVALUE('Indicadores'[Divide por câmara], 'Indicadores'[Indicador], 'Indicadores'[Indicador])
			  VAR nivel = SWITCH(forma, "Município", "Município", "Regional", "Regional", "Estado e regional", IF(ISBLANK(gre), "Estado", "Regional"), "Estado")
			  RETURN IF(nivel = "Município",
			    CALCULATE(SUM('Foto'[N]), 'Foto'[Data] = d, 'Foto'[Nível] = "Município", KEEPFILTERS(divide = 0 || ISBLANK(camara) || 'Foto'[Câmara] = camara)),
			    CALCULATE(SUM('Foto'[N]), 'Foto'[Data] = d, 'Foto'[Nível] = nivel, REMOVEFILTERS('Municípios'), REMOVEFILTERS('Regionais'),
			      KEEPFILTERS(nivel = "Estado" || ISBLANK(gre) || 'Foto'[GRE] = gre), KEEPFILTERS(divide = 0 || ISBLANK(camara) || 'Foto'[Câmara] = camara))))
			```
		formatString: #,##0.##
		displayFolder: Apoio
		lineageTag: de4200f0-813f-51c6-9bd3-c5e8243d8313

	/// Soma o denominador da foto no recorte, com a mesma regra do numerador. Só as taxas têm denominador.
	measure Denominador = ```
			VAR d = [Data escolhida]
			VAR cidade = ISFILTERED('Municípios')
			VAR gre = IF(cidade, SELECTEDVALUE('Municípios'[GRE]), SELECTEDVALUE('Regionais'[GRE]))
			VAR camara = SELECTEDVALUE('Câmaras'[Câmara])
			RETURN SUMX(VALUES('Indicadores'[Indicador]),
			  VAR forma = LOOKUPVALUE('Indicadores'[Leitura], 'Indicadores'[Indicador], 'Indicadores'[Indicador])
			  VAR divide = LOOKUPVALUE('Indicadores'[Divide por câmara], 'Indicadores'[Indicador], 'Indicadores'[Indicador])
			  VAR nivel = SWITCH(forma, "Município", "Município", "Regional", "Regional", "Estado e regional", IF(ISBLANK(gre), "Estado", "Regional"), "Estado")
			  RETURN IF(nivel = "Município",
			    CALCULATE(SUM('Foto'[D]), 'Foto'[Data] = d, 'Foto'[Nível] = "Município", KEEPFILTERS(divide = 0 || ISBLANK(camara) || 'Foto'[Câmara] = camara)),
			    CALCULATE(SUM('Foto'[D]), 'Foto'[Data] = d, 'Foto'[Nível] = nivel, REMOVEFILTERS('Municípios'), REMOVEFILTERS('Regionais'),
			      KEEPFILTERS(nivel = "Estado" || ISBLANK(gre) || 'Foto'[GRE] = gre), KEEPFILTERS(divide = 0 || ISBLANK(camara) || 'Foto'[Câmara] = camara))))
			```
		formatString: #,##0.##
		displayFolder: Apoio
		lineageTag: d36c630f-2359-5009-826a-4bd702146124

	/// Mostra o número do indicador do contexto: a taxa é o numerador sobre o denominador; a contagem e o valor são o numerador.
	measure 'Valor do indicador' = ```
			VAR u = SELECTEDVALUE('Indicadores'[Unidade])
			RETURN IF(u = "taxa", DIVIDE([Numerador], [Denominador]), [Numerador])
			```
		formatString: #,##0.##
		displayFolder: Apoio
		lineageTag: 6f773c4b-e7f2-520d-9308-25b3f6505712

	/// Escreve o número do indicador com o formato da unidade, para as tabelas que misturam indicadores.
	measure 'Número' = ```
			VAR u = SELECTEDVALUE('Indicadores'[Unidade])
			VAR v = [Valor do indicador]
			RETURN IF(ISBLANK(v), BLANK(), SWITCH(u, "taxa", FORMAT(v, "0.0%"), "reais", FORMAT(v, "R$ #,##0"), FORMAT(v, "#,##0")))
			```
		displayFolder: Apoio
		lineageTag: 54554068-a012-5752-8239-4b20c5c0c205

	/// Escreve a variação contra o fim do mesmo mês um ano antes: em pontos percentuais nas taxas e em porcentagem nas contagens e nos valores.
	measure 'Em um ano' = ```
			VAR u = SELECTEDVALUE('Indicadores'[Unidade])
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Valor do indicador]
			VAR antes = CALCULATE([Valor do indicador], 'Datas das fotos'[Data] = alvo)
			RETURN IF(ISBLANK(agora) || ISBLANK(antes), BLANK(), IF(u = "taxa", FORMAT((agora - antes) * 100, "+0.0;-0.0;0.0") & " p.p.", IF(antes = 0, BLANK(), FORMAT(DIVIDE(agora - antes, antes), "+0%;-0%;0%"))))
			```
		displayFolder: Apoio
		lineageTag: 401f5e17-8d06-5b85-93ea-841f9cf35c44

	/// Escreve a meta padrão do painel, nos indicadores que têm meta.
	measure 'Meta do painel' = ```
			VAR m = SELECTEDVALUE('Indicadores'[Meta])
			RETURN IF(ISBLANK(m), BLANK(), FORMAT(m, "0%"))
			```
		displayFolder: Apoio
		lineageTag: 75b4faa2-89a7-59ac-a09e-23ca95636487

	/// Mostra a taxa (numerador sobre denominador) do indicador "Parte do mercado registrada" do painel de origem, no recorte e na data escolhidos, com a mesma regra do painel.
	measure 'Parte do mercado registrada' = CALCULATE([Valor do indicador], REMOVEFILTERS('Indicadores'), 'Indicadores'[Indicador] = "mercado")
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: cd1479c3-b083-598d-ad18-7c6b2d73dc4c

	/// Lê o indicador no fim de cada mês do eixo, nos 13 meses até a data escolhida.
	measure 'Parte do mercado registrada no mês' = ```
			VAR m = MAX('Meses da série'[Data])
			VAR d = [Data escolhida]
			RETURN IF(m <= d && m > EOMONTH(d, -13), CALCULATE([Parte do mercado registrada], 'Datas das fotos'[Data] = m))
			```
		formatString: 0.0%
		displayFolder: Séries de 13 meses
		lineageTag: deee984a-d52e-5410-8d23-e9229bcf4843

