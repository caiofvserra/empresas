	/// Soma a receita realizada do último exercício encerrado, pelo Portal da Transparência.
	measure 'Receita do último exercício fechado' = ```
			VAR ano = CALCULATE(MAX('Exercícios'[Ano]), 'Exercícios'[Encerrado] = 1)
			RETURN CALCULATE(SUM('Exercícios'[Receita realizada]), 'Exercícios'[Ano] = ano)
			```
		formatString: R$ #,##0
		displayFolder: No país
		lineageTag: 6f4e1389-a052-5167-89ed-7961d0969982

	/// Compara a receita do último exercício encerrado com a do anterior.
	measure 'Variação da receita contra o exercício anterior' = ```
			VAR ano = CALCULATE(MAX('Exercícios'[Ano]), 'Exercícios'[Encerrado] = 1)
			VAR agora = CALCULATE(SUM('Exercícios'[Receita realizada]), 'Exercícios'[Ano] = ano)
			VAR antes = CALCULATE(SUM('Exercícios'[Receita realizada]), 'Exercícios'[Ano] = ano - 1)
			RETURN IF(antes > 0, DIVIDE(agora - antes, antes))
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: No país
		lineageTag: 6d23b834-afe1-5cca-b7a8-c5cca688b327

	/// Mostra a parte da receita de 2013 a hoje que veio da conta de ART, a maior.
