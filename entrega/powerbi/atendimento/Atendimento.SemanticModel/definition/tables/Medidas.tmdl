/// Guarda as medidas do painel, em pastas por página.
table Medidas
	lineageTag: 7c6e9ebd-159d-574b-a7c0-c675f946a80e

	/// Devolve a data de referência escolhida; sem escolha, a mais recente. As medidas de variação trocam a data pela de um ano antes.
	measure 'Data escolhida' = IF(ISFILTERED('Datas das fotos'[Data]), MAX('Datas das fotos'[Data]), MAX('Datas de referência'[Data]))
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: 1f580bda-a34b-583c-882d-317204628c9b

	/// Devolve o período escolhido, em meses; sem escolha, 12.
	measure 'Meses do período' = SELECTEDVALUE('Período'[Meses], 12)
		formatString: 0
		displayFolder: Apoio
		lineageTag: 0b9807aa-4114-5a90-8d3a-dff2bb0dfed3

	/// Devolve o primeiro dia do primeiro mês do período: o período termina na data escolhida e começa no primeiro dia do mês, como no painel.
	measure 'Início do período' = ```
			VAR d = [Data escolhida]
			RETURN DATE(YEAR(d), MONTH(d) - [Meses do período] + 1, 1)
			```
		formatString: dd/mm/yyyy
		displayFolder: Apoio
		lineageTag: fd2da6aa-cdac-56d8-9b56-304272795945

	/// Guarda a meta padrão de protocolos fechados dentro do prazo do serviço, 80%, a mesma do painel.
	measure 'Meta de fechados no prazo' = 0.8
		formatString: 0.0%
		displayFolder: Apoio
		lineageTag: 32146d2e-2be4-54b4-9d64-c326915fa085

	/// Conta os protocolos abertos no período, como o painel antigo, cada um com a situação na data escolhida.
	measure 'Abertos no período' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 525c6aa3-972c-57dd-8ce7-d33bd310fc9a

	/// Conta os protocolos do período fechados (deferidos, indeferidos ou finalizados) até a data escolhida. O cancelado não entra.
	measure Fechados = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Fechado")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 0ba1f5bd-18e8-5903-bbeb-6155d764c454

	/// Conta os protocolos do período fechados com até o prazo do serviço em dias úteis com o Crea-SP.
	measure 'Fechados dentro do prazo' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Fechado"), KEEPFILTERS('Foto dos protocolos'[Prazo] = "Dentro do prazo")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 019c3bc0-1356-5612-bea5-33c89ae54855

	/// Mostra a parte dos protocolos fechados que fecharam dentro do prazo do serviço, contado em dias úteis só enquanto o protocolo estava com o Crea-SP.
	measure 'Fechados no prazo' = DIVIDE([Fechados dentro do prazo], [Fechados])
		formatString: 0.0%
		displayFolder: Protocolos
		lineageTag: 7466583a-0cf4-5520-8e70-09a2eb8bf061

	/// Mostra a mediana dos dias úteis com o Crea-SP dos protocolos do período fechados até a data escolhida. O tempo com o solicitante, em exigência, não conta.
	measure 'Tempo típico até fechar' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(MEDIAN('Foto dos protocolos'[Dias com o Crea-SP]), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Fechado"))
			```
		formatString: #,##0.#" dias úteis"
		displayFolder: Protocolos
		lineageTag: 7d9d8198-a818-5f2a-9d76-ff9024ff33bb

	/// Conta os protocolos do período em aberto ou em exigência na data escolhida.
	measure 'Em andamento' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] IN {"Aberto", "Exigência"})) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 57f35a7b-9d61-5245-ab18-ea83cac046ee

	/// Conta os protocolos em andamento que já passaram do prazo: em aberto, pelos dias úteis com o Crea-SP; em exigência, pelos 30 dias para responder.
	measure 'Em andamento fora do prazo' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] IN {"Aberto", "Exigência"}), KEEPFILTERS('Foto dos protocolos'[Prazo] = "Fora do prazo")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 261784ba-f176-5b90-b1ad-26c24189f943

	/// Conta os protocolos do período esperando o solicitante responder a uma exigência.
	measure 'Em exigência' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Exigência")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 8c9f1156-5e1c-51fc-a6b0-ea6e968e50b7

	/// Conta os protocolos em exigência há mais de 30 dias corridos.
	measure 'Exigências vencidas' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Exigência"), KEEPFILTERS('Foto dos protocolos'[Prazo] = "Fora do prazo")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: d116d944-1d53-527a-a7ff-409cb28e5e3b

	/// Conta os protocolos do período finalizados porque o solicitante não respondeu à exigência.
	measure 'Finalizados sem resposta' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Status] = "Finalizada sem resposta à exigência")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 8cfe13e2-2394-5f98-8f32-c0fa9f500433

	/// Conta os protocolos do período parados esperando o pagamento da taxa.
	measure 'Sem pagamento' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Sem pagamento")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: c017777b-4c76-5255-906c-5b2330f24e3c

	/// Soma as taxas dos protocolos parados sem pagamento.
	measure 'Taxas sem pagamento' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(SUMX('Foto dos protocolos', RELATED('Protocolos'[Taxa])), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Sem pagamento")) + 0
			```
		formatString: R$ #,##0
		displayFolder: Protocolos
		lineageTag: 51b5d43a-d9b3-5be8-8103-5892943408d9

	/// Conta os protocolos do período cancelados até a data escolhida.
	measure Cancelados = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] = "Cancelado")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: d6b9a229-f72b-5f0b-992c-fcd11975e688

	/// Mostra a média dos dias corridos em exigência, com o solicitante, dos protocolos do período que tiveram exigência.
	measure 'Dias com o solicitante' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(AVERAGE('Foto dos protocolos'[Dias com o solicitante]), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Dias com o solicitante] > 0), KEEPFILTERS('Protocolos'[Motivo da exigência] <> ""))
			```
		formatString: #,##0" dias"
		displayFolder: Protocolos
		lineageTag: c18b4204-2808-5e5a-ad8c-ec4c42670d79

	/// Conta os protocolos do período que tiveram exigência até a data escolhida, pelo motivo.
	measure 'Com exigência' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Já teve exigência] = 1), KEEPFILTERS('Protocolos'[Motivo da exigência] <> "")) + 0
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: 16bcd2d5-65a2-5d17-a2ff-fe0d3a31d886

	/// Conta os protocolos abertos em cada mês, pela situação na data escolhida, nos meses do gráfico: 12, ou o período quando passa disso, até 24.
	measure 'Abertos no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MIN(24, MAX(12, [Meses do período])) + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Foto dos protocolos'), 'Foto dos protocolos'[Data] = d) + 0)
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: e97e1e81-6a42-5217-be71-33691bbc8048

	/// Conta os protocolos abertos no mesmo mês um ano antes, para a linha tracejada do gráfico mês a mês.
	measure 'Abertos no mesmo mês um ano antes' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - MIN(24, MAX(12, [Meses do período])) + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] = EDATE(mes, -12)) + 0)
			```
		formatString: #,##0
		displayFolder: Protocolos
		lineageTag: e58b66e1-3d90-51fb-865f-ec09b61562aa

	/// Conta os protocolos do período em andamento que estão com um colaborador.
	measure 'Na fila' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] IN {"Aberto", "Exigência"}), KEEPFILTERS('Foto dos protocolos'[Atribuído] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: a2e58861-9637-5eb3-9a5a-dd59fa722fda

	/// Conta os protocolos em andamento com um colaborador que já passaram do prazo.
	measure 'Na fila e fora do prazo' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] IN {"Aberto", "Exigência"}), KEEPFILTERS('Foto dos protocolos'[Atribuído] = 1), KEEPFILTERS('Foto dos protocolos'[Prazo] = "Fora do prazo")) + 0
			```
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: c40987df-5629-57e5-95e7-8f573e32e504

	/// Conta os colaboradores com algum protocolo do período no último status.
	measure 'Colaboradores com protocolos' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(DISTINCTCOUNT('Foto dos protocolos'[Pessoa]), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Atribuído] = 1)) + 0
			```
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: ebef9df5-533e-57f7-9bfa-cb7df3e67540

	/// Conta o quadro de atendimento do recorte, pela lotação. Quem está na sede conta na GRE 5. O município escolhido leva à regional dele.
	measure 'Colaboradores no quadro' = IF(ISCROSSFILTERED('Regionais'), CALCULATE(COUNTROWS('Colaboradores'), 'Colaboradores'[No quadro] = 1, TREATAS(VALUES('Regionais'[GRE]), 'Colaboradores'[GRE])), CALCULATE(COUNTROWS('Colaboradores'), 'Colaboradores'[No quadro] = 1)) + 0
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: 9eb7f379-8527-55db-9688-5611b9a3ad22

	/// Conta os protocolos do lugar que fecharam ou foram cancelados nos 12 meses até a data escolhida, abertos em qualquer data.
	measure 'Fechados nos 12 meses' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Foto dos protocolos'[Data] = d, NOT ISBLANK('Foto dos protocolos'[Fechado em]), 'Foto dos protocolos'[Fechado em] >= DATE(YEAR(d), MONTH(d) - 11, 1), 'Foto dos protocolos'[Fechado em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: 855c1967-0eeb-5f59-91f1-bbbfcb52dbd4

	/// Divide os fechados nos 12 meses pelos 12 meses e pelo quadro de atendimento do recorte.
	measure 'Fechados por colaborador' = DIVIDE([Fechados nos 12 meses], 12 * [Colaboradores no quadro])
		formatString: #,##0.0" por mês"
		displayFolder: Equipe e território
		lineageTag: 7ec21500-fed9-50e2-bb25-a828dbff5669

	/// Conta os protocolos do período em aberto ou sem pagamento que nenhum colaborador pegou.
	measure 'Sem atribuição' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] IN {"Aberto", "Sem pagamento"}), KEEPFILTERS('Foto dos protocolos'[Atribuído] = 0)) + 0
			```
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: 176fb36a-0d04-57e8-9426-31a2a40c1663

	/// Conta os protocolos sem atribuição parados no mesmo status há mais de 5 dias úteis.
	measure 'Sem atribuição há mais de 5 dias úteis' = ```
			VAR d = [Data escolhida]
			VAR inicio = [Início do período]
			RETURN CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, KEEPFILTERS('Foto dos protocolos'[Situação] IN {"Aberto", "Sem pagamento"}), KEEPFILTERS('Foto dos protocolos'[Atribuído] = 0), KEEPFILTERS('Foto dos protocolos'[Dias úteis no status] > 5)) + 0
			```
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: c08a39cb-ade9-5641-81e4-4283995ddaea

	/// Mostra a maior fila (protocolos em andamento) de um colaborador. O nome está na linha de apoio.
	measure 'Maior fila de uma pessoa' = IF([Colaboradores com protocolos] > 0, MAXX(VALUES('Colaboradores'[Pessoa]), [Na fila]))
		formatString: #,##0
		displayFolder: Equipe e território
		lineageTag: d72e0859-fdd8-58d7-899d-04c152050594

	/// Mostra a parte dos fechados que fecharam no prazo, pelo trimestre de abertura, nos meses do gráfico mês a mês (12 a 24).
	measure 'Fechados no prazo nos meses do gráfico' = ```
			VAR d = [Data escolhida]
			VAR inicio = DATE(YEAR(d), MONTH(d) - MIN(24, MAX(12, [Meses do período])) + 1, 1)
			VAR fechados = CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, 'Foto dos protocolos'[Situação] = "Fechado")
			RETURN DIVIDE(CALCULATE(COUNTROWS('Foto dos protocolos'), REMOVEFILTERS('Calendário'), 'Foto dos protocolos'[Data] = d, 'Protocolos'[Aberto em] >= inicio, 'Protocolos'[Aberto em] <= d, 'Foto dos protocolos'[Situação] = "Fechado", 'Foto dos protocolos'[Prazo] = "Dentro do prazo"), fechados)
			```
		formatString: 0.0%
		displayFolder: Equipe e território
		lineageTag: 883a08f1-a2b2-5d0f-9d28-a189a2eca11c

	/// Divide os protocolos abertos nos 12 meses até a data pelos dos 12 meses anteriores. Corrige a previsão.
	measure 'Tendência dos protocolos' = ```
			VAR d = [Data escolhida]
			VAR m0 = DATE(YEAR(d), MONTH(d), 1)
			VAR ultimos = CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] >= EDATE(m0, -11), 'Protocolos'[Mês] <= m0) + 0
			VAR anteriores = CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] >= EDATE(m0, -23), 'Protocolos'[Mês] <= EDATE(m0, -12)) + 0
			RETURN IF(anteriores > 0, DIVIDE(ultimos, anteriores), 1)
			```
		formatString: 0.00
		displayFolder: Demanda
		lineageTag: f5d768ec-e6c3-5556-9d24-0b44d6030059

	/// Soma, nos três meses depois do mês da data, os protocolos abertos no mesmo mês um ano antes, vezes a tendência dos 12 meses.
	measure 'Previstos nos próximos 3 meses' = ```
			VAR d = [Data escolhida]
			VAR m0 = DATE(YEAR(d), MONTH(d), 1)
			VAR t = [Tendência dos protocolos]
			VAR mes1 = ROUND((CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] = EDATE(m0, -11)) + 0) * t, 0)
			VAR mes2 = ROUND((CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] = EDATE(m0, -10)) + 0) * t, 0)
			VAR mes3 = ROUND((CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] = EDATE(m0, -9)) + 0) * t, 0)
			RETURN mes1 + mes2 + mes3
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: a8a91690-d133-592a-ad75-1378669101d1

	/// Conta os protocolos abertos em cada mês nos 24 meses até a data, só pelo lugar.
	measure 'Protocolos por mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - 24 + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d) + 0)
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: eb58f8fb-a6dc-5f95-bbe0-c6b3094ed89a

	/// Prevê os três meses depois do mês da data: o mesmo mês um ano antes, vezes a tendência dos 12 meses.
	measure 'Previstos por mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR m0 = DATE(YEAR(d), MONTH(d), 1)
			RETURN IF(mes > m0 && mes <= EDATE(m0, 3), ROUND((CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Mês] = EDATE(mes, -12)) + 0) * [Tendência dos protocolos], 0))
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 6cce5be8-0578-56de-81e8-6b40f606c643

	/// Conta os estabelecimentos com atividade de engenharia abertos na Receita em cada mês. O mês depois do último arquivo da Receita fica vazio.
	measure 'Aberturas de engenharia na Receita' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - 24 + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Aberturas na Receita'), 'Aberturas na Receita'[Aberta em] <= d))
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 746aed08-4f40-5862-ab8a-57808717dda1

	/// Conta os pedidos de registro de empresa abertos em cada mês.
	measure 'Pedidos de registro de empresa' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - 24 + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, 'Protocolos'[Serviço] = "Registro de empresa") + 0)
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 1c218c82-0a1d-58fc-b453-780a6351cabb

	/// Conta as aberturas de engenharia na Receita de 18 a 6 meses antes da data: as que já tiveram 180 dias para pedir registro.
	measure 'Aberturas da coorte' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Aberturas na Receita'), REMOVEFILTERS('Calendário'), 'Aberturas na Receita'[Aberta em] >= DATE(YEAR(d), MONTH(d) - 17, 1), 'Aberturas na Receita'[Aberta em] < DATE(YEAR(d), MONTH(d) - 5, 1)) + 0
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: c850bbb6-c1c9-5b90-97b7-6abe916d3be1

	/// Conta as aberturas da coorte cuja empresa pediu registro no Crea-SP entre 30 dias antes e 180 dias depois da abertura, até a data.
	measure 'Aberturas que pediram registro' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Aberturas na Receita'), REMOVEFILTERS('Calendário'), 'Aberturas na Receita'[Aberta em] >= DATE(YEAR(d), MONTH(d) - 17, 1), 'Aberturas na Receita'[Aberta em] < DATE(YEAR(d), MONTH(d) - 5, 1), NOT ISBLANK('Aberturas na Receita'[Pediu registro em]), 'Aberturas na Receita'[Pediu registro em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 0e0243c7-18db-54d5-a341-c7bf5718b1da

	/// Mostra a parte das aberturas de engenharia na Receita cuja empresa pediu registro em até 180 dias.
	measure 'Empresas novas que pediram registro' = DIVIDE([Aberturas que pediram registro], [Aberturas da coorte])
		formatString: 0.0%
		displayFolder: Demanda
		lineageTag: 03a54483-9df2-5351-b7dd-fafbc54b09bc

	/// Conta os pedidos de registro de profissional (com diploma ou com atestado) abertos em cada mês.
	measure 'Pedidos de registro de profissional' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - 24 + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, 'Protocolos'[Pedido de registro de profissional] = 1) + 0)
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 45577ef0-1ab9-5e9a-b1c9-5cd8becaa287

	/// Soma os concluintes do INEP no ano anterior ao da data, pelas instituições do recorte.
	measure 'Concluintes do ano anterior' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Concluintes'[Concluintes]), 'Concluintes'[Ano] = YEAR(d) - 1) + 0
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 3ab68708-4f04-52ce-aab5-6aa0c0b6d76f

	/// Conta os profissionais que concluíram o curso no ano anterior ao da data e já se registraram até ela.
	measure 'Formados registrados do ano anterior' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(COUNTROWS('Formados registrados'), 'Formados registrados'[Ano de conclusão] = YEAR(d) - 1, 'Formados registrados'[Registro em] <= d) + 0
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: faf2a369-2688-5b47-9472-e1b164a6bbcc

	/// Mostra a parte dos concluintes do ano anterior que já se registrou no Crea-SP.
	measure 'Formados do ano anterior já registrados' = DIVIDE([Formados registrados do ano anterior], [Concluintes do ano anterior])
		formatString: 0.0%
		displayFolder: Demanda
		lineageTag: 118bef6c-e485-563a-b0ef-72b47102a4ab

	/// Conta os protocolos de baixa de ART por terceiros, cancelamento e regularização de ART abertos em cada mês.
	measure 'Protocolos de ART no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - 24 + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, 'Protocolos'[Serviço de ART] = 1) + 0)
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: fb54680b-8bff-5b01-8b5e-cbf321d778f2

	/// Soma as ARTs registradas em cada mês, pelo município da matriz da empresa.
	measure 'ARTs registradas no mês' = ```
			VAR d = [Data escolhida]
			VAR mes = MAX('Calendário'[Mês])
			VAR inicio = DATE(YEAR(d), MONTH(d) - 24 + 1, 1)
			RETURN IF(mes >= inicio && mes <= d, SUM('ARTs por mês'[ARTs]) + 0)
			```
		formatString: #,##0
		displayFolder: Demanda
		lineageTag: 2364edae-ef48-5304-94ea-f8c6fde5b851

	/// Divide os protocolos de ART pelas ARTs registradas no mês, por 1.000.
	measure 'Protocolos de ART por 1.000 ARTs no mês' = DIVIDE([Protocolos de ART no mês], [ARTs registradas no mês]) * 1000
		formatString: #,##0.0
		displayFolder: Demanda
		lineageTag: e6b48fc5-141d-573b-89eb-f7bd9072d7a6

	/// Divide os protocolos de ART dos 12 meses até a data pelas ARTs registradas nos mesmos meses, por 1.000.
	measure 'Protocolos de ART por 1.000 ARTs' = ```
			VAR d = [Data escolhida]
			VAR m0 = DATE(YEAR(d), MONTH(d), 1)
			VAR protocolos = CALCULATE(COUNTROWS('Protocolos'), REMOVEFILTERS('Protocolos'[Tipo], 'Protocolos'[Serviço], 'Protocolos'[Unidade]), 'Protocolos'[Aberto em] <= d, REMOVEFILTERS('Calendário'), 'Protocolos'[Serviço de ART] = 1, 'Protocolos'[Mês] >= EDATE(m0, -11), 'Protocolos'[Mês] <= m0) + 0
			VAR arts = CALCULATE(SUM('ARTs por mês'[ARTs]), REMOVEFILTERS('Calendário'), 'ARTs por mês'[Mês] >= EDATE(m0, -11), 'ARTs por mês'[Mês] <= m0)
			RETURN DIVIDE(protocolos, arts) * 1000
			```
		formatString: #,##0.0
		displayFolder: Demanda
		lineageTag: f73f9172-d7d5-5c54-83be-c5dacd3d8b6f

	/// Conta os pedidos de acesso à informação (LAI) do ano da data até ela. É o Crea-SP inteiro: a regional não muda este número.
	measure 'Pedidos de informação no ano' = ```
			VAR d = [Data escolhida]
			RETURN CALCULATE(SUM('Ouvidoria e informação'[Quantidade]), 'Ouvidoria e informação'[Data] = d, 'Ouvidoria e informação'[Ano] = YEAR(d), 'Ouvidoria e informação'[Tipo] = "Pedido de informação")
