	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Maior fila de uma pessoa' = ```
			VAR quem = TOPN(1, VALUES('Colaboradores'[Pessoa]), [Na fila], DESC, [Na fila e fora do prazo], DESC, [Abertos no período], DESC, CALCULATE(MAX('Colaboradores'[Nome])), ASC)
			RETURN IF(ISBLANK([Maior fila de uma pessoa]), "nenhum protocolo com colaborador", FORMAT(CALCULATE([Na fila e fora do prazo], quem), "#,##0") & " fora do prazo, com " & CALCULATE(MAX('Colaboradores'[Nome]), quem))
			```
		displayFolder: Equipe e território
		lineageTag: b18978f4-a9ae-546a-823f-573c133dad5b

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: A mais de 50 km da unidade' = FORMAT([Ativos a mais de 50 km], "#,##0") & " de " & FORMAT([Profissionais ativos], "#,##0") & " profissionais ativos"
		displayFolder: Equipe e território
		lineageTag: dc823d7f-6c83-5e99-882f-54b7b52487c0

	/// Mostra, em pontos percentuais, quanto o cartão mudou desde o fim do mesmo mês um ano antes.
	measure 'Variação em um ano: Ocupação dos coworkings' = ```
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Ocupação dos coworkings]
			VAR antes = CALCULATE([Ocupação dos coworkings], 'Datas das fotos'[Data] = alvo)
			RETURN IF(NOT ISBLANK(agora) && NOT ISBLANK(antes), (agora - antes) * 100)
			```
		formatString: +0.0;-0.0;0.0
		displayFolder: Equipe e território
		lineageTag: 2593220b-fed5-5ee5-bc5b-2b83791794c8

	/// Escreve a comparação que o cartão mostra embaixo do número.
	measure 'Comparação: Ocupação dos coworkings' = ```
			VAR v = [Variação em um ano: Ocupação dos coworkings]
			RETURN IF(ISBLANK(v), "sem comparação", FORMAT(v, "+0.0;-0.0;0.0") & " p.p. em relação a um ano antes")
			```
		displayFolder: Equipe e território
		lineageTag: a5b04e43-823f-5111-ba76-13cb3e4b0558

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Ocupação dos coworkings' = FORMAT([Unidades de coworking], "#,##0") & " unidades com " & FORMAT([Usuários dos coworkings], "#,##0") & " usuários, a " & FORMAT(DIVIDE([Custo dos coworkings no período], [Horas usadas no período]), "R$ #,##0.00") & " por hora usada"
		displayFolder: Equipe e território
		lineageTag: fa778e50-80c4-5a42-a6be-8098671f460d

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Previstos nos próximos 3 meses' = ```
			VAR d = [Data escolhida]
			VAR m0 = DATE(YEAR(d), MONTH(d), 1)
			RETURN "de " & FORMAT(EDATE(m0, 1), "mmm/yy") & " a " & FORMAT(EDATE(m0, 3), "mmm/yy") & IF([Colaboradores no quadro] > 0, ", cerca de " & FORMAT(DIVIDE([Previstos nos próximos 3 meses], [Colaboradores no quadro]), "#,##0") & " por colaborador", "")
			```
		displayFolder: Demanda
		lineageTag: 5f279131-c06e-5cbb-9723-e69901bc3316

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Empresas novas que pediram registro' = FORMAT([Aberturas que pediram registro], "#,##0") & " das " & FORMAT([Aberturas da coorte], "#,##0") & " aberturas de engenharia na Receita, em até 180 dias"
		displayFolder: Demanda
		lineageTag: 3eb9691c-4d96-5612-b9b5-55346326d185

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Formados do ano anterior já registrados' = FORMAT([Formados registrados do ano anterior], "#,##0") & " dos " & FORMAT([Concluintes do ano anterior], "#,##0") & " concluintes de " & (YEAR([Data escolhida]) - 1) & " (INEP) no recorte"
		displayFolder: Demanda
		lineageTag: b4708d8b-2e01-56d9-8969-1c7345032016

	/// Compara o cartão com o mesmo número de meses terminados no fim do mesmo mês um ano antes.
	measure 'Variação em um ano: Protocolos de ART por 1.000 ARTs' = ```
			VAR alvo = EOMONTH([Data escolhida], -12)
			VAR agora = [Protocolos de ART por 1.000 ARTs]
			VAR antes = CALCULATE([Protocolos de ART por 1.000 ARTs], 'Datas das fotos'[Data] = alvo)
			RETURN IF(antes > 0, DIVIDE(agora - antes, antes))
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Demanda
		lineageTag: f8749d66-f49b-5d40-b059-83def88f10a7

	/// Escreve a comparação que o cartão mostra embaixo do número.
	measure 'Comparação: Protocolos de ART por 1.000 ARTs' = ```
			VAR v = [Variação em um ano: Protocolos de ART por 1.000 ARTs]
			RETURN IF(ISBLANK(v), "sem comparação", FORMAT(v, "+0.0%;-0.0%;0.0%") & " em relação aos 12 meses anteriores")
			```
		displayFolder: Demanda
		lineageTag: a0eaf59e-cc86-517c-97de-9e26770b36b7

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Protocolos de ART por 1.000 ARTs' = "baixa, cancelamento e regularização, em 12 meses"
		displayFolder: Demanda
		lineageTag: 94cd52cf-b06e-5211-8cbf-02f7923f6c88

	/// Escreve a linha de apoio que o cartão mostra embaixo da comparação, como no painel.
	measure 'Detalhe: Pedidos de informação no ano' = FORMAT(DIVIDE([Pedidos de informação respondidos no prazo], [Pedidos de informação no ano]), "0.0%") & " respondidos no prazo; " & FORMAT([Recursos dos pedidos de informação], "#,##0") & " recursos em " & YEAR([Data escolhida])
		displayFolder: Demanda
		lineageTag: 383e7db2-9ed3-5eec-8ca3-365a523395ed

