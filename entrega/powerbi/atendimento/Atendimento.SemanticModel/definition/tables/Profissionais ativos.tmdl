/// Conta os profissionais com registro ativo no último dia de cada mês, por município onde moram.
table 'Profissionais ativos'
	isHidden
	lineageTag: c81f1e21-ceeb-516b-91d7-4589cbac4668

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
		lineageTag: 0ff360e8-a110-57a6-ae85-65c076a3d21f

	column 'Código IBGE'
		dataType: string
		summarizeBy: none
		sourceColumn: Código IBGE
		lineageTag: 2f51087a-2c85-5c44-bd9b-277240dcf29f

	column Ativos
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Ativos
		lineageTag: 367b5f18-bac7-5b52-a9e5-4e30ac107357

	partition 'Profissionais ativos' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "profissionais-ativos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Data", type date}, {"Código IBGE", type text}, {"Ativos", Int64.Type}}, "pt-BR")
				in
				    Tipos
