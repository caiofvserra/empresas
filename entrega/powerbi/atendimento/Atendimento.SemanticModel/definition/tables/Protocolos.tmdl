	column Tipo
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo
		lineageTag: 09d1fd8b-49a9-594d-aad0-1fb37553cfb4

	column 'Prazo do serviço'
		dataType: int64
		formatString: 0" dias úteis"
