	partition Protocolos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(#"Pasta dos dados" & "protocolos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"Protocolo", type text}, {"Serviço", type text}, {"Tipo", type text}, {"Prazo do serviço", Int64.Type}, {"Taxa", type number}, {"Solicitante", type text}, {"Código IBGE", type text}, {"Unidade", type text}, {"Canal", type text}, {"Aberto em", type date}, {"Mês", type date}, {"Trimestre", type text}, {"Ordem do trimestre", Int64.Type}, {"Motivo da exigência", type text}, {"Distância do solicitante", type text}, {"Ordem da distância", Int64.Type}, {"Serviço de ART", Int64.Type}, {"Pedido de registro de profissional", Int64.Type}}, "pt-BR")
				in
				    Tipos
